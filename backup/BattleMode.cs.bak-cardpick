        /// <summary>
        /// Запись боя в журнал игрока (последние 25). Хранится в аккаунте, отдаётся
        /// по запросу 14114 сообщением 23458.
        /// </summary>
        private void RecordBattleLog(BattlePlayer player, HashCore.Laser.Logic.Message.Battle.BattleEndMessage message)
        {
            try
            {
                if (player?.Avatar == null || player.IsBot() != 0) return;
                var entry = new HashCore.Laser.Logic.Home.BattleLog.BattleLogEntry
                {
                    EventSlot = EventSlot,
                    LocationId = Location?.GetGlobalId() ?? 0,
                    Result = message.Result,
                    Rank = message.Result,
                    TrophiesChange = message.TrophiesReward,
                    DurationSeconds = GetTicksGone() / 20,
                    TimeUtcMs = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds(),
                    OwnAccountId = player.AccountId,
                };
                foreach (BattlePlayer p in m_players)
                {
                    entry.Players.Add(new HashCore.Laser.Logic.Home.BattleLog.BattleLogPlayer
                    {
                        AccountId = p.AccountId,
                        IsBot = p.IsBot() != 0,
                        Name = p.DisplayData?.Name,
                        ThumbnailId = p.DisplayData?.ThumbnailId ?? 0,
                        NameColorId = p.DisplayData?.NameColorId ?? 0,
                        CharacterId = p.CharacterId,
                        PowerLevel = p.HeroPowerLevel,
                        Trophies = p.Trophies,
                        TeamIndex = p.TeamIndex,
                        SkinId = p.SkinId != 0 ? p.SkinId
                            : (DataTables.Get(DataType.Skin).GetData<SkinData>(DataTables.Get(DataType.Character).GetDataByGlobalId<CharacterData>(p.CharacterId)?.DefaultSkin ?? "")?.GetGlobalId() ?? 0),
                    });
                }
                var log = player.Avatar.BattleLog ??= new();
                log.Insert(0, entry);
                if (log.Count > 25) log.RemoveRange(25, log.Count - 25);
            }
            catch (Exception e)
            {
                HashCore.Laser.Server.Logger.Error($"[BattleLog] запись не удалась: {e.Message}");
            }
        }
