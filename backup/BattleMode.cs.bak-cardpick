        public virtual void Start()
        {
            m_updateTimer = new Timer(new TimerCallback(Update), null, 0, 1000 / 20);
        }

        /// <summary>Сколько обновлений бой простоял, дожидаясь подключения игроков.</summary>
        private int m_waitForListenersUpdates;

        public void Update(object stateInfo)
        {
            // Пока ни один живой игрок не подключился (UDP или запасной TCP), бой не
            // тикает: иначе клиент после загрузки догонял сотни тиков и секунд десять
            // не мог двигаться. Ждём не дольше 20 секунд (400 обновлений по 50 мс).
            if (GetTicksGone() == 0 && m_waitForListenersUpdates < 400)
            {
                bool humans = false, connected = false;
                foreach (BattlePlayer p in m_players)
                {
                    if (p == null || p.Avatar == null) continue;
                    humans = true;
                    if (p.GameListener != null) { connected = true; break; }
                }
                if (humans && !connected)
                {
                    m_waitForListenersUpdates++;
                    return;
                }
            }
            this.ExecuteOneTick();
            //Debugger.Print("shid");
        }

        public BattlePlayer GetPlayer(int globalId)
