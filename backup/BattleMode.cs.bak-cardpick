        private void TickSpawnHeroes()
        {
            if (IsKnockout) return; // нокаут: без возрождения, все появляются только в начале раунда
            foreach (BattlePlayer player in m_players)
            {
                if (player.IsAlive) continue;
                if (GameModeUtil.IsBattleRoyale(m_gameModeVariation)) return;
                LogicVector2 spawnPoint = player.GetSpawnPoint();

                if (GetTicksGone() == player.DeathTick + 20 * GameModeUtil.GetRespawnSeconds(m_gameModeVariation))
                {
                    if (player.DeathTick != 1)
                    {
                        AreaEffect v90 = GameObjectFactory.CreateGameObjectByData(DataTables.GetAreaEffectByName("HeroSpawn"));
                        v90.SetPosition(spawnPoint.X, spawnPoint.Y, 0);
                        v90.SetIndex(player.TeamIndex * 16 + player.PlayerIndex);
                        m_gameObjectManager.AddGameObject(v90);
                        v90.Trigger();
                    }
                }
                if (GetTicksGone() == player.DeathTick + 20 * GameModeUtil.GetRespawnSeconds(m_gameModeVariation) + 40)
                {
                    Character character = SpawnHero(player.CharacterData, player.HeroPowerLevel, player.TeamIndex * 16 + player.PlayerIndex, 0, false);
                    character.SetPosition(spawnPoint.X, spawnPoint.Y, 0);
                    character.SetBot(player.IsBot());
                    if (player.Gear1 != null) character.Gear1 = null;
                    if (player.Gear2 != null) character.Gear2 = null;
                    character.SpawnTick = GetTicksGone();
                    character.IsInvincible = true;
                    player.OwnObjectId = character.GetGlobalID();
                    player.IsAlive = true;
                }
            }
        }
        public Character SpawnHero(CharacterData a2, int a3, int a4, int a5, bool a6)
        {
            Character v9 = new Character(a2);
            m_gameObjectManager.AddGameObject(v9);
            if (a2.AreaEffect != null)
            {
                v9.AddAreaEffect(0, 0, null, 1, false);
            }
            v9.SetIndex(a4);
            v9.SetUpgrades(a3);
            return v9;
        }
        private readonly HashSet<long> m_challengeCounted = new HashSet<long>();
        private readonly HashSet<long> m_rogueliteCounted = new HashSet<long>();

        /// <summary>
        /// Этап рогалика (режим 67, слоты 53/54). Закрывается в момент, когда игрок
        /// получает свой итог боя: в выживании это его смерть, а потом итог
        /// приходит ещё раз в конце боя — считаем один раз.
        /// </summary>
        // ---- карточки рогалика ----
        public const int RogueliteCardOptions = 3;
        private bool m_rogueliteCardsDealt;

        /// <summary>
        /// Начало боя рогалика: игрок получает надетые карты забега и три новых на выбор
        /// (клиент показывает окно выбора, пока у игрока стоит флаг +572). Боты — как
        /// LogicPlayer::drawCardsBots: случайные карты по числу пройденных этажей + 1.
        /// </summary>
        public void DealRogueliteCards()
        {
            if (m_rogueliteCardsDealt) return;
            m_rogueliteCardsDealt = true;
            var rnd = new Random();
            foreach (BattlePlayer p in m_players)
            {
                if (p == null) continue;
                if (p.Home == null || p.Bot != 0)
                {
                    p.EquippedCards = Roguelite.RogueliteCards.Draw(rnd, p.CharacterId, 1, null);
                    continue;
                }
                p.EquippedCards = p.Home.GetRogueliteCards(EventSlot);
                p.DrawnCards = Roguelite.RogueliteCards.Draw(rnd, p.CharacterId, RogueliteCardOptions, p.EquippedCards);
                p.SelectingCard = p.DrawnCards.Count > 0;
                p.CardPhaseActive = p.SelectingCard;
                p.CardPicked = false;
                p.SelectedCardIndex = -1;
                Logger.Print($"[Roguelite] бой {Id} игрок {p.PlayerIndex}: надето {p.EquippedCards.Count}, на выбор {p.DrawnCards.Count}");
            }
        }

        /// <summary>Время на выбор, тиков: не выбрал — достаётся первая карта.</summary>
        public const int RogueliteCardPickTicks = 20 * 15;

        private void TickRogueliteCardPhase()
        {
            int tick = GetTicksGone();
            foreach (BattlePlayer p in m_players)
            {
                if (p == null || !p.CardPhaseActive) continue;
                if (p.SelectingCard && tick >= RogueliteCardPickTicks) PickRogueliteCard(p, 0);
                if (!p.SelectingCard && tick >= p.CardPhaseEndTick) { p.CardPhaseActive = false; p.CardPicked = false; }
            }
        }

        /// <summary>Ввод 21: игрок выбрал карту. Надеваем сразу и сохраняем в забег.</summary>
        private void PickRogueliteCard(BattlePlayer p, int index)
        {
            if (!p.SelectingCard || p.DrawnCards.Count == 0) return;
            if (index < 0 || index >= p.DrawnCards.Count) index = 0;
            int card = p.DrawnCards[index];
            p.EquippedCards.Add(card);
            p.DrawnCards.Clear();
            p.SelectingCard = false;
            p.CardPicked = true;
            p.CardPhaseEndTick = GetTicksGone() + 40; // даём клиенту проиграть закрытие окна
            p.SelectedCardIndex = index;
            p.Home?.SetRogueliteCards(EventSlot, p.EquippedCards);
            Logger.Print($"[Roguelite] бой {Id} игрок {p.PlayerIndex} выбрал {Roguelite.RogueliteCards.NameOf(card)}, надето {p.EquippedCards.Count}");
        }

        private ClientHome.RogueliteStageOutcome AdvanceRogueliteOnce(BattlePlayer player, int rank)
        {
            if (m_gameModeVariation != 67 || player == null || player.IsBot() != 0) return null;
            if (EventSlot < Home.Items.EventData.ROGUELITE_FIRST_SLOT
             || EventSlot > Home.Items.EventData.ROGUELITE_LAST_SLOT) return null;
            lock (m_rogueliteCounted)
            {
                if (!m_rogueliteCounted.Add(player.AccountId)) return null;
            }
            return player.Home?.AdvanceRoguelite(EventSlot, player.CharacterId, rank, GetTicksGone());
        }

        /// <summary>
        /// Итог боя для испытания (слоты 20..29). Победа — по правилу клиента
        /// (BattleEndPopup::isChallengeWin): в выживании соло место до 4-го, в
        /// дуо — до 2-го, иначе победа команды.
        /// В выживании итог уходит и при смерти, и в конце боя — считаем один раз.
        /// </summary>
        private void RegisterChallengeResult(BattlePlayer player, bool royale, int rank, bool isVictory)
        {
            if (!Home.Challenges.ChallengeDefinition.IsChallengeSlot(EventSlot)) return;
            if (player == null || player.IsBot() != 0 || player.Home?.HomeMode == null) return;
            lock (m_challengeCounted)
            {
                if (!m_challengeCounted.Add(player.AccountId)) return;
            }

            // Дуо-выживание — вариация 9 (game_mode_variations.csv: Showdown 6, DuoShowdown 9).
            bool duo = m_gameModeVariation == 9;
            bool won = royale ? rank >= 1 && rank <= (duo ? 2 : 4) : isVictory;
            Home.Challenges.ChallengeManager.RegisterBattle(player.Home.HomeMode, EventSlot, won);
        }

        public void PlayerDied(BattlePlayer player)
        {
            if (GameModeUtil.IsBattleRoyale(m_gameModeVariation))
            {
                int rank = m_playersAlive;
                m_playersAlive--;
                player.BattleRoyaleRank = rank;

                RegisterChallengeResult(player, true, rank, false);
                ClientHome.RogueliteStageOutcome rogueliteOutcome = AdvanceRogueliteOnce(player, rank);

                BattleEndMessage message = new BattleEndMessage();
                if (rogueliteOutcome != null && rogueliteOutcome.Victory)
                {
                    message.RogueliteProgress = rogueliteOutcome.BaseCurrency + rogueliteOutcome.BonusCurrency;
                    message.RogueliteBase = rogueliteOutcome.BaseCurrency;
                    message.RogueliteStage = rogueliteOutcome.Stage;
                }
                message.GameMode = 2;
                message.IsPvP = BattleWithTrophies;
                message.Players = new List<BattlePlayer>();
                message.Players.Add(player);
                message.OwnPlayer = player;

                if (player.IsBot() == 0)
                {
                    HomeMode homeMode = LogicServerListener.Instance.GetHomeMode(player.AccountId);
                    if (homeMode != null)
                    {
                    
                    }
                }

                if (player.Avatar == null) return;
                player.Avatar.BattleId = -1;

                if (player.GameListener == null) return;

                Hero hero = player.Avatar.GetHero(player.CharacterId);

                message.Result = rank;
                int tokensReward = 40 / rank;
                message.TokensReward = tokensReward;
                if (rank > 5)
                {
                    int trophiesReward = -(rank - 5);
                    if (hero.Trophies < -trophiesReward) trophiesReward = -hero.Trophies;
                    message.TrophiesReward = trophiesReward;

                    player.Avatar.AddTokens(tokensReward);
                    player.Home.TokenReward += tokensReward;
                    hero.AddTrophies(message.TrophiesReward);
                }
                else
                {
                    int trophiesReward = (5 - rank) * 2;
                    message.TrophiesReward = trophiesReward;

                    player.Avatar.AddTokens(tokensReward);
                    player.Home.TokenReward += tokensReward;
                    player.Home.TrophiesReward += trophiesReward;

                    if (rank <= 4)
                    {
                        player.Avatar.AddStarTokens(1);
                        message.StarToken = true;
                        player.Home.StarTokenReward += 1;
                        Home.RandomReward.RandomRewardManager.GiveStarrDrop(player.Home.HomeMode, false);
                        Home.DailyWin.DailyWinTrack.RegisterWin(player.Home.HomeMode);
                    }
                    hero.AddTrophies(message.TrophiesReward);
                }

                RecordBattleLog(player, message);
                if (message.Players != null && message.Players.Count > 1)
                {
                    m_kudos ??= new HashCore.Laser.Logic.Message.Battle.KudosBattle(message.Players);
                    message.Kudos = m_kudos;
                    HashCore.Laser.Logic.Message.Battle.KudosBattle.Bind(player.AccountId, m_kudos);
                }
                player.GameListener.SendTCPMessage(message);
                if (message.Kudos != null) { var kl = player.GameListener; var kk = message.Kudos; System.Threading.Tasks.Task.Delay(2500).ContinueWith(_ => { try { kl.SendTCPMessage(new HashCore.Laser.Logic.Message.Battle.KudosStatusMessage { Battle = kk }); } catch { } }); }

            }

            if (m_gameModeVariation == 0)
            {
                player.ResetScore();
            }

            //player.OwnObjectId = 0;

        }

