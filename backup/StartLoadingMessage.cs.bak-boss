using System.Collections.Generic;
using HashCore.Laser.Logic.Battle.Structures;
using HashCore.Laser.Logic.Message;
using HashCore.Laser.Titan.Math;

namespace HashCore.Laser.Logic.Message.Battle
{
    public class StartLoadingMessage : GameMessage
    {
        public List<BattlePlayer> Players;
        public int OwnIndex;
        public int TeamIndex;

        public int LocationId;
        public int GameMode;
        public int GameType;
        public int SpectateMode;
        public BattlePlayerMap map;
        public int MapMode;
        public List<int> Modifiers;

        public StartLoadingMessage() : base()
        {
            Players = new List<BattlePlayer>();
            MapMode = 1;
            Modifiers = new List<int>();
        }

        public void SetPlayerMap(BattlePlayerMap map)
        {
            if (map != null)
            {
                MapMode = 5;
                this.map = map;
                LocationId = 0;
                GameMode = map.GMV;
            }
        }

        public override void Encode()
        {
            // StartLoadingMessage::encode, v64 (laser): 0x1004B6C64.
            // +168 клиент отдаёт в LogicBattleModeClient::setPlayerCount (0x1004dfb68) —
            // это предварительный размер массива игроков. LogicBattleModeClient::addPlayer
            // (0x1004dfbb4) потом пишет в него БЕЗ проверки ёмкости, поэтому неверное
            // значение здесь = запись мимо буфера и вылет клиента на старте боя.
            Stream.WriteInt(Players.Count); // +168 player count
            Stream.WriteInt(OwnIndex);      // +172 own index
            Stream.WriteInt(TeamIndex);     // +176 team index

            Stream.WriteInt(Players.Count);
            foreach (BattlePlayer player in Players)
                player.Encode(Stream);

            Stream.WriteInt(0); // LogicLong list

            Stream.WriteInt(Modifiers.Count);
            foreach (int modifier in Modifiers)
                Stream.WriteInt(modifier);

            Stream.WriteInt(GameMode);
            Stream.WriteVInt(GameType != 0 ? GameType : 1); // +184, в эталоне 1

            // +188 — это map mode, а не spectate mode. Клиент кладёт его в
            // LogicBattleModeClient::generateTileMap (0x1004e120c) → LogicTileMap::generateTileMap
            // (0x1003b3b78), где 0 => Debugger::fatal("random maps no longer supported")
            // и мгновенное закрытие приложения.
            //   1 — карта из LogicLocationData::getMap
            //   2/3/4 — "Tutorial"
            //   5 — карта игрока (LogicBattlePlayerMap::getMapData)
            Stream.WriteVInt(MapMode);
            // +240 — ВАРИАЦИЯ РЕЖИМА. Именно её клиент берёт для боя:
            // MessageManager (0x10023a028) кладёт StartLoadingMessage+240 в +400 и
            // зовёт LogicBattleModeClient::setGameModeVariationData. Здесь стоял
            // SpectateMode = 0, и клиент при любом режиме считал бой захватом
            // кристаллов: счёт кристаллов в выживании и награде, кадр разбирался по
            // чужим веткам, игроки не появлялись.
            Stream.WriteVInt(GameMode);
            Stream.WriteVInt(1);        // +192, в эталоне 1
            Stream.WriteBoolean(true);  // +196, в эталоне true
            Stream.WriteVInt(SpectateMode); // +200 -> battle+320: 1 = наблюдатель (Brawl TV, просмотр боя)
            Stream.WriteVInt(0);

            ByteStreamHelper.WriteDataReference(Stream, LocationId);
            Stream.WriteBoolean(map != null);
            map?.Encode(Stream);

            Stream.WriteBoolean(false); // +208
            Stream.WriteBoolean(true);  // +209, в эталоне true
            Stream.WriteVInt(0);
            Stream.WriteVInt(0);

            // Fields appended after the player-map block in v64.
            Stream.WriteVInt(0);
            Stream.WriteVInt(0);
            Stream.WriteBoolean(false);
            Stream.WriteVInt(0);
            Stream.WriteVInt(0);
            Stream.WriteVInt(0);
            ByteStreamHelper.WriteDataReference(Stream, 0);
            ByteStreamHelper.WriteDataReference(Stream, 0);
            ByteStreamHelper.WriteDataReference(Stream, 0);

            // TEMP DEBUG: дамп полезной нагрузки для сверки с клиентским decode.
            // Убрать после диагностики вылета на старте боя.
            System.Console.WriteLine("[StartLoading::hex] len=" + Stream.GetOffset() + " players=" + Players.Count
                + " " + System.BitConverter.ToString(Stream.GetByteArray(), 0, Stream.GetOffset()));
        }

        public override int GetMessageType()
        {
            return 20559;
        }

        public override int GetServiceNodeType()
        {
            return 4;
        }
    }
}
