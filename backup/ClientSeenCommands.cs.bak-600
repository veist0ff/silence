    /*
     * Команды клиента, которых сервер не знал вовсе.
     * 
     * Все форматы сняты с реестра клиента `LogicCommandFactory::createCommandManual`
     * (0x1003bb604) и с `decode` соответствующих классов. Незнакомый тип у нас
     * обрывает разбор ВСЕГО хода клиента (DecodeCommand возвращает null), поэтому
     * вместе с каждой такой командой терялись и все остальные команды пакета —
     * клиент применял их у себя, сервер нет, и состояния расходились.
     */

    /// <summary>
    /// Смена схемы управления, тип 508. Одно число — номер схемы.
    /// </summary>
    public class LogicChangeControlModeCommand : Command
    {
        public int ControlMode;

        public override void Decode(ByteStream stream)
        {
            base.Decode(stream);

            ControlMode = stream.ReadVInt();
        }

        public override int Execute(HomeMode homeMode)
        {
            if (homeMode?.Home == null) return 1;
            homeMode.Home.ControlMode = ControlMode;
            return 0;
        }

        public override int GetCommandType()
        {
            return 508;
        }
    }

    /// <summary>
    /// Тип 511. У клиента это пустая заглушка: execute (0x1003bc454) сразу
    /// возвращает ноль, а decode — прямой переход на базовый.
    /// </summary>
    public class LogicEmptyClientCommand : Command
    {
        public override int Execute(HomeMode homeMode)
        {
            return 0;
        }

        public override int GetCommandType()
        {
            return 511;
        }
    }

