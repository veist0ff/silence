    /// <summary>
    /// Письмо во входящих прочитано, тип 528. Два числа.
    /// </summary>
    public class LogicViewInboxNotificationCommand : Command
    {
        public int NotificationId;
        public int Value;

        public override void Decode(ByteStream stream)
        {
            base.Decode(stream);

            NotificationId = stream.ReadVInt();
            Value = stream.ReadVInt();
        }

        /// <summary>
        /// LogicViewInboxNotificationCommand::execute (0x1003d5428): письмо ищется
        /// по номеру (+28); если уже просмотрено — ничего. Иначе ставится флаг
        /// просмотра и выдаётся награда: часть типов клиент начисляет сам, часть
        /// ждёт доставку от сервера — всё это в OnView каждого типа.
        /// </summary>
        public override int Execute(HomeMode homeMode)
        {
            NotificationFactory factory = homeMode?.Home?.NotificationFactory;
            BaseNotification notification = factory?.Get(NotificationId);
            if (notification == null)
            {
                Logger.Print($"[inbox] просмотр: письма {NotificationId} (тип {Value}) нет");
                return 0;
            }

            Logger.Print($"[inbox] просмотр письма {NotificationId} (тип {notification.GetNotificationType()}, уже просмотрено: {notification.IsViewed})");
            if (notification.IsViewed) return 0;
            notification.IsViewed = true;

            try
            {
                notification.OnView(homeMode);
            }
            catch (Exception e)
            {
                Logger.Print($"[inbox] награда письма {NotificationId} (тип {notification.GetNotificationType()}): {e.Message}");
            }
            return 0;
        }

        public override int GetCommandType()
        {
            return 528;
        }
    }

    /// <summary>
    /// Возраст игрока, тип 530. Сырой четырёхбайтовый int, не VInt.
    /// </summary>
    public class LogicSetPlayerAgeCommand : Command
    {
        public int Age;

        public override void Decode(ByteStream stream)
        {
            base.Decode(stream);

            Age = stream.ReadInt();
        }

        public override int Execute(HomeMode homeMode)
        {
            if (homeMode?.Home == null) return 1;
            homeMode.Home.PlayerAge = Age;
            return 0;
        }

        public override int GetCommandType()
        {
            return 530;
        }
    }

    /// <summary>
    /// Предмет посмотрели, тип 532. Ссылка на данные предмета.
    /// Отмечаем тем же способом, что и команда 583, иначе всё новое остаётся
    /// новым после каждого перезахода.
    /// </summary>
    public class LogicItemSeenCommand : Command
    {
        public int DataGlobalId;

        public override void Decode(ByteStream stream)
        {
            base.Decode(stream);

            DataGlobalId = ByteStreamHelper.ReadDataReference(stream);
        }

        public override int Execute(HomeMode homeMode)
        {
            if (homeMode?.Home == null || DataGlobalId <= 0) return 1;
            
            homeMode.Home.DataSeenStates ??= new Dictionary<int, int>();
            homeMode.Home.DataSeenStates[DataGlobalId] = 1;
            return 0;
        }

        public override int GetCommandType()
        {
            return 532;
        }
    }

