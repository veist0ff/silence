    /// <summary>
    /// Тип 544. Клиент кладёт в конфигурацию дома ключ 21 со значением 1 либо
    /// убирает его (LogicDailyData::addIntValue / removeIntValue). Имени у класса
    /// в символах нет, поэтому зовём по тому, что он делает.
    /// </summary>
    public class LogicSetConfFlag21Command : Command
    {
        public bool Enabled;

        public override void Decode(ByteStream stream)
        {
            base.Decode(stream);

            Enabled = stream.ReadBoolean();
        }

        public override int Execute(HomeMode homeMode)
        {
            return ConfFlags.Set(homeMode, 21, Enabled);
        }

        public override int GetCommandType()
        {
            return 544;
        }
    }

    /// <summary>
    /// Тип 549. То же самое, но ключ конфигурации 24.
    /// </summary>
    public class LogicSetConfFlag24Command : Command
    {
        public bool Enabled;

        public override void Decode(ByteStream stream)
        {
            base.Decode(stream);

            Enabled = stream.ReadBoolean();
        }

        public override int Execute(HomeMode homeMode)
        {
            return ConfFlags.Set(homeMode, 24, Enabled);
        }

        public override int GetCommandType()
        {
            return 549;
        }
    }

    /// <summary>Общая часть для флагов конфигурации, которые ставит сам клиент.</summary>
    internal static class ConfFlags
    {
        public static int Set(HomeMode homeMode, int key, bool enabled)
        {
            if (homeMode?.Home == null) return 1;

            homeMode.Home.ConfFlags ??= new Dictionary<int, int>();

            if (enabled) homeMode.Home.ConfFlags[key] = 1;
            else homeMode.Home.ConfFlags.Remove(key);

            return 0;
        }
    }

