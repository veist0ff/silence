        private static readonly int[] DefaultBattleEmotes =
            { 52000151, 52000145, 52000134, 52000093, 52000028 };

        private static readonly int[] DefaultBattleSprays =
            { 68000026, 68000004, 68000005, 68000015, 68000111 };

        private int DefaultSkinGlobalId()
        {
            string name = CharacterData?.DefaultSkin;
            SkinData skin = string.IsNullOrEmpty(name) ? null : DataTables.Get(DataType.Skin).GetData<SkinData>(name);
            return skin != null ? skin.GetGlobalId() : 29000000;
        }

        public void Encode(ByteStream stream)
        {
            stream.WriteLong(AccountId);  //  sub_9A30AC();

            stream.WriteBoolean(true); //  if ( *(_DWORD *)(a1 + 440) )
            {
                DisplayData.Encode(stream);
            
                stream.WriteVInt(0);

                // LogicPlayerBattleIntroDetails::encode, v64.
                ByteStreamHelper.WriteDataReference(stream, T1);
                ByteStreamHelper.WriteDataReference(stream, T2);
                ByteStreamHelper.WriteDataReference(stream, E);
                ByteStreamHelper.WriteDataReference(stream, Ti);
                ByteStreamHelper.WriteDataReference(stream, Frame);
                ByteStreamHelper.WriteDataReference(stream, 0); // milestone
            }

            stream.WriteVInt(PlayerIndex); // Player Index
            stream.WriteVInt(TeamIndex); // Team Index
            // LogicPlayer +16. В рабочем эталонном пакете здесь 1000000
            // (глобальный id класса 1, instance 0), а не ноль.
            stream.WriteInt(1000000); // Global ID
    
            stream.WriteByte(1); // Selected Brawlers Count
            {
                ByteStreamHelper.WriteDataReference(stream, CharacterId);
                stream.WriteBoolean(true); // LogicHeroUpgrades::encode
                {
                    stream.WriteVInt(11);
                    {         
                        stream.WriteDataReference(0);
                        stream.WriteDataReference(0);
                        stream.WriteDataReference(0);
                        stream.WriteDataReference(0);
                        stream.WriteDataReference(0);
                        stream.WriteDataReference(0);
                        stream.WriteDataReference(0);
                    }
                
                    stream.WriteVInt(0);
                    stream.WriteVInt(0);

                    stream.WriteDataReference(0);
                
                    stream.WriteDataReference(0);//по либе тут еше реф хз нахуй
                }
            
                // LogicBattleEmotes::encode (0x1004df574) — VInt count + DataRef[] + VInt.
                // В эталонном рабочем пакете блок присутствует и непустой.
                stream.WriteBoolean(true);
                {
                    int[] emotes = BattleEmotes ?? DefaultBattleEmotes;
                    stream.WriteVInt(emotes.Length);
                    foreach (int emote in emotes)
                        ByteStreamHelper.WriteDataReference(stream, emote);
                    stream.WriteVInt(0);
                }

                // LogicBattleSprays::encode (0x1004ea36c) — VInt count + DataRef[].
                stream.WriteBoolean(true);
                {
                    stream.WriteVInt(DefaultBattleSprays.Length);
                    foreach (int spray in DefaultBattleSprays)
                        ByteStreamHelper.WriteDataReference(stream, spray);
                }

                // Скин: в эталоне 29000000 (skins.csv, instance 0), нулевой реф клиент не ждёт.
                // Без выбранного скина — скин бойца по умолчанию. Раньше уходил
                // 29000000 (скин Шелли), и любой боец выглядел как Шелли.
                ByteStreamHelper.WriteDataReference(stream, SkinId != 0 ? SkinId : DefaultSkinGlobalId());
            stream.WriteDataReference(0); // Unknown
            stream.WriteDataReference(0); // Unknown
        }

        stream.WriteBoolean(false);
        stream.WriteBoolean(false);
        
        stream.WriteByte(0);
        // LogicPlayer +504..+524. BattleIntro::setFrame: +508 — номер ранга ранкеда (иконка
        // ранга, ranked_ranks.csv), +516 — уровень эмблемы на рамке ранга (0..6).
        stream.WriteVInt(0);
        stream.WriteVInt(RankedRank);
        stream.WriteVInt(0);
        stream.WriteVInt(RankedFrameLevel);
        stream.WriteVInt(0);
        stream.WriteVInt(0);

        stream.WriteBoolean(false); //unsigned __int8
        stream.WriteVInt(0);   //_DWORD
        stream.WriteVInt(0);
        stream.WriteVInt(0);

        //v64: +73, +97, +572 выбирает карту; затем +608 предложенные и +624 надетые карты
        stream.WriteBoolean(false);
        stream.WriteBoolean(false);
        stream.WriteBoolean(SelectingCard);

        stream.WriteVInt(DrawnCards.Count);
        foreach (int card in DrawnCards) stream.WriteDataReference(card);
        stream.WriteVInt(EquippedCards.Count);
        foreach (int card in EquippedCards) stream.WriteDataReference(card);

        stream.WriteVInt(0);
        stream.WriteBoolean(false);   
             
        }

