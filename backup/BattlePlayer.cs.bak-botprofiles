        /// <summary>
        /// Выбранный в меню скин бойца (Hero.SelectedSkinId — номер строки skins.csv) как
        /// глобальный id. Только если скин есть в таблице и принадлежит этому бойцу;
        /// иначе 0, и в бой уходит скин по умолчанию.
        /// </summary>
        /// <summary>
        /// Пины для боя, как их выбрал игрок: слоты 1–3 свои у каждого бойца (Hero.emote),
        /// слоты 4–5 общие (ClientHome.PlayerSelectedEmotes). Номер в выборе — строка
        /// emotes.csv. Пустой или несуществующий слот — пин набора по умолчанию.
        /// </summary>
        private static int[] SelectedPins(ClientHome home, ClientAvatar avatar, int characterId)
        {
            int[] result = (int[])DefaultBattleEmotes.Clone();
            Hero hero = avatar?.GetHero(characterId);
            var table = DataTables.Get(DataType.Emote);
            int Pin(int instance)
            {
                if (instance <= 0 || table == null) return 0;
                int gid = GlobalId.CreateGlobalId(52, instance);
                return table.GetDataByGlobalId<EmoteData>(gid) != null ? gid : 0;
            }
            for (int slot = 1; slot <= 3; slot++)
            {
                int id = 0;
                if (hero?.emote != null && hero.emote.TryGetValue(slot, out int v)) id = Pin(v);
                if (id != 0) result[slot - 1] = id;
            }
            for (int slot = 4; slot <= 5; slot++)
            {
                int id = 0;
                if (home?.PlayerSelectedEmotes != null && home.PlayerSelectedEmotes.TryGetValue(slot, out int v)) id = Pin(v);
                if (id != 0) result[slot - 1] = id;
            }
            return result;
        }

        private static int SelectedSkinFor(ClientAvatar avatar, int characterId)
        {
            Hero hero = avatar?.GetHero(characterId);
            if (hero == null || hero.SelectedSkinId <= 0) return 0;
            SkinData skin = DataTables.Get(DataType.Skin)?.GetDataByGlobalId<SkinData>(GlobalId.CreateGlobalId(29, hero.SelectedSkinId));
            if (skin == null || string.IsNullOrEmpty(skin.Conf)) return 0;
            SkinConfData conf = DataTables.Get(DataType.SkinConf)?.GetData<SkinConfData>(skin.Conf);
            CharacterData character = DataTables.Get(DataType.Character)?.GetDataByGlobalId<CharacterData>(characterId);
            if (conf == null || character == null || conf.Character != character.Name) return 0;
            return skin.GetGlobalId();
        }

        public static BattlePlayer Create(ClientHome home, ClientAvatar avatar, int playerIndex, int teamIndex)
        {
            BattlePlayer player = new BattlePlayer(home, avatar);
            player.DisplayData.Name = avatar.Name;
            player.AccessoryCardDatas = new CardData[3];
            player.AccessoryDatas = new AccessoryData[3];
            player.StarPowerDatas = new CardData[3];
            player.CharacterDatas = new CharacterData[3];
            player.OverChargeDatas = new CardData[3];

            player.DisplayData.ThumbnailId = home.ThumbnailId;
            player.AccountId = avatar.AccountId;
            for (int i = 0; i < home.CharacterIds.Length; i++)
            {
                player.CharacterIds[i] = (home.CharacterIds[i]);
                player.SkinIds[i] = SelectedSkinFor(avatar, home.CharacterIds[i]);
            
                player.AccessoryDatas[i] = (player.AccessoryCardDatas[i] == null ? null : DataTables.Get(DataType.Accessory).GetData<AccessoryData>(player.AccessoryCardDatas[i].Name));

                player.CharacterDatas[i] = (DataTables.Get(DataType.Character).GetDataWithId<CharacterData>(home.CharacterIds[i]));
             
            }
            player.HeroIndexMax = home.CharacterIds.Length - 1;
            player.Gear1 = DataTables.Get(DataType.Gear).GetDataByGlobalId<GearData>(62000000 + avatar.GetHero(home.CharacterIds[0]).SelectedGearId1);
            player.Gear2 = DataTables.Get(DataType.Gear).GetDataByGlobalId<GearData>(62000000 + avatar.GetHero(home.CharacterIds[0]).SelectedGearId2);
            player.Accessory = player.AccessoryData == null ? null : new Accessory(player.AccessoryData);
            player.PlayerIndex = playerIndex;
            player.TeamIndex = teamIndex;
            Hero hero = avatar.GetHero(home.CharacterIds[0]);
            player.Trophies = hero.Trophies;
            player.HighestTrophies = hero.HighestTrophies;
            player.HeroPowerLevel = 11;

            player.T1 = home.DefaultBattleCard.Thumbnail1;
            player.T2 = home.DefaultBattleCard.Thumbnail2;
            player.E = home.DefaultBattleCard.Emote;
            player.Ti = home.DefaultBattleCard.Title;
            player.Frame = home.DefaultBattleCard.Frames;
            player.BattleEmotes = SelectedPins(home, avatar, home.CharacterIds[0]);
            player.RankedRank = HashCore.Laser.Logic.Home.Structures.Profile.RankedRankOf(avatar);
            player.RankedFrameLevel = System.Math.Clamp((player.RankedRank - 1) / 3, 0, 6);
            return player;
        }

