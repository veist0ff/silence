namespace HashCore.Laser.Logic.Battle.Roguelite
{
    using HashCore.Laser.Logic.Data;

    /// <summary>
    /// Карточки рогалика. Таблица roguelite_cards.csv у клиента — класс 119
    /// (LogicDataTables, 0x10042fc98), колоды — roguelite_decks.csv (класс 120).
    /// Колода бойца: строка cards.csv с MetaType 12, Target = боец, RogueliteDeck = имя колоды
    /// (LogicDataTables::getRogueliteCardDataByHero).
    /// </summary>
    public static class RogueliteCards
    {
        public const int CardClassId = 119;

        private static readonly List<string> s_names = new List<string>();          // по номеру строки
        private static readonly Dictionary<string, int> s_byName = new Dictionary<string, int>();
        private static readonly Dictionary<int, string> s_traitByCard = new Dictionary<int, string>();
        private static readonly HashSet<int> s_disabled = new HashSet<int>();
        private static readonly Dictionary<string, List<int>> s_decks = new Dictionary<string, List<int>>();
        private static readonly Dictionary<int, List<int>> s_deckByHero = new Dictionary<int, List<int>>();
        private static bool s_loaded;
        private static readonly object s_lock = new object();

        public static int GlobalId(int instance) => CardClassId * 1000000 + instance;
        public static int Instance(int globalId) => globalId % 1000000;
        public static string NameOf(int globalId) { Load(); int i = Instance(globalId); return i >= 0 && i < s_names.Count ? s_names[i] : null; }
        public static string TraitOf(int globalId) { Load(); return s_traitByCard.TryGetValue(Instance(globalId), out string t) ? t : null; }

        /// <summary>Колода бойца: GlobalID карт (класс 119). Пусто, если колоды нет.</summary>
        public static List<int> DeckOf(int characterGlobalId)
        {
            Load();
            return s_deckByHero.TryGetValue(characterGlobalId, out List<int> d) ? d : new List<int>();
        }

        /// <summary>
        /// Как LogicPlayer::drawCardsBots: случайные неповторяющиеся карты колоды,
        /// без выключенных и уже надетых, не больше count.
        /// </summary>
        public static List<int> Draw(Random rnd, int characterGlobalId, int count, ICollection<int> exclude)
        {
            var pool = DeckOf(characterGlobalId).Where(g => !s_disabled.Contains(Instance(g)) && (exclude == null || !exclude.Contains(g))).ToList();
            var result = new List<int>();
            while (result.Count < count && pool.Count > 0)
            {
                int k = rnd.Next(pool.Count);
                result.Add(pool[k]);
                pool.RemoveAt(k);
            }
            return result;
        }

        private static void Load()
        {
            if (s_loaded) return;
            lock (s_lock)
            {
                if (s_loaded) return;
                var cards = ReadRows("Assets/csv_logic/roguelite_cards.csv", out string[] ch);
                int iName = Array.IndexOf(ch, "Name"), iDis = Array.IndexOf(ch, "Disable"), iTr = Array.IndexOf(ch, "Traits");
                foreach (string[] r in cards)
                {
                    int idx = s_names.Count;
                    s_names.Add(r[iName]);
                    if (r[iName].Length > 0) s_byName[r[iName]] = idx;
                    if (iDis >= 0 && r.Length > iDis && r[iDis].Equals("true", StringComparison.OrdinalIgnoreCase)) s_disabled.Add(idx);
                    if (iTr >= 0 && r.Length > iTr && r[iTr].Length > 0) s_traitByCard[idx] = r[iTr];
                }

                // Колоды: строка с именем открывает колоду, строки без имени продолжают её.
                var decks = ReadRows("Assets/csv_logic/roguelite_decks.csv", out string[] dh);
                int dName = Array.IndexOf(dh, "Name"), dCards = Array.IndexOf(dh, "RogueliteCards");
                List<int> cur = null;
                foreach (string[] r in decks)
                {
                    if (r[dName].Length > 0) { cur = new List<int>(); s_decks[r[dName]] = cur; }
                    if (cur != null && r.Length > dCards && s_byName.TryGetValue(r[dCards], out int ci)) cur.Add(GlobalId(ci));
                }

                // Боец → колода через cards.csv (MetaType 12).
                foreach (CardData card in DataTables.Get(DataType.Card).GetDatas().OfType<CardData>())
                {
                    if (card.MetaType != 12 || string.IsNullOrEmpty(card.RogueliteDeck) || string.IsNullOrEmpty(card.Target)) continue;
                    CharacterData hero = DataTables.Get(DataType.Character).GetData<CharacterData>(card.Target);
                    if (hero != null && s_decks.TryGetValue(card.RogueliteDeck, out List<int> deck))
                        s_deckByHero[hero.GetGlobalId()] = deck;
                }
                s_loaded = true;
                Server.Logger.Print($"[Roguelite] карт {s_names.Count}, колод {s_decks.Count}, бойцов с колодой {s_deckByHero.Count}");
            }
        }

        /// <summary>Строки данных CSV (после двух строк заголовка), с разбором кавычек.</summary>
        private static List<string[]> ReadRows(string path, out string[] header)
        {
            string[] lines = File.ReadAllLines(path);
            header = Split(lines[0]);
            var rows = new List<string[]>();
            for (int i = 2; i < lines.Length; i++) rows.Add(Split(lines[i]));
            return rows;
        }

        private static string[] Split(string line)
        {
            var res = new List<string>();
            var sb = new System.Text.StringBuilder();
            bool q = false;
            foreach (char c in line.TrimEnd('\r'))
            {
                if (c == '"') q = !q;
                else if (c == ',' && !q) { res.Add(sb.ToString()); sb.Clear(); }
                else sb.Append(c);
            }
            res.Add(sb.ToString());
            return res.ToArray();
        }
    }
}
