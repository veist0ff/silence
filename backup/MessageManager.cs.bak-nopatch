        /// <summary>
        /// Инпуты боя, пришедшие по TCP. Клиент откатывается на TCP, если UDP-сессия
        /// не поднялась; раньше сервер отвечал на это ServerErrorMessage и бой не начинался.
        /// </summary>
        private void ClientInputReceived(ClientInputMessage message)
        {
            UDPSocket socket = UDPGateway.GetSocket(Connection.UdpSessionId);
            if (socket == null || socket.Battle == null) return;

            LastKeepAlive = DateTime.UtcNow;

            if (!socket.IsSpectator)
            {
                BattlePlayer player = socket.Battle.GetPlayerBySessionId(socket.SessionId);
                if (player == null) return;

                // Инпут пришёл по TCP — значит клиент считает свой UDP-канал
                // мёртвым: UdpLaserSocket::isValidConnection (0x10024273c) пускает
                // в UDP, только пока таймер без входящих датаграмм (+0x5B4) не
                // добежал до десяти секунд (+0x5BC). Если при этом оставить
                // UDP-слушателя, кадры продолжат уходить в канал, которого для
                // клиента больше нет, и бой замрёт.
                if (player.GameListener == null || player.GameListener is UDPGameListener)
                {
                    bool wasUdp = player.GameListener is UDPGameListener;
                    player.GameListener = new TCPGameListener(Connection);
                    // ТЕСТ UDP: бой уже идёт — повторяем UDP-эндпоинт. Если клиент создаст сокет,
                    // его датаграммы появятся в журнале как [UDP::in].
                    if (!wasUdp) SendUdpConnectionInfo(Connection);
                    Logger.Print($"[MessageManager::clientInput] tcp listener {(wasUdp ? "restored from udp" : "attached")}: battle {socket.Battle.Id} player {player.PlayerIndex} team {player.TeamIndex}");
                }
            }

            while (message.Inputs.TryDequeue(out HashCore.Laser.Logic.Battle.Input.ClientInput clientInput))
            {
                if (!socket.IsSpectator)
                    socket.Battle.AddClientInput(clientInput, socket.SessionId);
                else
                    socket.Battle.HandleSpectatorInput(clientInput, socket.SessionId);
            }
        }

        /// <summary>
        /// UDP-эндпоинт клиенту. Раньше отправлялся только в ответ на ClientInfoMessage,
        /// то есть уже ПОСЛЕ StartLoading — клиент к этому моменту инициализировал бой
        /// и UDP-сессию не поднимал, откатываясь на TCP. Шлём до StartLoading.
        /// </summary>
        public static void SendUdpConnectionInfo(Connection connection)
        {
            if (connection == null) return;

            UdpConnectionInfoMessage info = new UdpConnectionInfoMessage();
            info.SessionId = connection.UdpSessionId;
            info.ServerAddress = Configuration.Instance.UdpHost;
            info.ServerPort = Configuration.Instance.UdpPort;
            // Nonce не шлём, и это разобрано по бинарю, а не подобрано.
            // createSocket (0x100242108) при непустом блоке поднимает два
            // PepperPerMessageEncrypter: ключ это байты 0..31, дальше два nonce
            // по 24. После этого КАЖДАЯ датаграмма в обе стороны идёт через
            // PepperCrypto::secretbox (0x100988da0), а сервер такого не умеет —
            // ни прочитать клиентскую, ни собрать свою. Пустой блок (длина -1)
            // шифровальщиков не создаёт, и обмен идёт открытым текстом, ровно в
            // том формате, который собирает UDPSocket.SendMessage.
            info.Nonce = null;
            Logger.Print($"[MessageManager::udpInfo] udp info -> {info.ServerAddress}:{info.ServerPort} session {info.SessionId} nonce {(info.Nonce == null ? "null" : info.Nonce.Length + "b")} (before StartLoading)");
            connection.Send(info);
        }

        private void ClientInfoReceived(ClientInfoMessage message)
        {
            UdpConnectionInfoMessage info = new UdpConnectionInfoMessage();
            info.SessionId = Connection.UdpSessionId;
            info.ServerAddress = Configuration.Instance.UdpHost;
            info.ServerPort = Configuration.Instance.UdpPort;
            Logger.Print($"[MessageManager::clientInfo] udp info -> {info.ServerAddress}:{info.ServerPort} session {info.SessionId}");
            Connection.Send(info);
        }

        private void CancelMatchMaking(CancelMatchmakingMessage message)
        {
            Matchmaking.CancelMatchmake(Connection);
            Connection.Send(new MatchMakingCancelledMessage());
        }

        private void MatchmakeRequestReceived(MatchmakeRequestMessage message)
        {
            int slot = message.EventSlot;
            Logger.Print($"[Matchmake] запрос: unk1={message.Unk1} dataRef={message.Unk2} слот={message.EventSlot} бойцов={message.CharacterInstanceId.Count} unk3={message.Unk3} есть слот={Events.HasSlot(slot)}");

            // Кнопка ранговых шлёт подбор со слотом 14 (старый номер силовой лиги), а само
            // событие ранговых в v64 — слот 43: направляем туда.
            if (slot == EventData.RANKED_EVENT_TYPE && Events.HasSlot(EventData.RANKED_SLOT)) slot = EventData.RANKED_SLOT;

            if (!Events.HasSlot(slot))
            {
                slot = 1;
            }

            Matchmaking.RequestMatchmake(Connection, slot);
        }

        private void SinglePlayerMatchRequestReceived(SinglePlayerMatchRequestMessage message)
        {
            // TEMP DEBUG: локация одиночного боя переключается переменной окружения,
            // чтобы гонять A/B без пересборки. 15000121 = тренировочная пещера (gmv 13),
            // 15000007 = Gemgrab1 (gmv 0) — тот же одиночный бой, но payload режима другой.
            int debugLocation = 15000121;
            string debugLocationEnv = Environment.GetEnvironmentVariable("DEBUG_SP_LOCATION");
            if (!string.IsNullOrEmpty(debugLocationEnv)) int.TryParse(debugLocationEnv, out debugLocation);

            BattleMode battle = new BattleMode(debugLocation);
            battle.Id = Battles.Add(battle);

            BattlePlayer player = BattlePlayer.Create(Connection.Home, Connection.Avatar, 0, 0);
            player.CharacterIds[0] = message.CharacterId;
            player.AccessoryCardDatas[0] = Connection.Avatar.GetHero(message.CharacterId).SelectedGadgetId == 0 ? null : DataTables.Get(23).GetData<CardData>((Connection.Avatar).GetHero(message.CharacterId).SelectedGadgetId);
            player.AccessoryDatas[0] = (player.AccessoryCardDatas[0] == null ? null : DataTables.Get(DataType.Accessory).GetData<AccessoryData>(player.AccessoryCardDatas[0].Name));
            player.StarPowerDatas[0] = (DataTables.Get(23).GetData<CardData>(Connection.Avatar.GetHero(message.CharacterId).SelectedStarPowerId));
            player.SkinIds[0] = message.SkinId;
            player.CharacterDatas[0] = (DataTables.Get(DataType.Character).GetDataWithId<CharacterData>(message.CharacterId));
            player.HeroIndexMax = 0;
            player.Gear1 = null;
            player.Gear2 = null;
            player.Accessory = null;
            Hero hero = Connection.Avatar.GetHero(message.CharacterId);
            player.Trophies = hero.Trophies;
            player.HighestTrophies = hero.HighestTrophies;
            player.HeroPowerLevel = 11;

            UDPSocket socket = UDPGateway.CreateSocket();
            socket.TCPConnection = Connection;
            socket.Battle = battle;
            Connection.UdpSessionId = socket.SessionId;
            battle.AddPlayer(player, Connection.UdpSessionId);

            if (battle.m_players[0].IsAdmin) for (int i = 0; i < 120; i++) battle.m_time.IncreaseTick();
            // Спавн-тест нужен только в тренировке; в гем-грабе объекты есть и без него,
            // а лишние объекты смазали бы чистоту сравнения.
            // Спавн-тест выключен: чужие объекты (Point и др.) роняли клиент в пещере около тика 100.
            battle.DebugSpawnTest = false;
            battle.DebugVisionDump = false;
            battle.AddGameObjects();

            StartLoadingMessage startLoading = new StartLoadingMessage();
            startLoading.LocationId = battle.Location.GetGlobalId();
            startLoading.TeamIndex = player.TeamIndex;
            startLoading.OwnIndex = player.PlayerIndex;
            startLoading.GameMode = battle.GetGameModeVariation();
            startLoading.GameType = 8; // тренировка; с 1 клиент падает на загрузке

            Connection.Avatar.UdpSessionId = Connection.UdpSessionId;
            startLoading.Players.AddRange(battle.GetPlayers());
            Logger.Print($"[Battle::create] single player battle {battle.Id}: location {startLoading.LocationId} gmv {battle.GetGameModeVariation()} map {battle.Location.Map} {battle.GetTileMap().Width}x{battle.GetTileMap().Height} mapMode {startLoading.MapMode} gameType {startLoading.GameType} players {startLoading.Players.Count} objects {battle.GetGameObjectManager().GameObjects.Count + battle.GetGameObjectManager().AddObjects.Count} udpSession {Connection.UdpSessionId}");
            SendUdpConnectionInfo(Connection);
            Connection.Send(startLoading);
            battle.Dummy = startLoading;

            battle.Start();
        }

        private void EndClientTurnReceived(EndClientTurnMessage message)
        {
            HomeMode.ClientTurnReceived(message.Tick, message.Checksum, message.Commands);
        }

        private void GetPlayerProfile(GetPlayerProfileMessage message)
        {
            Account data = Accounts.Load(message.AccountId);
            if (data == null) return;

            Profile profile = Profile.Create(data.Home, data.Avatar);

            PlayerProfileMessage profileMessage = new PlayerProfileMessage();
            profileMessage.Profile = profile;
            if (data.Avatar.AllianceId >= 0)
            {
                Alliance alliance = Alliances.Load(data.Avatar.AllianceId);
                if (alliance != null)
                {
                    profileMessage.AllianceHeader = alliance.Header;
                    profileMessage.AllianceRole = data.Avatar.AllianceRole;
                }
            }
            Connection.Send(profileMessage);
        }

        private void ChangeName(ChangeAvatarNameMessage message)
        {
            LogicChangeAvatarNameCommand command = new LogicChangeAvatarNameCommand();
            command.Name = message.Name;
            command.ChangeNameCost = 0;
            command.Execute(HomeMode);
            AvailableServerCommandMessage serverCommandMessage = new AvailableServerCommandMessage();
            serverCommandMessage.Command = command;
            Connection.Send(serverCommandMessage);
        }

        private void OnChangeCharacter(int characterId)
        {
            TeamEntry team = Teams.Get(HomeMode.Avatar.TeamId);
            if (team == null) return;

            TeamMember member = team.GetMember(HomeMode.Avatar.AccountId);
            if (member == null) return;

            if (characterId == 0) characterId = HomeMode.Home.CharacterId;

            Hero hero = HomeMode.Avatar.GetHero(characterId);
            if (hero != null) member.SetHero(hero);

            team.TeamUpdated();
        }
        private static bool IsAppleDevice(string device) =>
            device != null && (device.StartsWith("iPhone") || device.StartsWith("iPad") || device.StartsWith("iPod"));

        private void LoginReceived(AuthenticationMessage message)
        {
            // Патчер контента: клиент с другим fingerprint получает код 7 и качает
            // изменённые файлы по ContentUrl/<sha>/<файл> (сборка: patcher/build.py).
            try
            {
                var patch = Newtonsoft.Json.Linq.JObject.Parse(System.IO.File.ReadAllText("/root/v64/patcher/current.json"));
                string smallSha = (string)patch["sha"];
                string fullSha = (string)patch["full_sha"];
                // Пустой ResourceSha (iOS-клиент) — патч не шлём: код 7 он не переваривает и рвёт связь.
                if (string.IsNullOrEmpty(message.ResourceSha))
                    Logger.Print("[Patcher] клиент без ResourceSha — патч пропущен");
                else if (message.ResourceSha != fullSha
                      && (IsAppleDevice(message.Device) || message.ResourceSha != smallSha))
                {
                    // Чистый APK — малый патч (файлы APK не качаются). У кого уже стоял
                    // какой-то патч — полный: скачанное совпадёт по хешу и не перекачается.
                    // iOS-сборка — не APK SilenceBrawl: в ней нет файлов, которые малый патч
                    // пропускает как «уже в APK» (изменённые CSV). Ей всегда полный патч.
                    bool clean = message.ResourceSha == (string)patch["base_sha"] && !IsAppleDevice(message.Device);
                    string patchSha = clean ? smallSha : fullSha;
                    Logger.Print($"[Patcher] клиент {message.ResourceSha} -> {(clean ? "малый" : "полный")} патч {patchSha}");
                    Connection.Send(new AuthenticationFailedMessage()
                    {
                        ErrorCode = 7,
                        FingerprintSha = (string)(clean ? patch["fingerprint"] : patch["full_fingerprint"]),
                        ContentUrl = "http://2.26.48.213:8395",
                    });
                    return;
                }
            }
            catch (Exception e) { Logger.Error($"[Patcher] {e.Message}"); }
            Logger.Print($"[Login] acc={message.AccountId} major={message.ClientMajor} sha=\"{message.ResourceSha}\" device={message.Device}");
            if (message.ClientMajor < 52)
            {
                Connection.Send(new AuthenticationFailedMessage()
                {
                    ErrorCode = 8,
                    UpdateUrl = "https://pd.qq.com/s/3az5imfyn"
                });
                return;
            }
            if (Sessions.Maintenance)
            {
                Connection.Send(new AuthenticationFailedMessage()
                {
                    ErrorCode = 10,
                    dateTime = DateTime.Parse("2023-02-14 13:30:00")
                });
                return;
            }

            Account account = null;
            // Supercell ID: токен из входа -> сервис ID (127.0.0.1:8396) -> привязанный аккаунт.
            string scid = null;
            long scidAccount = 0;
            if (!string.IsNullOrEmpty(Connection.ScidToken))
            {
                try
                {
                    using var http = new System.Net.Http.HttpClient { Timeout = TimeSpan.FromSeconds(5) };
                    string js = http.GetStringAsync("http://127.0.0.1:8396/internal/resolve?token=" + Uri.EscapeDataString(Connection.ScidToken)).Result;
                    var o = Newtonsoft.Json.Linq.JObject.Parse(js);
                    if ((bool?)o["ok"] == true) { scid = (string)o["scid"]; scidAccount = (long?)o["game_account"] ?? 0; }
                    Logger.Print($"[SCID] {js}");
                }
                catch (Exception e) { Logger.Error("[SCID] resolve: " + e.Message); }
            }
            if (scidAccount > 0 && Accounts.Load(scidAccount) != null)
            {
                Logger.Print($"[SCID] загрузка привязанного аккаунта {scidAccount} (клиент прислал {message.AccountId})");
                message.AccountId = scidAccount;
            }
            if (message.AccountId == 0)
            {
                account = Accounts.Create();
                AccountCache.SaveAll();
            }
            else
            {
                account = Accounts.Load(message.AccountId);
            }

            if (account == null)
            {
                AuthenticationFailedMessage loginFailed = new AuthenticationFailedMessage();
                loginFailed.ErrorCode = 22;
                loginFailed.Message = "Account not loaded.";
                Connection.Send(loginFailed);
                return;
            }
            account.Avatar.Refresh();

            Logger.Print($"[ServerConnection::loadAccount] {account.Avatar.Name}({account.AccountId}) loaded");

            if (scid != null && scidAccount == 0)
            {
                try
                {
                    using var http = new System.Net.Http.HttpClient { Timeout = TimeSpan.FromSeconds(5) };
                    var form = new System.Net.Http.FormUrlEncodedContent(new System.Collections.Generic.Dictionary<string, string>
                    {
                        ["scid"] = scid, ["account"] = account.AccountId.ToString(), ["name"] = account.Avatar.Name ?? "",
                    });
                    http.PostAsync("http://127.0.0.1:8396/internal/bind", form).Wait();
                    Logger.Print($"[SCID] аккаунт {account.AccountId} привязан к {scid}");
                }
                catch (Exception e) { Logger.Error("[SCID] bind: " + e.Message); }
            }

            if (account.Avatar.Banned)
            {
                AuthenticationFailedMessage loginFailed = new AuthenticationFailedMessage();
                loginFailed.ErrorCode = 11;
                Connection.Send(loginFailed);
                return;
            }
            AuthenticationOkMessage loginOk = new AuthenticationOkMessage();
            loginOk.AccountId = account.AccountId;
            loginOk.PassToken = account.PassToken;
            loginOk.ServerEnvironment = "dev";
            Connection.Send(loginOk);

            HomeMode = HomeMode.LoadHomeState(new HomeGameListener(Connection), account.Home, account.Avatar, Events.GetEvents());
            HomeMode.CharacterChanged += OnChangeCharacter;

            FriendListMessage friendList = new FriendListMessage();
            friendList.Friends = HomeMode.Avatar.Friends.ToArray();
            Connection.Send(friendList);
            BattleMode battle = null;

            if (HomeMode.Avatar.BattleId > 0)
            {
                battle = Battles.Get(HomeMode.Avatar.BattleId);
                Console.WriteLine(battle);
            }

            if (battle == null)
            {

                OwnHomeDataMessage ohd = new OwnHomeDataMessage();
                ohd.Home = HomeMode.Home;
                ohd.Avatar = HomeMode.Avatar;
                Connection.Send(ohd);

                LoginCalendar.Send(HomeMode);
                WelcomeBackLoginCalendar.TrySend(HomeMode, LoginCalendar.STREAK_SLOT);

            }
            else
            {
                StartLoadingMessage startLoading = battle.Dummy;
                startLoading.TeamIndex = HomeMode.Avatar.TeamIndex;
                startLoading.OwnIndex = HomeMode.Avatar.OwnIndex;
                UDPSocket socket = UDPGateway.CreateSocket();
                socket.TCPConnection = Connection;
                socket.Battle = battle;
                Connection.UdpSessionId = socket.SessionId;
                battle.ChangePlayerSessionId(HomeMode.Avatar.UdpSessionId, socket.SessionId);
                HomeMode.Avatar.UdpSessionId = socket.SessionId;
                Connection.Send(startLoading);
            }

            Connection.Avatar.LastOnline = DateTime.UtcNow;

            Sessions.Create(HomeMode, Connection);
            if (false)
            {
                TeamInvitationMessage teamInvitationMessage = new TeamInvitationMessage();
                teamInvitationMessage.TeamId = -1;

                Friend friendEntry = new Friend();
                friendEntry.AccountId = new LogicLong(-1, -1);
                friendEntry.DisplayData = new PlayerDisplayData(HomeMode.Home.ThumbnailId, HomeMode.Home.NameColorId, HomeMode.Avatar.Name);
                friendEntry.Trophies = HomeMode.Avatar.Trophies;
                teamInvitationMessage.Unknown = 1;
                teamInvitationMessage.FriendEntry = friendEntry;

                Connection.Send(teamInvitationMessage);
            }
            if (HomeMode.Avatar.AllianceRole != AllianceRole.None && HomeMode.Avatar.AllianceId > 0)
            {
                Alliance alliance = Alliances.Load(HomeMode.Avatar.AllianceId);

                if (alliance != null)
                {
                    SendMyAllianceData(alliance);
                    AllianceDataMessage data = new AllianceDataMessage();
                    data.Alliance = alliance;
                    data.IsMyAlliance = true;
                    Connection.Send(data);

                    foreach (var member in alliance.Members)
                    {
                        if (LogicServerListener.Instance.IsPlayerOnline(member.AccountId))
                        {
                            Connection.Send(new AllianceOnlineStatusUpdatedMessage()
                            {
                                AvatarId = member.AccountId,
                                Members = alliance.Members.Count,
                                OnlineMembers = alliance.OnlinePlayers,
                                PlayerStatus = member.Avatar.PlayerStatus
                            });
                        }

                    }
                }
            }

            foreach (Friend entry in HomeMode.Avatar.Friends.ToArray())
            {
                if (LogicServerListener.Instance.IsPlayerOnline(entry.AccountId))
                {
                    FriendOnlineStatusEntryMessage statusEntryMessage = new FriendOnlineStatusEntryMessage();
                    statusEntryMessage.AvatarId = entry.AccountId;
                    statusEntryMessage.PlayerStatus = entry.Avatar.PlayerStatus;
                    statusEntryMessage.AllianceTeamEntry = Teams.Get(entry.Avatar.TeamId);
                    Connection.Send(statusEntryMessage);
                }
            }
            if (HomeMode.Avatar.TeamId <= 0)
            {
                //TeamCreateReceived(new TeamCreateMessage());
            }

            if (HomeMode.Avatar.TeamId > 0)
            {
                TeamMessage teamMessage = new TeamMessage();
                teamMessage.Team = Teams.Get(HomeMode.Avatar.TeamId);
                if (teamMessage.Team != null)
                {
                    Connection.Send(teamMessage);
                    TeamMember member = teamMessage.Team.GetMember(HomeMode.Avatar.AccountId);
                    member.State = 0;
                    teamMessage.Team.TeamUpdated();
                }
            }

        }

        private void ClientHelloReceived(ClientHelloMessage message)
        {
            Connection.Messaging.DisableCrypto = false;
            if (Sessions.Maintenance)
            {
                Connection.Send(new AuthenticationFailedMessage()
                {
                    ErrorCode = 10
                });
                return;
            }

            if (message.MajorVersion < 53)
            {
                Connection.Send(new AuthenticationFailedMessage()
                {
                    ErrorCode = 8,
                    UpdateUrl = "https://pd.qq.com/s/3az5imfyn"
                });
                return;
            }
            Connection.Messaging.Seed = message.ClientSeed;
            Connection.Nonce = Helpers.RandomString(32);
            ServerHelloMessage hello = new ServerHelloMessage();
            hello.SetServerHelloToken(Connection.Messaging.SessionToken);
            hello.Nonce = Connection.Nonce;
            Connection.Send(hello);
        }
    }
}
