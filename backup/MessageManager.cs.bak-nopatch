        private void SearchAlliancesReceived(SearchAlliancesMessage message)
        {
            SearchAlliancesResponseMessage response = new SearchAlliancesResponseMessage();
            response.SearchTerm = message.SearchTerm;
            int limit = message.MaxResults <= 0 ? 30 : Math.Min(message.MaxResults, 50);

            foreach (Alliance alliance in Alliances.Search(message.SearchTerm, limit))
            {
                if (message.FamilyFriendlyOnly && !alliance.FamilyFriendly) continue;
                response.Alliances.Add(alliance.Header);
            }

            Connection.Send(response);
        }

        private void ClientCapabilitesReceived(ClientCapabilitiesMessage message)
        {
            Connection.PingUpdated(message.Ping);
        }

        private void GetLeaderboardReceived(GetLeaderboardMessage message)
        {
            var leaderboard = new LeaderboardMessage
            {
                LeaderboardType = message.LeaderboardType,
                Season = message.Season,
                HeroDataId = message.HeroDataId,
                Region = message.IsRegional ? "RU" : null,
                CountryCode = "RU"
            };

            try
            {
                if (message.LeaderboardType == 2)
                {
                    FillAllianceRanking(leaderboard);
                }
                else
                {
                    FillPlayerRanking(leaderboard, message);
                }
            }
            catch (Exception exception)
            {
                Console.WriteLine("Failed to build the leaderboard: " + exception);
            }

            Console.WriteLine($"[Leaderboard] type={message.LeaderboardType} hero={message.HeroDataId} regional={message.IsRegional} entries={leaderboard.Entries.Count}");

            Connection.Send(leaderboard);
        }

        private void FillAllianceRanking(LeaderboardMessage leaderboard)
        {
            long ownAllianceId = Connection.Avatar != null ? Connection.Avatar.AllianceId : -1;

            Alliance[] ranking = Alliances.GetRankingList()
                .Where(alliance => alliance != null)
                .OrderByDescending(GetAllianceScore)
                .Take(200)
                .ToArray();

            for (int i = 0; i < ranking.Length; i++)
            {
                Alliance alliance = ranking[i];
                int score = GetAllianceScore(alliance);

                leaderboard.Entries.Add(new RankingEntry
                {
                    Id = alliance.Id,
                    Rank = i + 1,
                    Trophies = score,
                    AllianceData = new AllianceRankingData
                    {
                        Name = alliance.Name,
                        Value = alliance.Members.Count,
                        BadgeId = alliance.AllianceBadgeId
                    }
                });

                if (alliance.Id == ownAllianceId)
                {
                    leaderboard.OwnRank = i + 1;
                    leaderboard.OwnScore = score;
                }
            }
        }

        private void FillPlayerRanking(LeaderboardMessage leaderboard, GetLeaderboardMessage message)
        {
            int heroDataId = message.HeroDataId;
            bool heroBoard = heroDataId > 0;
            bool rankedBoard = message.LeaderboardType == 4 || message.LeaderboardType == 5;

            List<Account> accounts = heroBoard
                ? Accounts.GetBrawlerRankingList(heroDataId)
                : Accounts.GetRankingList();

            long ownAccountId = Connection.Avatar != null ? Connection.Avatar.AccountId : 0;

            // GetRankingList() has no ORDER BY, so the ordering is done here for every board.
            var ranking = accounts
                .Where(account => account != null && account.Avatar != null)
                .Select(account => new
                {
                    Account = account,
                    Score = GetPlayerScore(account.Avatar, heroBoard, rankedBoard, heroDataId)
                })
                .OrderByDescending(entry => entry.Score)
                .Take(200)
                .ToArray();

            for (int i = 0; i < ranking.Length; i++)
            {
                Account account = ranking[i].Account;
                ClientAvatar avatar = account.Avatar;
                int score = ranking[i].Score;

                leaderboard.Entries.Add(new RankingEntry
                {
                    Id = avatar.AccountId,
                    Rank = i + 1,
                    Trophies = score,
                    PlayerData = new PlayerRankingData
                    {
                        // Rendered by the client as the alliance name of the row.
                        Name = GetCachedAllianceName(avatar.AllianceId),
                        DisplayData = new PlayerDisplayData(
                            account.Home != null ? account.Home.ThumbnailId : 0,
                            account.Home != null ? account.Home.NameColorId : 0,
                            avatar.Name)
                    }
                });

                if (avatar.AccountId == ownAccountId)
                {
                    leaderboard.OwnRank = i + 1;
                    leaderboard.OwnScore = score;
                }
            }
        }

        private static int GetPlayerScore(ClientAvatar avatar, bool heroBoard, bool rankedBoard, int heroDataId)
        {
            if (heroBoard)
            {
                return avatar.HasHero(heroDataId) ? avatar.GetHero(heroDataId).Trophies : 0;
            }

            return rankedBoard ? avatar.RankedPoins : avatar.Trophies;
        }

        private static int GetAllianceScore(Alliance alliance)
        {
            int score = 0;

            foreach (AllianceMember member in alliance.Members)
            {
                score += member.Trophies;
            }

            return score;
        }

        private static string? GetCachedAllianceName(long allianceId)
        {
            if (allianceId <= 0) return null;

            Alliance alliance = AllianceCache.GetAlliance(allianceId);
            return alliance != null ? alliance.Name : null;
        }

