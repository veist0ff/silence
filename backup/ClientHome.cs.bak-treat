        /// <summary>
        /// Баланс валюты события (вафли) и очки коллаба. Клиент читает их из
        /// LogicPlayerCollabEventData: CollabUtil::getEventCurrency берёт +172,
        /// getEventScore — +20. Когда структуры нет, обе функции возвращают -1,
        /// и интерфейс рисует пустое место вместо цифры.
        /// </summary>
        /// <summary>
        /// Ключи конфигурации, которые сервер досылает клиенту. Значения по умолчанию
        /// у клиента свои, и почти всё выключено, пока ключ не прислан явно.
        /// </summary>
        [JsonIgnore] public readonly Dictionary<int, int> ConfIntValues = new()
        {
            // 10018: LogicClientHome::isEventSlotLocked (0x100491b1c) первым делом
            // проверяет getIntValue(10018) == 1 и при совпадении сразу возвращает
            // «не заблокировано» — до всех проверок по кубкам и трофейному миру.
            // Без него RogueliteUtil::getRogueliteEvent выходит нулём, и слот
            // рисуется по .sc, но без данных.
            { 10018, 1 },
            // 10062 проверен по коду: NightMarketShopPopup::collectValidBundles
            // выходит сразу, если ключ не равен 1, — именно поэтому витрина
            // события оставалась пустой.
            { 10062, 1 },
            // 10056 включает дорожку ежедневных побед целиком
            // (LogicRandomRewardManager::isEnabled 0x100492b60 сравнивает ровно с единицей),
            // 10057 — минимальный уровень игрока для неё
            // (isUnlocked 0x100492b88: уровень дома >= значения ключа).
            { 10056, 1 },
            // 10054 — курс обмена кредитов вербовки на славу, когда все бойцы уже
            // открыты. LogicBrawlerRecruitRoad::distributeRecruitTokens (0x1003b7760):
            // при отсутствии текущей вербовки И пустом списке будущих бойцов клиент
            // берёт этот ключ и переводит кредиты в славу как (кредиты * курс + 99) / 100,
            // после чего обнуляет кредиты. Если ключ меньше единицы, клиент не делает
            // НИЧЕГО — кредиты повисают, а сервер их уже начислил, и состояния
            // расходятся. Сто означает обмен один к одному.
            { 10054, 100 },
            { 10057, 1 },
        };

