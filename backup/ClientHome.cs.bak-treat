        // Битая ссылка в OHD валит клиента на 93%: getDataById не находит строку.
        public int SafeThumbnailId => Resolve(DataType.PlayerThumbnail, ThumbnailId, GlobalId.CreateGlobalId(28, 0));
        public int SafeNameColorId => Resolve(DataType.NameColor, NameColorId, GlobalId.CreateGlobalId(43, 0));
        public int SafeFavouriteCharacter => Resolve(DataType.Character, FavouriteCharacter, GlobalId.CreateGlobalId(16, 0));

        private static int Resolve(DataType type, int globalId, int fallback)
        {
            DataTable table = DataTables.Get(type);
            if (table == null) return fallback;
            if (GlobalId.GetClassId(globalId) != (int)type) return fallback;
            return table.GetDataByGlobalId<LogicData>(globalId) != null ? globalId : fallback;
        }

