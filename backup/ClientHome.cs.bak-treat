            UnlockStarRoad = (int[])DefaultUnlockStarRoad.Clone();

            PlayerSelectedEmotes.Add(1, 28);
            PlayerSelectedEmotes.Add(2, 28);
            PlayerSelectedEmotes.Add(3, 28);
            PlayerSelectedEmotes.Add(4, 28);
            PlayerSelectedEmotes.Add(5, 94 -3);
            RecruitTokens = 0;
            OffersClaimed = new List<string>();
            ThumbnailId = GlobalId.CreateGlobalId(28, 0);
            NameColorId = GlobalId.CreateGlobalId(43, 0);
            CharacterIds = new int[] { GlobalId.CreateGlobalId(16, 0), GlobalId.CreateGlobalId(16, 1), GlobalId.CreateGlobalId(16, 2) };
            FavouriteCharacter = GlobalId.CreateGlobalId(16, 0);
            OfferBundles = new List<OfferBundle>();
            UnlockedSkins = new List<int>();
            UnlockedRogueliteDecks = new List<int>();
            UnlockedEmotes = new List<int>();
            UnlockedTituls = new List<int>();
            UnlockedThumbnails = new List<int>();
            UnlockedFrames = new List<int>();
            LastVisitHomeTime = DateTime.UnixEpoch;
            PreviousVisitHomeTime = DateTime.UnixEpoch;
            LoginCalendarNextDay = DateTime.UnixEpoch;
            LoginCalendarStates = new int[Calendar.LoginCalendar.SLOT_COUNT];
            LoginCalendarStreak = 0;
            TrophyRoadProgress = 50;
            // Прогресс Trophy World открывает слоты событий: клиент сверяет его в
            // LogicTrophyWorldUtil::isEventSlotLocked с порогом милстоуна типа EventSlot.
            // Пороги из trophy_world_milestones.csv: слот 1 — 20, слот 3 — 100,
            // слот 4 — 200, слот 7 — 300, слот 14 — 1000. Слот 40 (ранний доступ)
            // наследует замок слота 7, поэтому при нуле он не появлялся вовсе.
            TrophyWorldProgress = TROPHY_WORLD_UNLOCK_ALL;
            BrawlPassProgress = 1;
            PremiumPassProgress = 1;
            EventId = 1;
            UnlockedEmotes = new List<int>();
            DefaultBattleCard = new BattleCard();
            
            if (NotificationFactory == null) NotificationFactory=new NotificationFactory();

            PreferredThemeId = -1;
        }

        public int TimerMath(DateTime timer_start, DateTime timer_end)
        {
            {
                DateTime timer_now = DateTime.Now;
                if (timer_now > timer_start)
                {
                    if (timer_now < timer_end)
                    {
                        int time_sec = (int)(timer_end - timer_now).TotalSeconds;
                        return time_sec;
                    }
                    else
                    {
                        return -1;
                    }
                }
                else
                {
                    return -1;
                }
            }
        }

        public void HomeVisited()
        {
        if (HomeMode != null && HomeMode.Avatar != null)
    {
        TickTrophyReward(HomeMode.Avatar);
    }
            OfferBundles.RemoveAll(bundle => bundle.IsTrue);
            // Магазин очищен: только цепочка «Джи Джи ранний доступ» (ящики Гиги).
            GenerateGigiEarlyAccessOffers();
            // Акции коллаба — только пока слот коллаба (36) включён в gameplay.json.
            if (Skins.CollabRewards.ActiveCollabId == 13 && Events?.Any(e => e != null && e.Slot == EventData.COLLAB_EVENT_SLOT) == true) // акции/карты — только у ОСД
            {
                UnclaimCollabPacks();
                GenerateCollabCardOffers();
            }

            RotateShopContent(DateTime.UtcNow, OfferBundles.Count == 0);
            GenerateQuest();
            PreviousVisitHomeTime = LastVisitHomeTime;
            LastVisitHomeTime = DateTime.UtcNow;
            // Re-entering home on the same UTC day is intentionally idempotent.
            // У сохранённых аккаунтов поле лежит нулём, поэтому поднимаем и здесь,
            // иначе на уже созданном профиле ранний доступ так и не откроется.
            if (TrophyWorldProgress < TROPHY_WORLD_UNLOCK_ALL)
                TrophyWorldProgress = TROPHY_WORLD_UNLOCK_ALL;

            RefreshGigiSnapshot(LastVisitHomeTime);
            RefreshCollabSnapshot(LastVisitHomeTime);
            RefreshRogueliteSnapshot(LastVisitHomeTime);
        }

        public void RefreshGigiSnapshot(DateTime utcNow)
        {
            lock (RewardSync)
            {
                GigiEarlyAccess ??= new();
                bool active = Events?.Any(e => e.Slot == 40 && e.BrawlerEarlyAccess != null &&
                    e.EndTime > utcNow.ToLocalTime()) == true;
                if (!active) { PlayerBrawlerEarlyAccess = null; return; }
                GigiEarlyAccess.GrantDailyTicket(utcNow);
                PlayerBrawlerEarlyAccess = new PlayerBrawlerEarlyAccessEventData
                {
                    Unk8 = 40, Unk12 = GigiEarlyAccess.Tickets, Unk16 = GigiEarlyAccess.Wins,
                    Unk20 = GigiEarlyAccess.Boxes,
                    Unk28 = (int)Math.Clamp((utcNow - GigiEarlyAccess.LastBatchUtc).TotalSeconds, 0, 86399)
                };
            }
        }

        /// <summary>
        /// Данные игрока по коллабу (LogicPlayerCollabEventData, ClientHome +232).
        /// Без неё клиенту нечем показать баланс валюты и очки события.
        /// </summary>
        public void RefreshCollabSnapshot(DateTime utcNow)
        {
            lock (RewardSync)
            {
                bool active = Events?.Any(e => e != null
                    && (e.Slot == EventData.COLLAB_EVENT_SLOT || e.Slot == EventData.SPECIAL_EVENT_SLOT || e.Slot == EventData.ROGUELITE_FIRST_SLOT)
                    && e.EndTime > utcNow.ToLocalTime()) == true;

                if (!active) { PlayerCollab = null; return; }

                PlayerCollab ??= new PlayerCollabEventData();
                PlayerCollab.Unk172 = CollabCurrency;   // +172 — баланс вафель
                PlayerCollab.Unk20 = CollabScore;       // +20  — очки события
            }
        }

        /// <summary>
        /// Игроцкие записи по рогалику (LogicPlayerRogueliteEventData, ClientHome +304).
        /// RogueliteUtil::getRogueliteEvent ищет запись по идентификатору события, а
        /// getExistingRunLockedBrawler считает забег начатым только при CurrentStage >= 1,
        /// поэтому новая запись создаётся с нулевым этапом.
        /// </summary>
        public void RefreshRogueliteSnapshot(DateTime utcNow)
        {
            lock (RewardSync)
            {
                PlayerRoguelite ??= new List<PlayerRogueliteEventData>();

                // Забег больше НЕ пересобирается с нуля. Раньше список чистился при
                // каждом входе и даже при выборе события в лобби, и пройденные этапы,
                // места и выбранный боец пропадали после первого же перехода.
                // Теперь запись живёт, пока у слота есть рогалик; меняется только
                // оставшееся время.
                List<int> activeSlots = new List<int>();
                if (Events != null)
                {
                    foreach (EventData e in Events)
                    {
                        if (e == null || e.Roguelite == null) continue;
                        if (e.Slot < EventData.ROGUELITE_FIRST_SLOT || e.Slot > EventData.ROGUELITE_LAST_SLOT) continue;
                        if (e.EndTime <= utcNow.ToLocalTime()) continue;

                        activeSlots.Add(e.Slot);
                        int endTime = (int)Math.Max(0, (e.EndTime - utcNow.ToLocalTime()).TotalSeconds);

                        PlayerRogueliteEventData run = PlayerRoguelite.Find(r => r != null && r.EventSlotCode == e.Slot);
                        if (run == null)
                        {
                            run = NewRogueliteRun(e.Slot);
                            PlayerRoguelite.Add(run);
                        }
                        run.CurrentEventId = e.Slot;
                        run.EventEndTime = endTime;
                    }
                }

                PlayerRoguelite.RemoveAll(r => r == null || !activeSlots.Contains(r.EventSlotCode));
            }
        }

        /// <summary>
        /// Пустой забег. +64 «m_canClaimReward» (имя из toString) у клиента значит
        /// «валюту ещё можно получать»: RogueliteUtil::isCollabCurrencyCapReached
        /// возвращает его отрицание. Раньше здесь стоял false — клиент считал
        /// лимит выбранным и прятал награды этапов.
        /// </summary>
        private static PlayerRogueliteEventData NewRogueliteRun(int slot)
        {
            return new PlayerRogueliteEventData
            {
                CanClaimReward = true,
                EventSlotCode = slot,
                CurrentEventId = slot,
                CurrentStage = 0
            };
        }

        /// <summary>
        /// Досылает список забегов рогалика командой 212 с подтипом 10.
        /// LogicPlayerDataChangedCommand::execute на этом подтипе сначала проверяет
        /// ненулевое количество, затем чистит свой список и заливает присланный —
        /// пустая посылка ничего не сбрасывает, поэтому и не отправляем её.
        /// </summary>
        public void PushRogueliteData()
        {
            if (HomeMode?.GameListener == null) return;
            if (PlayerRoguelite == null || PlayerRoguelite.Count == 0) return;

            LogicPlayerDataChangedCommand command = new LogicPlayerDataChangedCommand
            {
                Subtype = LogicPlayerDataChangedCommand.SUBTYPE_ROGUELITE,
                Roguelite = PlayerRoguelite
            };

            AvailableServerCommandMessage message = new AvailableServerCommandMessage();
            message.Command = command;
            HomeMode.GameListener.SendMessage(message);
        }

        /// <summary>
        /// Место, до которого этап рогалика засчитывается победой. Режим 67 —
        /// выживание на десять мест; как и в обычном выживании, победа — первая четвёрка.
        /// </summary>
        public const int ROGUELITE_WIN_RANK = 4;

        /// <summary>Что получилось по итогам этапа — для полей конца боя +468/+472/+520.</summary>
        public class RogueliteStageOutcome
        {
            public bool Victory;
            public int Stage;           // номер этапа, который играли (с единицы)
            public int BaseCurrency;    // награда этапа
            public int BonusCurrency;   // награда за место (epic_win_bonus)
        }

        /// <summary>
        /// Закрывает этап забега.
        ///
        /// Победа: этап засчитан (+8 растёт), место (+32) и длительность (+72)
        /// дописываются, выдаётся валюта события — награда этапа и бонус за место
        /// из ExtraRewardsForRankInBattle[место]; бонус клиент рисует, только если
        /// тип 76. Боец (+56) запоминается на первом этапе — с этого момента забег
        /// заперт за ним (getExistingRunLockedBrawler при +8 ≥ 1).
        ///
        /// Поражение: забег окончен, этап не засчитан.
        ///
        /// В обоих случаях во входящие кладётся письмо 98 со снимком забега и
        /// событием: по нему клиент показывает экран итога (победа, «идеальный
        /// забег», «победитель» на последнем этапе). После поражения или последнего
        /// этапа забег начинается заново.
        /// </summary>
        /// <summary>Надетые карточки забега для слота (копия), пусто если забега нет.</summary>
        public List<int> GetRogueliteCards(int eventSlot)
        {
            lock (RewardSync)
            {
                PlayerRogueliteEventData run = PlayerRoguelite?.Find(r => r != null && r.EventSlotCode == eventSlot);
                return run != null ? new List<int>(run.EquippedCardGlobalIds) : new List<int>();
            }
        }

        /// <summary>Сохраняет надетые карточки забега (клиент не принимает больше 32).</summary>
        public void SetRogueliteCards(int eventSlot, List<int> cards)
        {
            lock (RewardSync)
            {
                PlayerRogueliteEventData run = PlayerRoguelite?.Find(r => r != null && r.EventSlotCode == eventSlot);
                if (run == null) return;
                run.EquippedCardGlobalIds = cards.Take(PlayerRogueliteEventData.MAX_ARRAY_ITEMS).ToList();
            }
        }

        public RogueliteStageOutcome AdvanceRoguelite(int eventSlot, int heroGlobalId, int rank, int battleTicks)
        {
            RogueliteStageOutcome outcome = null;
            lock (RewardSync)
            {
                if (PlayerRoguelite == null) return null;

                PlayerRogueliteEventData run = PlayerRoguelite.Find(r => r != null && r.EventSlotCode == eventSlot);
                if (run == null) return null;

                RogueliteEvent roguelite = null;
                if (Events != null)
                {
                    foreach (EventData e in Events)
                    {
                        if (e == null || e.Slot != eventSlot || e.Roguelite?.Stages == null) continue;
                        roguelite = e.Roguelite;
                        break;
                    }
                }
                if (roguelite == null) return null;

                int stageCount = roguelite.Stages.Count;
                bool victory = rank >= 1 && rank <= ROGUELITE_WIN_RANK;

                outcome = new RogueliteStageOutcome
                {
                    Victory = victory,
                    Stage = run.CurrentStage + 1
                };

                if (run.SelectedHeroGlobalId == 0 && heroGlobalId != 0)
                    run.SelectedHeroGlobalId = heroGlobalId;

                if (victory)
                {
                    int stageIndex = run.CurrentStage;
                    run.CurrentStage++;

                    if (run.StageRanks.Count < PlayerRogueliteEventData.MAX_ARRAY_ITEMS)
                        run.StageRanks.Add(rank);
                    if (run.BattleDurations.Count < PlayerRogueliteEventData.MAX_ARRAY_ITEMS)
                        run.BattleDurations.Add(battleTicks / 20);

                    if (stageIndex >= 0 && stageIndex < stageCount)
                        outcome.BaseCurrency = CurrencyOf(roguelite.Stages[stageIndex]?.Rewards);

                    if (rank >= 0 && rank < roguelite.ExtraRewardsForRankInBattle.Count)
                    {
                        LogicGemOffer bonus = roguelite.ExtraRewardsForRankInBattle[rank];
                        if (bonus != null && bonus.Type == ShopItem.CollabEventCurrency)
                            outcome.BonusCurrency = bonus.Count;
                    }

                    int gained = outcome.BaseCurrency + outcome.BonusCurrency;
                    if (gained > 0 && run.CanClaimReward)
                    {
                        CollabCurrency += gained;
                        run.ClaimedTotalCollabEventCurrency += gained;
                    }
                }

                // Снимок уходит клиенту как есть — до сброса забега.
                NotificationFactory.Store(this, new RogueliteStageResultNotification
                {
                    Victory = victory,
                    Run = CloneRun(run),
                    Event = roguelite
                });

                bool finished = !victory || run.CurrentStage >= stageCount;
                System.Console.WriteLine($"[Roguelite] слот {eventSlot}: этап {outcome.Stage}/{stageCount}, место {rank}, "
                    + $"{(victory ? "победа" : "поражение")}, валюта {outcome.BaseCurrency}+{outcome.BonusCurrency}"
                    + (finished ? ", забег окончен" : ""));

                if (finished)
                {
                    int index = PlayerRoguelite.IndexOf(run);
                    PlayerRogueliteEventData fresh = NewRogueliteRun(eventSlot);
                    fresh.EventEndTime = run.EventEndTime;
                    PlayerRoguelite[index] = fresh;
                }
            }

            RefreshCollabSnapshot(DateTime.UtcNow);
            return outcome;
        }

        private static int CurrencyOf(List<LogicGemOffer> rewards)
        {
            int total = 0;
            if (rewards == null) return 0;
            foreach (LogicGemOffer offer in rewards)
                if (offer != null && offer.Type == ShopItem.CollabEventCurrency) total += offer.Count;
            return total;
        }

        private static PlayerRogueliteEventData CloneRun(PlayerRogueliteEventData run)
        {
            return new PlayerRogueliteEventData
            {
                CanClaimReward = run.CanClaimReward,
                EventSlotCode = run.EventSlotCode,
                CurrentEventId = run.CurrentEventId,
                SelectedHeroGlobalId = run.SelectedHeroGlobalId,
                EventEndTime = run.EventEndTime,
                ClaimedTotalCollabEventCurrency = run.ClaimedTotalCollabEventCurrency,
                CurrentStage = run.CurrentStage,
                BattleDurations = new List<int>(run.BattleDurations),
                EquippedCardGlobalIds = new List<int>(run.EquippedCardGlobalIds),
                StageRanks = new List<int>(run.StageRanks)
            };
        }

        public void PushCollabData()
        {
            if (HomeMode?.GameListener == null || PlayerCollab == null) return;

            LogicPlayerDataChangedCommand command = new LogicPlayerDataChangedCommand
            {
                Subtype = LogicPlayerDataChangedCommand.SUBTYPE_COLLAB,
                Collab = PlayerCollab
            };

            AvailableServerCommandMessage message = new AvailableServerCommandMessage();
            message.Command = command;
            HomeMode.GameListener.SendMessage(message);
        }

        /// <summary>
        /// Типы заданий. Строки TID_QUEST_TYPE_REQ_* лежат в клиенте подряд одной
        /// таблицей по адресу 0x100d6d030, и индекс в ней и есть значение поля +8
        /// структуры QuestData.
        /// </summary>
        private enum QuestType
        {
            Win = 0,
            Kill = 1,
            DealDamage = 2,
            Heal = 3,
            PlayAgain = 4,
            TeamPlay = 5,
            ModeSpecific = 6,
        }

        /// <summary>
        /// Вкладка, в которую клиент положит задание. Раскладку делает
        /// QuestsPopup::sortQuestsByType (0x1002d8580), и решает она по полям самого
        /// задания, а не по тому, в каком из трёх списков LogicQuests оно приехало:
        ///   isChronosQuest  = +156 &gt;= 0                         -> «Хронос»
        ///   +143 == 1                                            -> «Трофейный мир»
        ///   isSpecialEventQuest = режим из особого события        -> «Особые»
        ///   isDailyQuest                                         -> «Ежедневные»
        ///   иначе                                                -> «Сезонные»
        /// Ежедневное задание клиент признаёт только если +156 отрицательное,
        /// +143 и +144 нулевые и при этом +132 больше нуля либо +164 не меньше единицы.
        /// </summary>
        private enum QuestTab
        {
            Daily,
            Season,
            TrophyWorld,
        }

        /// <summary>
        /// Звенья цепочки мега-квестов. Задание становится мега-квестом по трём полям:
        /// +144 в единице, +148 — номер цепочки, +152 — номер звена с единицы.
        /// Файл для отрисовки клиент ищет отдельно, по строке MegaQuestSlot&lt;цепочка&gt;SC
        /// в chronos_asset_ids.csv, и он уже опубликован в списке chronos.
        /// </summary>
        /// <summary>
        /// Звено цепочки: своя цель и свой набор наград. У мега-квестов задачи
        /// отдельные от ежедневных — цели крупнее, и награда выдаётся не одна,
        /// а списком, потому что m_rewards в QuestData это список.
        /// </summary>
        private readonly struct MegaQuestStep
        {
            public readonly QuestType Type;
            public readonly int Target;
            public readonly int Tokens;    // жетоны пропуска
            public readonly int Waffles;   // валюта события

            public MegaQuestStep(QuestType type, int target, int tokens, int waffles)
            {
                Type = type; Target = target; Tokens = tokens; Waffles = waffles;
            }
        }

        private static readonly MegaQuestStep[] MegaQuestChain =
        {
            new MegaQuestStep(QuestType.Kill,        30,     1000, 1000),  // победи врага 30 раз
            new MegaQuestStep(QuestType.Win,         20,     1000, 1000),
            new MegaQuestStep(QuestType.DealDamage,  150000, 1000, 1000),
            new MegaQuestStep(QuestType.PlayAgain,   40,     1000, 1000),
        };

        private const int MEGA_QUEST_CHAIN_ID = 1;

        private readonly struct QuestTemplate
        {
            public readonly QuestTab Tab;
            public readonly QuestType Type;
            public readonly int Target;
            public readonly int Mode;        // -1 = без привязки к режиму
            public readonly ShopItem Reward;
            public readonly int Amount;

            public QuestTemplate(QuestTab tab, QuestType type, int target, int mode, ShopItem reward, int amount)
            {
                Tab = tab; Type = type; Target = target; Mode = mode; Reward = reward; Amount = amount;
            }
        }

        /// <summary>
        /// Постоянный набор заданий вместо случайной генерации. Раньше сюда шли
        /// случайные числа: награда до 9338 штук, режим до 60 и боец до 99, хотя
        /// таких режимов и бойцов в таблицах нет.
        /// </summary>
        private static readonly QuestTemplate[] QuestPool =
        {
            // Ежедневные
            new QuestTemplate(QuestTab.Daily, QuestType.Win,          3,   -1, ShopItem.BrawlPassTokens, 150),
            new QuestTemplate(QuestTab.Daily, QuestType.PlayAgain,    5,   -1, ShopItem.BrawlPassTokens, 100),
            new QuestTemplate(QuestTab.Daily, QuestType.Kill,        10,   -1, ShopItem.BrawlPassTokens, 150),
            new QuestTemplate(QuestTab.Daily, QuestType.DealDamage, 25000, -1, ShopItem.BrawlPassTokens, 200),
            new QuestTemplate(QuestTab.Daily, QuestType.Heal,      5000,   -1, ShopItem.BrawlPassTokens, 150),

            // Сезонные
            new QuestTemplate(QuestTab.Season, QuestType.Win,        25,   -1, ShopItem.Coin,           2000),
            new QuestTemplate(QuestTab.Season, QuestType.Kill,      100,   -1, ShopItem.Bling,           300),
            new QuestTemplate(QuestTab.Season, QuestType.ModeSpecific, 10,  0, ShopItem.BrawlPassTokens, 500),  // Gem Grab
            new QuestTemplate(QuestTab.Season, QuestType.ModeSpecific, 10,  6, ShopItem.BrawlPassTokens, 500),  // Showdown
            new QuestTemplate(QuestTab.Season, QuestType.ModeSpecific, 10,  5, ShopItem.Bling,           300),  // Brawl Ball
        };

        /// <summary>
        /// Одноразовая самопроверка блока конфигурации: прогоняет уже записанные
        /// байты обратно зеркальным декодером. Печатается один раз за запуск, чтобы
        /// не засорять лог на каждом входе в лобби.
        /// </summary>
        private static bool ConfProbeDone;

        /// <summary>Сколько раз забран хвост сезона.</summary>
        private int GetRankedPassTailClaimed(int season)
        {
            if (RankedPassTailClaimed == null) return 0;
            return RankedPassTailClaimed.TryGetValue(season, out int claimed) ? claimed : 0;
        }

        /// <summary>
        /// Забранные ступени трека одним LogicBitList: признак наличия и четыре
        /// целых по 32 бита (LogicBitList::decode 0x100a28220, конструктор на 128 бит
        /// даёт ровно четыре слова). Бит с номером ступени — она забрана.
        /// </summary>
        private void WriteRankedPassClaimedBits(ByteStream stream, int trackType)
        {
            const int Words = 4;
            int[] words = new int[Words];

            if (RankedPassClaimed != null)
            {
                string prefix = trackType + ":" + CompetitivePassSeason + ":";

                foreach (string claimed in RankedPassClaimed)
                {
                    if (claimed == null || !claimed.StartsWith(prefix)) continue;
                    if (!int.TryParse(claimed.Substring(prefix.Length), out int index)) continue;
                    if (index < 0 || index >= Words * 32) continue;

                    words[index >> 5] |= 1 << (index & 31);
                }
            }

            stream.WriteBoolean(true);
            for (int i = 0; i < Words; i++) stream.WriteInt(words[i]);
        }

        /// <summary>
        /// Список дорожек ежедневных побед. Клиент берёт из него первую запись
        /// (getActiveDailyWinTrack 0x100341d90); если список пуст, панели просто нет.
        /// </summary>
        private static void WriteDailyWinTracks(ByteStream stream)
        {
            DailyWin.DailyWinTrack track = DailyWin.DailyWinTrack.GetDefault();

            if (track == null)
            {
                stream.WriteVInt(0);
                return;
            }

            stream.WriteVInt(1);
            track.Encode(stream);
        }

        private static void RunConfProbe(ByteStream stream, int confStart)
        {
            if (ConfProbeDone) return;
            ConfProbeDone = true;

            int confEnd = stream.GetOffset();
            ConfDataProbe.Result probe = ConfDataProbe.Verify(stream.GetByteArray(), confStart, confEnd);

            if (probe.Error != null)
            {
                System.Console.WriteLine($"[Conf] разбор упал: {probe.Error}");
                System.Console.WriteLine("[Conf] метки: " + string.Join(" ", probe.Trace));
                return;
            }

            System.Console.WriteLine($"[Conf] записано {confEnd - confStart} б, прочитано "
                + $"{probe.Consumed - confStart} б, сошлось: {(probe.Ok ? "да" : "НЕТ")}"
                + $", список chronos на смещении {probe.ChronosAssetListOffset - confStart}"
                + $", записей в нём {probe.ChronosAssetEntryCount}");
            System.Console.WriteLine("[Conf] метки: " + string.Join(" ", probe.Trace));
        }

        /// <summary>
        /// Убирает отметки о покупке карточных наборов. Они одноразовыми быть не
        /// должны, а у тех, кто успел купить до этой правки, наборы пропали из витрины.
        /// </summary>
        private void UnclaimCollabPacks()
        {
            if (OffersClaimed == null) return;
            OffersClaimed.RemoveAll(c => c != null && c.StartsWith("collab_pack_"));

        }

        public void GenerateQuest()
        {
            questsList.RemoveAll(q => q == null || q.GemOffer == null);
            if (ResetQuestsOnLogin)
            {
                questsList.Clear();
            }

            // Досыпаем по НОМЕРУ шаблона, а не по длине списка: в списке лежат ещё и
            // мега-квесты, и раньше позиция в нём использовалась как индекс в пуле —
            // стоило одному заданию выпасть, и на его место вставало чужое.
            for (int i = 0; i < QuestPool.Length; i++)
            {
                if (questsList.Exists(q => q != null && !q.IsMegaQuest && q.PoolIndex == i)) continue;

                QuestTemplate template = QuestPool[i];

                Quest quest = new Quest
                {
                    PoolIndex = i,
                    GemOffer = new LogicGemOffer(template.Reward, template.Amount),
                    QuestsProgress = template.Target,
                    Missia = (int)template.Type,
                    Progress = 0,
                    Checknuto = false,
                    isUpdateQuest = false,
                    ChronosIndex = -1,          // иначе задание считается хроносным
                    DailyMarker = template.Tab == QuestTab.Daily ? 1 : 0,
                    TrophyWorldExtra = template.Tab == QuestTab.TrophyWorld,
                };

                if (template.Mode >= 0) quest.GameModes.Add(template.Mode);

                questsList.Add(quest);
            }

            AddMegaQuestChain();
        }

        /// <summary>Досыпает звенья цепочки, если их ещё нет в списке.</summary>
        private void AddMegaQuestChain()
        {
            for (int i = 0; i < MegaQuestChain.Length; i++)
            {
                int index = i + 1;
                if (questsList.Exists(q => q != null && q.IsMegaQuest
                    && q.MegaChain == MEGA_QUEST_CHAIN_ID && q.MegaIndex == index)) continue;

                MegaQuestStep step = MegaQuestChain[i];

                Quest quest = new Quest
                {
                    QuestsProgress = step.Target,
                    Missia = (int)step.Type,
                    Progress = 0,
                    ChronosIndex = -1,
                    IsMegaQuest = true,
                    MegaChain = MEGA_QUEST_CHAIN_ID,
                    MegaIndex = index,
                };

                quest.Rewards.Add(new LogicGemOffer(ShopItem.BrawlPassTokens, step.Tokens));
                quest.Rewards.Add(new LogicGemOffer(ShopItem.CollabEventCurrency, step.Waffles));
                quest.GemOffer = quest.Rewards[0];

                questsList.Add(quest);
            }
        }

        public void Tick()
        {
            LastVisitHomeTime = DateTime.UtcNow;
            TokenReward = 0;
            TrophiesReward = 0;
            StarTokenReward = 0;

            // Рекорд кубков подтягиваем к сумме по бойцам: по нему открываются
            // вехи трофейной дороги, и он не должен отставать от боёв.
            HomeMode?.Avatar?.RefreshHighestTrophies();
        }

        public void PurchaseOfferWithCatalog(int DataGlobalId, int Currency)
        {
            LogicGiveDeliveryItemsCommand command = new LogicGiveDeliveryItemsCommand();
            if (DataGlobalId > 29000000 && DataGlobalId < 30000000)
            {
                SkinData skinData = DataTables.Get(DataType.Skin).GetDataWithId<SkinData>(DataGlobalId);
                if (skinData == null) return;
                if (Currency == 1) // Gems
                {
                    if (!HomeMode.Avatar.UseDiamonds(skinData.PriceGems)) return;
                }
                if (Currency == 2) // Blings
                {
                    if (!HomeMode.Avatar.UseDiamonds(skinData.PriceBling)) return;
                }

                DeliveryUnit unit = new DeliveryUnit(100);
                GatchaDrop reward = new GatchaDrop(9);
                reward.SkinGlobalId = DataGlobalId;
                reward.Count = 1;
                unit.AddDrop(reward);
               
                command.DeliveryUnits.Add(unit);
                command.Execute(HomeMode);
                AvailableServerCommandMessage message = new AvailableServerCommandMessage();
                message.Command = command;
                HomeMode.GameListener.SendMessage(message);
                NewCommand(skinData);

            } else if (DataGlobalId > 52000000 && DataGlobalId < 53000000)
                {
                    EmoteData skinData = DataTables.Get(DataType.Emote).GetDataWithId<EmoteData>(DataGlobalId);
                    if (Currency == 1) // Gems
                    {
                        if (!HomeMode.Avatar.UseDiamonds(skinData.PriceGems)) return;
                    }
                    if (Currency == 2) // Blings
                    {
                        if (!HomeMode.Avatar.UseDiamonds(skinData.PriceBling)) return;
                    }

                    DeliveryUnit unit = new DeliveryUnit(100);
                    GatchaDrop reward = new GatchaDrop(11);
                    reward.DataGlobalId = DataGlobalId;
                    reward.Count = 1;
                    unit.AddDrop(reward);
                    command.DeliveryUnits.Add(unit);
                    command.Execute(HomeMode);
                AvailableServerCommandMessage message = new AvailableServerCommandMessage();
                message.Command = command;
                HomeMode.GameListener.SendMessage(message);
            }
            else if (DataGlobalId > 28000000 && DataGlobalId < 29000000)
                {
                    PlayerThumbnailData skinData = DataTables.Get(DataType.PlayerThumbnail).GetDataWithId<PlayerThumbnailData>(DataGlobalId);
                    if (Currency == 1) // Gems
                    {
                        if (!HomeMode.Avatar.UseDiamonds(skinData.PriceGems)) return;
                    }
                    if (Currency == 2) // Blings
                    {
                        if (!HomeMode.Avatar.UseDiamonds(skinData.PriceBling)) return;
                    }

                    DeliveryUnit unit = new DeliveryUnit(100);
                    GatchaDrop reward = new GatchaDrop(11);
                    reward.DataGlobalId = DataGlobalId;
                    reward.Count = 1;
                    unit.AddDrop(reward);
                    command.DeliveryUnits.Add(unit);
                    command.Execute(HomeMode);
                AvailableServerCommandMessage message = new AvailableServerCommandMessage();
                message.Command = command;
                HomeMode.GameListener.SendMessage(message);
            }
            
            void NewCommand(SkinData skinData)
            {
                DeliveryUnit unit = new DeliveryUnit(100);
                foreach (EmoteData emoteData in DataTables.Get(DataType.Emote).GetDatas())
                {
                    if (emoteData.Skin == skinData.Name)
                    {
                        GatchaDrop reward1 = new GatchaDrop(11);
                        reward1.DataGlobalId = DataTables.Get(DataType.Emote).GetData<EmoteData>(emoteData.Name).GetGlobalId();
                        reward1.Count = 1;
                        unit.AddDrop(reward1);
                    }
                }
                foreach (PlayerThumbnailData playerThumbnailData in DataTables.Get(DataType.PlayerThumbnail).GetDatas())
                {
                    if (playerThumbnailData.CatalogPreRequirementSkin == skinData.Name )
                    {
                        GatchaDrop reward1 = new GatchaDrop(11);
                        reward1.DataGlobalId = DataTables.Get(DataType.PlayerThumbnail).GetData<PlayerThumbnailData>(playerThumbnailData.Name).GetGlobalId();
                        reward1.Count = 1;
                        unit.AddDrop(reward1);
                    }
                }
                foreach (SprayData sprayData in DataTables.Get(DataType.Spray).GetDatas())
                {
                    if (sprayData.Skin == skinData.Name)
                    {
                        GatchaDrop reward1 = new GatchaDrop(11);
                        reward1.DataGlobalId = DataTables.Get(DataType.Spray).GetData<SprayData>(sprayData.Name).GetGlobalId();
                        reward1.Count = 1;
                        unit.AddDrop(reward1);
                    }
                }
                if (unit.GetDrops().Length == 0) return;

                // Своя команда: старая переиспользовала command и выдавала скин дважды.
                LogicGiveDeliveryItemsCommand extra = new LogicGiveDeliveryItemsCommand();
                extra.DeliveryUnits.Add(unit);
                extra.Execute(HomeMode);

                AvailableServerCommandMessage message = new AvailableServerCommandMessage();
                message.Command = extra;
                HomeMode.GameListener.SendMessage(message);
            }
        }
        
        public async void PurchaseOffer(int index)
        {
            if (index < 0 || index >= OfferBundles.Count)
            {
                System.Console.WriteLine($"[Buy] индекс {index} вне списка из {OfferBundles.Count}");
                return;
            }

            OfferBundle bundle = OfferBundles[index];
            System.Console.WriteLine($"[Buy] индекс {index}: {bundle.Claim}, валюта {bundle.Currency},"
                + $" цена {bundle.Cost}, контекст {bundle.ShopItemContext}, куплен: {bundle.Purchased}");
            if (bundle.Purchased) return;
            if (bundle.Items.Any(offer => offer.Type == ShopItem.BrawlerBox &&
                offer.SkinDataId == RandomReward.RandomRewardManager.GetContainer("DaredevilBrawlerBox")?.GetGlobalId()))
            {
                RandomReward.RandomRewardManager.PurchaseGigiBoxes(HomeMode, bundle);
                return;
            }
            switch (bundle.Currency)
            {
                // Валюта события (вафли). Баланс живёт в CollabCurrency и уходит клиенту
                // в LogicPlayerCollabEventData +172, поэтому после списания снимок
                // обновляется сразу, иначе в интерфейсе останется старая цифра.
                // 8 — код валюты события в клиенте (OfferBundleItem::setPrice,
                // ветка setCollabEventCurrencyPriceWithDiscount). 76 оставлен для
                // совместимости со старыми сохранёнными предложениями.
                case 8:
                case (int)ShopItem.CollabEventCurrency:
                    if (CollabCurrency < bundle.Cost) return;
                    CollabCurrency -= bundle.Cost;
                    RefreshCollabSnapshot(DateTime.UtcNow);
                    // Без досылки счётчик вафель в шапке остаётся старым до
                    // перезахода: клиент берёт его из снимка, а не пересчитывает сам.
                    PushCollabData();
                    break;

                case 0:
                    HomeMode.Avatar.UseDiamonds(bundle.Cost);
                    break;
                    
                case 1:
                    HomeMode.Avatar.UseGold(bundle.Cost);
                    break;
                    
                case 6:
                    HomeMode.Avatar.UseBlings(bundle.Cost);
                    break;
            }

            // Карточные наборы события покупаются сколько угодно раз — иначе после
            // первой же покупки набор исчезает из витрины, и собирать карты нечем.
            bool repeatable = bundle.Claim != null && bundle.Claim.StartsWith("collab_pack_");

            if (!repeatable)
            {
                bundle.Purchased = true;

                if (bundle.Claim == "debug")
                {
                    ;
                }
                else
                {
                    OffersClaimed.Add(bundle.Claim);
                }
            }

            Random rand = new Random();

            bool boxDelivered = false;
            LogicGiveDeliveryItemsCommand command = new LogicGiveDeliveryItemsCommand();
            DeliveryUnit unit = new DeliveryUnit(100);

            // Карточный набор события разыгрывается на сервере: скин выпадает редко,
            // обычно приходит карта. Содержимое предложения при этом не используется.
            if (bundle.Claim != null && bundle.Claim.StartsWith("collab_pack_"))
            {
                if (bundle.Claim == CollabAllCardsClaim) GiveAllCollabCards(unit);
                else
                {
                    // Сколько карточек в наборе — записано в самом предложении.
                    int cards = bundle.Items != null && bundle.Items.Count > 0
                        ? bundle.Items[0].Count
                        : 1;
                    if (cards < 1) cards = 1;

                    for (int i = 0; i < cards; i++) RollCollabCardPack(unit, rand);
                }

                command.DeliveryUnits.Add(unit);
                command.Execute(HomeMode);

                AvailableServerCommandMessage packMessage = new AvailableServerCommandMessage();
                packMessage.Command = command;
                HomeMode.GameListener.SendMessage(packMessage);
                return;
            }

            foreach (LogicGemOffer offer in bundle.Items)
            switch (offer.Type)
            {
                // Валюта события начисляется напрямую в баланс, а не через доставку:
                // клиент читает её из снимка LogicPlayerCollabEventData +172.
                case ShopItem.CollabEventCurrency:
                    CollabCurrency += offer.Count;
                    RefreshCollabSnapshot(DateTime.UtcNow);
                    PushCollabData();
                    break;

                case ShopItem.OverchargeStarrDrop:
                case ShopItem.StarrDropContainer:
                case ShopItem.RandomStarrDrop:
                case ShopItem.RandomCollabDrop:
                case ShopItem.MegaBox2:
                case ShopItem.AngelicStar:
                case ShopItem.DemonicStar:
                case ShopItem.RandomPresentDrop:
                case ShopItem.RandomSushiDrop:
                case ShopItem.TrophySeasonBox:
                case ShopItem.BrawlerBox:
                case ShopItem.GraffitiBox:
                case ShopItem.TrickBox:
                case ShopItem.MechBox:
                {
                    RandomRewardContainerData boxData = DataTables.Get(DataType.RandomRewardContainer)
                        ?.GetDataByGlobalId<RandomRewardContainerData>(offer.SkinDataId);
                    if (boxData != null)
                    {
                        // Коллабные контейнеры разыгрываются по своему списку: в общей
                        // таблице наград под их редкости ничего не подобрано, и обычный
                        // Give отдаёт пустоту.
                        var claimable = IsCollabCardContainer(offer.SkinDataId)
                            ? RandomReward.RandomRewardManager.GiveCollabCardPack(
                                HomeMode, boxData, CollabAlbumSkinIds)
                            : RandomReward.RandomRewardManager.Give(HomeMode, boxData);
                        boxDelivered = true;

                        // Анимация вскрытия запускается только когда в очереди есть
                        // непустая награда: Give возвращает null, если контейнеру
                        // нечего выдать, и тогда клиент ничего не показывает.
                        System.Console.WriteLine($"[Box] {boxData.Name} (id {offer.SkinDataId}): "
                            + (claimable == null
                                ? "выдача пустая — контейнеру нечего дать"
                                : $"наград {claimable.Rewards.Count}, валидна: {claimable.IsValid()}"));
                    }
                    else
                    {
                        System.Console.WriteLine($"[Box] контейнер {offer.SkinDataId} не найден в таблице");
                    }
                    break;
                }

                case ShopItem.Coin:
                    {
                        GatchaDrop reward = new GatchaDrop(7);
                        reward.Count = offer.Count;
                        unit.AddDrop(reward);
                        break;
                    }

                case ShopItem.Gems:
                    {
                        GatchaDrop reward = new GatchaDrop(8);
                        reward.Count = offer.Count;
                        unit.AddDrop(reward);
                        break;
                    }

                case ShopItem.CoinDoubler:
                    {
                        GatchaDrop reward = new GatchaDrop(8);
                        reward.Count = offer.Count;
                        unit.AddDrop(reward);
                        break;
                    }

                case ShopItem.Bling:
                    {
                        GatchaDrop reward = new GatchaDrop(25);
                        reward.Count = offer.Count;
                        unit.AddDrop(reward);
                        break;
                    }

                case ShopItem.PowerPoints:
                    {
                        GatchaDrop reward = new GatchaDrop(24);
                        reward.Count = offer.Count;
                        unit.AddDrop(reward);
                        break;
                    }
                case ShopItem.BrawlPassTailReward:
{
    HomeMode.Home.HasPremiumPass = true;
    HomeMode.Home.HasPremiumPassPlus = true;
    HomeMode.Home.BrawlPassTokens += 8000; 

    LogicGiveDeliveryItemsCommand bpCommand = new LogicGiveDeliveryItemsCommand();
    DeliveryUnit bpUnit = new DeliveryUnit(100); 

    GatchaDrop passDrop = new GatchaDrop(31);
    passDrop.Count = 1;
    bpUnit.AddDrop(passDrop);

    bpCommand.DeliveryUnits.Add(bpUnit);

    AvailableServerCommandMessage bpMsg = new AvailableServerCommandMessage();
    bpMsg.Command = bpCommand;
    HomeMode.GameListener.SendMessage(bpMsg);
    
    return;
}

                case ShopItem.CollabPoints:
                    {
                        GatchaDrop reward = new GatchaDrop(34);
                        reward.Count = offer.Count;
                        unit.AddDrop(reward);
                        break;
                    }

                case ShopItem.Brawler:
                    {
                        CharacterData hero = DataTables.Get(DataType.Character)
                            ?.GetDataByGlobalId<CharacterData>(offer.ItemDataId);
                        if (hero == null) break;

                        GatchaDrop reward = new GatchaDrop(1);
                        reward.DataGlobalId = offer.ItemDataId;
                        reward.Count = offer.Count > 0 ? offer.Count : 1;
                        unit.AddDrop(reward);
                        break;
                    }

                case ShopItem.PlayerThumbnail:
                    {
                        GatchaDrop reward = new GatchaDrop(11);
                        reward.DataGlobalId = GlobalId.CreateGlobalId(28, offer.SkinDataId);
                        reward.Count = offer.Count;
                        unit.AddDrop(reward);
                        break;
                    }
                case ShopItem.DailyStreak:
                    {
                        GatchaDrop reward = new GatchaDrop(11);
                        reward.DataGlobalId = GlobalId.CreateGlobalId(85, 12);
                        reward.Count = offer.Count;
                        unit.AddDrop(reward);
                        break;
                    }

                case ShopItem.Skin:
                    {
                        SkinData skin = DataTables.Get(DataType.Skin)?.GetDataWithId<SkinData>(offer.SkinDataId);
                        if (skin == null) break;

                        GatchaDrop reward = new GatchaDrop(9);
                        reward.SkinGlobalId = GlobalId.CreateGlobalId(29, offer.SkinDataId);
                        reward.Count = 1;
                        unit.AddDrop(reward);

                        NewCommand(skin, command);
                        break;
                    }

                // Повышение прогрессионного скина. Уровень у клиента нигде не
                // хранится: он берёт максимум ProgressionSkinLevel среди открытых
                // скинов семейства (LogicDailyData::getUnlockedProgressionSkinLevel
                // 0x1004c28e0), поэтому «повысить» — это открыть скин следующего
                // уровня. База семейства приходит в предложении ссылкой на скин.
                case ShopItem.ProgressionSkinLevelUp:
                    {
                        SkinData baseSkin = DataTables.Get(DataType.Skin)?.GetDataWithId<SkinData>(offer.SkinDataId);
                        if (baseSkin == null) break;

                        SkinData unlocked = Skins.ProgressionSkins.LevelUp(HomeMode, baseSkin.ProgressionSkinBase);
                        if (unlocked == null) break;

                        GatchaDrop reward = new GatchaDrop(9);
                        reward.SkinGlobalId = unlocked.GetGlobalId();
                        reward.Count = 1;
                        unit.AddDrop(reward);

                        NewCommand(unlocked, command);
                        break;
                    }

                // Карта события. У коллаба Stranger в collabs.csv стоит
                // CollabVFX = ArchetypeItemBrawler, а в csv_client/shop_items.csv
                // под этим именем заведён тип 56 — им и выдаются карты колоды.
                case ShopItem.ArchetypeItem:
                case ShopItem.Item:
                    {
                        GatchaDrop reward = new GatchaDrop(4);
                        reward.Count = offer.Count;
                        reward.DataGlobalId = offer.ItemDataId;
                        reward.CardGlobalId = offer.SkinDataId;
                        unit.AddDrop(reward);
                        break;
                    }

                case ShopItem.Emote:
                {
                    GatchaDrop reward = new GatchaDrop(11);
                    reward.DataGlobalId = GlobalId.CreateGlobalId(52, offer.SkinDataId);
                    reward.Count = 1;
                    unit.AddDrop(reward);
                    break;
                }

                default:
                {
                    Text.SendMessage("<c06ff00>S<c0dff00>h<c14ff00>o<c1bff00>p<c22ff00>I<c29ff00>t<c30ff00>e<c37ff00>m<c3eff00> <c44ff00>n<c4bff00>o<c52ff00>t<c59ff00> <c60ff00>i<c67ff00>n<c6eff00>i<c75ff00>t<c7cff00>i<c82ff00>a<c89ff00>l<c90ff00>i<c97ff00>z<c9eff00>e<ca5ff00>d<cacff00>\n<cbafe00>P<cc0ff00>l<cc7ff00>e<cceff00>a<cd5ff00>s<cdcff00>e<ce3ff00> <ceaff00>c<cf1ff00>o<cf8ff00>n<cfeff00>t<cfff800>a<cfff100>c<cffea00>t<cffe300> <cffdc00>t<cffd500>h<cffce00>e<cffc700> <cffc000>d<cffba00>e<cffb300>v<cffac00>e<cffa500>l<cff9e00>o<cff9700>p<cff9000>e<cff8900>r<cff8200>s<cff7c00> <cff7500>w<cff6e00>i<cff6700>t<cff6000>h<cff5900> <cff5200>t<cff4b00>h<cfe4400>i<cff3e00>s<cff3700> <cff3000>p<cff2900>r<cff2200>o<cff1b00>b<cff1400>l<cff0d00>e<cff0600>m<cff0200>.</c>",
                        HomeMode
                    );
                    break;
                }
            }
            if (unit.GetDrops().Length > 0)
            {
                command.DeliveryUnits.Add(unit);
                command.Execute(HomeMode);

                AvailableServerCommandMessage message = new AvailableServerCommandMessage();
                message.Command = command;
                HomeMode.GameListener.SendMessage(message);
            }
            else
            {
                LogicGiveDeliveryItemsCommand unlock = new LogicGiveDeliveryItemsCommand();
                unlock.DeliveryUnits.Add(new DeliveryUnit(100));

                AvailableServerCommandMessage message = new AvailableServerCommandMessage();
                message.Command = unlock;
                HomeMode.GameListener.SendMessage(message);
            }

            void NewCommand(SkinData skinData, LogicGiveDeliveryItemsCommand command)
            {
                if (skinData == null) return;
                DeliveryUnit unit = new DeliveryUnit(100);
                foreach (EmoteData emoteData in DataTables.Get(DataType.Emote).GetDatas())
                {
                    if (emoteData.Skin == skinData.Name)
                    {
                        GatchaDrop reward1 = new GatchaDrop(11);
                        reward1.DataGlobalId = DataTables.Get(DataType.Emote).GetData<EmoteData>(emoteData.Name).GetGlobalId();
                        reward1.Count = 1;
                        unit.AddDrop(reward1);
                    }
                }
                foreach (PlayerThumbnailData playerThumbnailData in DataTables.Get(DataType.PlayerThumbnail).GetDatas())
                {
                    if (playerThumbnailData.CatalogPreRequirementSkin == skinData.Name)
                    {
                        GatchaDrop reward1 = new GatchaDrop(11);
                        reward1.DataGlobalId = DataTables.Get(DataType.PlayerThumbnail).GetData<PlayerThumbnailData>(playerThumbnailData.Name).GetGlobalId();
                        reward1.Count = 1;
                        unit.AddDrop(reward1);
                    }
                }
                if (unit.GetDrops().Length == 0) return;

                // Своя команда: старый код переиспользовал command и выдавал скин дважды.
                LogicGiveDeliveryItemsCommand extra = new LogicGiveDeliveryItemsCommand();
                extra.DeliveryUnits.Add(unit);
                extra.Execute(HomeMode);

                AvailableServerCommandMessage message = new AvailableServerCommandMessage();
                message.Command = extra;
                HomeMode.GameListener.SendMessage(message);
            }
        }
        
        public void GenerateOffer(
    DateTime OfferStart,
    DateTime OfferEnd,
    int Count,
    int BrawlerID,
    int Extra,
    ShopItem Item,
    int Cost,
    int OldCost,
    int Currency,
    string Claim,
    string Title,
    string BGR,
    int IsTID,
    int DailyOfferType, 
    bool OneTimeOffer,
    bool LoadOnStartup,
    bool Processed,
    int TypeBenefit,
    int Benefit,
    int panelClass,
    int panelType,
    int styleClass,
    int styleType,
    int shopItemContext = 0,
    int coverId = 0,
    int itemGlobalIdOverride = 0
    ,
    int ChainOrder = 0,
    int ChainRequirement = 2)
{
    if (DateTime.UtcNow > OfferEnd)
    {
        return;
    }

    if (OffersClaimed != null && Claim != "debug" && OffersClaimed.Contains(Claim))
    {
        return; 
    }

    OfferBundle bundle = new OfferBundle();
    bundle.IsDailyDeals = false;
    bundle.IsTrue = true;
    bundle.EndTime = OfferEnd;
    bundle.Cost = Cost;
    bundle.OldCost = OldCost;
    bundle.Currency = Currency;
    bundle.Claim = Claim;
    bundle.Title = Title;
    // Фон у всех предложений один — тот, что стоит у активной темы в themes.csv.
    // Важно: у темы РАЗНЫЕ клипы под лобби и под предложение. Сюда идёт
    // offer_bgr_<тема>; раньше сюда попадал фон лобби bgr_<тема>, среди фонов
    // предложения такого клипа нет, и вместо фона выходила пустота.
    bundle.BackgroundExportName = !string.IsNullOrEmpty(MenuTheme.OfferBackgroundExportName)
        ? MenuTheme.OfferBackgroundExportName
        : BGR;
    bundle.IsTID = IsTID;
    bundle.OfferType = DailyOfferType;
    bundle.OneTimeOffer = OneTimeOffer;
    bundle.LoadOnStartup = LoadOnStartup;
    bundle.Processed = Processed;
    bundle.TypeBenefit = TypeBenefit;
    bundle.Benefit = Benefit;
    bundle.ShopPanelLayoutClass = panelClass;
    bundle.ShopPanelLayoutType = panelType;
    bundle.ChainOrder = ChainOrder;
    bundle.ChainRequirement = ChainRequirement;
    bundle.ShopStyleSetClass = styleClass;
    bundle.ShopStyleSetType = styleType;
    bundle.ShopItemContext = shopItemContext;
    bundle.CoverId = coverId;
    
    int itemGlobalId = itemGlobalIdOverride != 0 ? itemGlobalIdOverride : (16000000 + BrawlerID);
    LogicGemOffer offer = new LogicGemOffer(Item, Count, itemGlobalId, Extra);
    bundle.Items.Add(offer);
    
    OfferBundles.Add(bundle);
}

        /// <summary>
        /// Товар, который выдают карточные предложения события. В перечне ShopItem
        /// отдельного типа под карты нет, поэтому берём заведомо рабочий тип —
        /// поменять можно здесь одной строкой, когда подтвердится настоящий.
        /// </summary>
        private const ShopItem CollabCardItem = ShopItem.CollabEventCurrency;

        /// <summary>Четыре покупки за валюту события. Цена растёт, награда тоже.</summary>
        private void GenerateCollabCardOffers()
        {
            DateTime start = DateTime.UtcNow.AddDays(-1);
            DateTime end = DateTime.UtcNow.AddDays(30);
            int[] costs   = { 10, 25, 50, 100, 150, 200, 350, 500 };      // цена в блингах
            int[] waffles = { 20, 50, 120, 300, 500, 700, 1300, 2000 };   // сколько вафель даёт покупка

            for (int i = 0; i < costs.Length; i++)
            {
                GenerateOffer(
                    start, end,
                    /* Count */ waffles[i],
                    /* BrawlerID */ 0,
                    /* Extra */ 0,
                    CollabCardItem,
                    /* Cost */ costs[i],
                    /* OldCost */ 0,
                    // Валюта цены — обычный код (6 = блинги). Поле Currency это НЕ ShopItem:
                    // в клиенте предложение попадает в событийный магазин по наличию
                    // товара типа 76 внутри (NightMarketShopPopup::isValidCurrencyShopBundle),
                    // а не по коду цены. С 76 в цене клиент не мог нарисовать ценник и прятал всё.
                    /* Currency */ 6,
                    /* Claim */ "collab_card_" + i,
                    /* Title */ "TID_COLLAB_13",
                    /* BGR */ null,
                    /* IsTID */ 1,
                    /* DailyOfferType */ 0,
                    /* OneTimeOffer */ false,
                    /* LoadOnStartup */ false,
                    /* Processed */ false,
                    /* TypeBenefit */ 0,
                    /* Benefit */ 0,
                    0, 0, 0, 0);
            }

            GenerateCollabOfferChain(start, end);

            // Бесплатная выдача валюты события.
            GenerateOffer(
                start, end,
                /* Count */ CollabFreeCurrencyAmount,
                /* BrawlerID */ 0,
                /* Extra */ 0,
                CollabCardItem,
                /* Cost */ 0,
                /* OldCost */ 0,
                /* Currency */ 6,
                /* Claim */ CollabFreeCurrencyClaim,
                /* Title */ "TID_COLLAB_13",
                /* BGR */ null,
                /* IsTID */ 1,
                /* DailyOfferType */ 0,
                /* OneTimeOffer */ false,
                /* LoadOnStartup */ false,
                /* Processed */ false,
                /* TypeBenefit */ 0,
                /* Benefit */ 0,
                0, 0, 0, 0);

            GenerateCollabCardPacks(start, end);
        }

        /// <summary>
        /// Альбом StrangerCollabSkinAlbum (skin_albums.csv, Collabs=Stranger).
        /// Индексы — номера строк skins.csv без строк-продолжений, как их считает
        /// загрузчик таблиц, поэтому это ровно то, что клиент ждёт в LogicGemOffer.
        /// </summary>
        internal static readonly int[] CollabAlbumSkinIds =
        {
            1347, // DragonRiderStrange   — Драко
            1348, // SoulCollectorStrange — Гас
            1349, // PainterStrange       — Берри
            1350, // BullGuyStrange       — Хоппер
            1346, // MorningstarStrange   — Луми
            1353, // ShamanStrangeOvercharge — Дастин Нита, последняя карта альбома
        };

        private static readonly int[] CollabAlbumCosts = { 150, 300, 450, 600, 900, 1500 };

        /// <summary>
        /// Обложки карточек в порядке CoversIds у коллаба Stranger. Это не отдельные
        /// ассеты, а метки кадров внутри клипа "cover" у панели предложения
        /// (ShopBgElement::setupCoverClip ищет ребёнка с именем "cover" и делает
        /// gotoAndStop по метке из OfferCoverModes). Панель берётся из стиля
        /// card_pack, а у него UseCollabEventSC = TRUE — то есть из .sc самого
        /// события, поэтому метки здесь стрейнджеровские, а не из ui.sc.
        /// </summary>
        private static readonly int[] CollabPackCovers = { 5, 4, 4, 6, 6, 6, 3 };

        /// <summary>
        /// Стиль витрины card_pack: shop_style_sets.csv — класс 70, строка 9.
        /// PanelAssetOverride = panel_offer_collab_card_pack,
        /// OfferCardAssetOverride = offer_1_item_collab_card_pack,
        /// UseCollabEventSC = TRUE. Оба экспортных имени лежат в
        /// collab_stranger_things.sc, который клиент тянет по хешу из слота.
        /// Без этой ссылки берётся дефолтная панель, у её клипа "cover" нужных
        /// кадров нет, и товар выглядит пустым до нажатия.
        /// </summary>
        private const int ShopStyleSetClassId = 70;
        private const int CardPackStyleSetId = 9;

        private static readonly string[] CollabAlbumTitles =
        {
            "Драко", "Гас", "Берри", "Хоппер", "Луми", "Дастин Нита"
        };

        /// <summary>
        /// Карточные наборы витрины события. Клиент открывает её как NightMarketShopPopup
        /// и берёт туда только предложения с контекстом 7 (Shop::getBundleShopItemContext
        /// переводит 7 в 3, а collectValidBundles фильтрует именно по тройке).
        /// Цена идёт в валюте события: код 8 — та самая ветка
        /// setCollabEventCurrencyPriceWithDiscount в OfferBundleItem::setPrice.
        /// Семь позиций — ровно столько стилей card_pack и обложек перечислено
        /// у коллаба Stranger в collabs.csv.
        /// </summary>
        /// <summary>
        /// Контейнеры случайной награды коллаба, random_reward_containers.csv,
        /// класс таблицы 80. У всех VisualType = SLASHING и TargetClip =
        /// collab_random_reward_opening — это и есть вскрытие карточки когтями.
        /// </summary>
        private const int COLLAB_DROP_RARE       = 80000008;
        private const int COLLAB_DROP_SUPER_RARE = 80000009;
        private const int COLLAB_DROP_EPIC       = 80000010;
        private const int COLLAB_DROP_MYTHIC     = 80000011;
        private const int COLLAB_DROP_LEGENDARY  = 80000012;

        /// <summary>
        /// MetaType предметов коллаба. В collabs.csv есть колонка Metatype, и она
        /// прямо задаёт, какие карты cards.csv принадлежат событию:
        /// Gozilla и Wasabi — 7, Coral — 8, Demons — 10, Surfers — 11,
        /// Stranger (CollabId 13) — 12. MetaType 12 в cards.csv это строки
        /// *_roguelite_deck, то есть колоды бойцов. Поэтому карты item_sb_*
        /// (MetaType 8) относятся к коллабу Coral, а не к нашему, и прошлый
        /// список 23000827..23001032 был смесью Demons (10) и Surfers (11).
        /// </summary>
        private const int COLLAB_CARD_META_TYPE = 12;

        private static int[] _collabDeckCards;

        /// <summary>
        /// Колоды события. Собираются из таблицы, а не прописаны номерами строк:
        /// в CSV продолжения строк склеиваются с предыдущей, поэтому номер строки
        /// в файле не равен instanceId.
        /// </summary>
        private static int[] CollabDeckCards
        {
            get
            {
                if (_collabDeckCards != null) return _collabDeckCards;

                List<int> ids = new List<int>();
                DataTable cards = DataTables.Get(DataType.Card);
                if (cards != null)
                {
                    foreach (CardData card in cards.GetDatas())
                    {
                        if (card == null || card.Disabled) continue;
                        if (card.MetaType != COLLAB_CARD_META_TYPE) continue;

                        // Target обязателен. GemOfferItem::setupHeroIcon берёт бойца
                        // из предложения или из getTargetCharacter, и только при
                        // непустом бойце вызывает replaceInstanceWithIcon, которая
                        // создаёт клип image_ph. Дальше идёт безусловная запись
                        // *(getMovieClipByName(v12, "image_ph") + 8) = 0 — без бойца
                        // это запись по нулевому указателю, то есть вылет при входе
                        // во вкладку события.
                        if (string.IsNullOrEmpty(card.Target)) continue;

                        ids.Add(card.GetInstanceId() + 23000000);
                    }
                }

                _collabDeckCards = ids.ToArray();
                return _collabDeckCards;
            }
        }

        /// <summary>Шанс скина из набора, в процентах. Остальное — колода события.</summary>
        private const int COLLAB_PACK_SKIN_CHANCE = 12;

        /// <summary>Колода бойца по имени персонажа, 0 если такой нет.</summary>
        private static int GetDeckCardForCharacter(string characterName)
        {
            if (string.IsNullOrEmpty(characterName)) return 0;

            DataTable cards = DataTables.Get(DataType.Card);
            if (cards == null) return 0;

            foreach (CardData card in cards.GetDatas())
            {
                if (card == null || card.Disabled) continue;
                if (card.MetaType != COLLAB_CARD_META_TYPE) continue;
                if (card.Target != characterName) continue;
                return card.GetInstanceId() + 23000000;
            }

            return 0;
        }

        /// <summary>
        /// Колоды, которых у игрока ещё нет. Сначала идут колоды купленных бойцов —
        /// колода без бойца бесполезна, isBrawlerAndCardDeckOwned требует обоих.
        /// </summary>
        private List<int> GetMissingDeckCards()
        {
            List<int> owned = new List<int>();
            List<int> rest = new List<int>();

            List<int> heroDecks = new List<int>();
            if (HomeMode?.Avatar?.Heroes != null)
            {
                foreach (Hero hero in HomeMode.Avatar.Heroes)
                {
                    CardData deck = hero.GetDefaultMetaForHero(COLLAB_CARD_META_TYPE);
                    if (deck != null) heroDecks.Add(deck.GetInstanceId() + 23000000);
                }
            }

            foreach (int deck in CollabDeckCards)
            {
                if (UnlockedRogueliteDecks != null && UnlockedRogueliteDecks.Contains(deck)) continue;
                if (heroDecks.Contains(deck)) owned.Add(deck);
                else rest.Add(deck);
            }

            owned.AddRange(rest);
            return owned;
        }

        /// <summary>
        /// Разыгрывает содержимое карточного набора. Скин выпадает редко и только тот,
        /// которого ещё нет в альбоме; в остальных случаях приходит колода события.
        /// </summary>
        /// <summary>
        /// Открывает сразу все колоды события. Уже открытые пропускаем, иначе
        /// клиент показал бы пустую выдачу.
        /// </summary>
        private void GiveAllCollabCards(DeliveryUnit unit)
        {
            if (UnlockedRogueliteDecks == null) UnlockedRogueliteDecks = new List<int>();

            foreach (int card in CollabDeckCards)
            {
                if (UnlockedRogueliteDecks.Contains(card)) continue;

                UnlockedRogueliteDecks.Add(card);

                GatchaDrop drop = new GatchaDrop(4);
                drop.Count = 1;
                drop.DataGlobalId = card;
                drop.CardGlobalId = card;
                unit.AddDrop(drop);
            }
        }

        private const int COLLAB_DUPLICATE_GOLD = 100;

        private void RollCollabCardPack(DeliveryUnit unit, Random rand)
        {
            int skin = 0;
            foreach (int candidate in CollabAlbumSkinIds)
            {
                if (UnlockedSkins != null
                    && UnlockedSkins.Contains(GlobalId.CreateGlobalId(29, candidate))) continue;
                skin = candidate;
                break;
            }

            List<int> missing = GetMissingDeckCards();

            // Скин — редкий приз. Если колод больше не осталось, набор отдаёт скин
            // без броска, иначе покупка вернула бы пустоту.
            bool giveSkin = skin != 0 && (missing.Count == 0 || rand.Next(100) < COLLAB_PACK_SKIN_CHANCE);

            if (giveSkin)
            {
                SkinData skinData = DataTables.Get(DataType.Skin)?.GetDataWithId<SkinData>(skin);
                if (skinData != null)
                {
                    GatchaDrop drop = new GatchaDrop(9);
                    drop.SkinGlobalId = GlobalId.CreateGlobalId(29, skin);
                    drop.Count = 1;
                    unit.AddDrop(drop);
                    if (UnlockedSkins != null)
                        UnlockedSkins.Add(GlobalId.CreateGlobalId(29, skin));
                    return;
                }
            }

            int card;
            if (missing.Count > 0)
            {
                // Первые в списке — колоды купленных бойцов, поэтому берём из головы
                // со смещением, а не строго случайно по всему массиву.
                int span = missing.Count < 8 ? missing.Count : 8;
                card = missing[rand.Next(span)];
            }
            else
            {
                // Все колоды уже собраны: вместо дубликата — 100 монет.
                GatchaDrop goldDrop = new GatchaDrop(7);
                goldDrop.Count = COLLAB_DUPLICATE_GOLD;
                unit.AddDrop(goldDrop);
                return;
            }

            // Записываем сразу, чтобы в одном наборе колода не выпала дважды.
            AddRogueliteDeckCopy(card);

            // Дроп типа 4 — карта. GatchaDropOverviewItem::setupDrop в этой ветке
            // отдельных клипов для MetaType 12 не имеет: берётся gatcha_summary_
            // brawlerstarpower и ItemIcon(9), а боец рисуется через getTargetCharacter
            // под проверкой на ноль. IconExportName тут не читается вовсе — он нужен
            // только ветке MetaType 11 (Surfers), поэтому пустая иконка колод не мешает.
            GatchaDrop cardDrop = new GatchaDrop(4);
            cardDrop.Count = 1;
            cardDrop.DataGlobalId = card;
            cardDrop.CardGlobalId = card;
            unit.AddDrop(cardDrop);
        }

        /// <summary>Контейнеры карточек коллаба, строки 8..12 таблицы 80.</summary>
        private static bool IsCollabCardContainer(int globalId)
            => globalId >= COLLAB_DROP_RARE && globalId <= COLLAB_DROP_LEGENDARY;

        private readonly struct CardPack
        {
            public readonly string Character;
            public readonly int Cost;
            public readonly int Cover;
            public readonly string Title;

            /// <summary>Сколько карточек отдаёт набор за одну покупку.</summary>
            public readonly int Cards;

            public CardPack(string character, int cost, int cover, string title, int cards)
            {
                Character = character; Cost = cost; Cover = cover; Title = title; Cards = cards;
            }
        }

        /// <summary>
        /// Семь наборов — столько же, сколько у коллаба Stranger в collabs.csv
        /// перечислено стилей card_pack и обложек в CoversIds.
        ///
        /// На витрине лежит колода бойца, а не скин. Пока там был скин, клиент и
        /// рисовал скин, а на уже открытых писал «есть». Имя бойца берём из Target
        /// строки *_roguelite_deck, поэтому набор привязан к персонажу, а не к
        /// номеру строки.
        /// </summary>
        private static readonly CardPack[] CollabCardPacks =
        {
            new CardPack("DragonRider",    0, 5, "Драко",  6),
            new CardPack("SoulCollector",150, 4, "Гас",    6),
            new CardPack("Painter",      300, 4, "Берри", 12),
            new CardPack("Shaman",       450, 6, "Нита",  12),
            new CardPack("Morningstar",  600, 6, "Луми",  20),
            new CardPack("ShotgunGirl",  900, 6, "Шелли", 20),
            new CardPack("Gunslinger",  1500, 3, "Кольт", 20),
        };

        /// <summary>
        /// Отдельный набор, который открывает СРАЗУ ВСЕ колоды события.
        /// Метка покупки своя, чтобы его нельзя было спутать с обычными наборами.
        /// </summary>
        private const string CollabAllCardsClaim = "collab_pack_all";
        private const int CollabAllCardsCost = 9999;

        /// <summary>Бесплатная выдача валюты события.</summary>
        private const string CollabFreeCurrencyClaim = "collab_free_currency";
        private const int CollabFreeCurrencyAmount = 999999;



        /// <summary>
        /// Карточные наборы витрины события. Клиент открывает её как NightMarketShopPopup
        /// и берёт туда только предложения с контекстом 7 (Shop::getBundleShopItemContext
        /// переводит 7 в 3, а collectValidBundles фильтрует именно по тройке).
        /// Цена идёт в валюте события: код 8 — та самая ветка
        /// setCollabEventCurrencyPriceWithDiscount в OfferBundleItem::setPrice.
        ///
        /// Тип товара — Item (5). GemOfferItem в этой ветке зовёт getItem и, если
        /// MetaType не 8, уходит на setupHeroIcon, который рисует бойца колоды.
        /// MetaType 8 — это коллаб Coral с иконками item_sb_*, поэтому ветка
        /// TID_SB_ITEM_NAME нам не подходит и не нужна.
        /// </summary>
        /// <summary>Строка CHAIN_A в shop_panel_layouts.csv, класс таблицы 69.</summary>
        private const int ShopPanelLayoutClassId = 69;
        private const int ChainOfferLayoutRow = 8;

        /// <summary>Сколько звеньев в цепочке и сколько валюты даёт каждое.</summary>
        private const int CollabChainLinks = 5;
        private const int CollabChainAmount = 1000;

        /// <summary>С какого дня цепочка начала открываться.</summary>
        private static readonly DateTime CollabChainStart = new DateTime(2026, 9, 20, 0, 0, 0, DateTimeKind.Utc);

        /// <summary>
        /// Цепочка акций события — она же ShopChainOffer у клиента.
        ///
        /// Механизм официальный, снят с клиента: несколько предложений считаются
        /// одной цепочкой, когда у них ОДНА И ТА ЖЕ строка ShopPanelLayout и у
        /// этой строки LayoutType = CHAIN_OFFER (LogicOfferBundle::isChainOffer
        /// 0x1004f7258 и isInSameChainAs 0x1004f75d8 сравнивают ровно указатель
        /// на строку и её поле +84). Порядок звеньев берётся из поля +136
        /// предложения (getSortedChainOfferBundles 0x1004c2cdc).
        ///
        /// Ещё одно условие: ChainOfferPopup::getShownBundles показывает только
        /// предложения с контекстом витрины 0, то есть цепочка живёт в обычном
        /// магазине, а не внутри витрины события.
        ///
        /// Звенья открываются по одному в сутки, как в игре: там такое звено
        /// даёт 80 единиц валюты события, здесь — CollabChainAmount.
        /// </summary>
        private void GenerateCollabOfferChain(DateTime start, DateTime end)
        {
            // Цепочку отдаём целиком: из одного звена клиент цепочку не собирает,
            // он группирует предложения через isInSameChainAs.
            //
            // Порядок и блокировку делает САМ клиент, по официальной схеме:
            // validateChainOfferBundlePurchaseRequirement (0x1003cdb78) при
            // ChainRequirement = 0 разрешает звено с номером 1 и требует, чтобы у
            // звена N было забрано звено N-1. Поэтому номера идут с единицы, а
            // никаких своих блокировок ставить не нужно — прошлая попытка
            // помечала звенья «в обработке» (+192), и клиент отвечал кодом 6.
            int shown = 0;

            for (int i = 0; i < CollabChainLinks; i++)
            {
                GenerateOffer(
                    start, end,
                    /* Count */ CollabChainAmount,
                    /* BrawlerID */ 0,
                    /* Extra */ 0,
                    CollabCardItem,
                    /* Cost */ 0,
                    /* OldCost */ 0,
                    /* Currency */ 6,
                    /* Claim */ "collab_chain_" + i,
                    /* Title */ "TID_COLLAB_13",
                    /* BGR */ null,
                    /* IsTID */ 1,
                    /* DailyOfferType */ 0,
                    /* OneTimeOffer */ true,
                    /* LoadOnStartup */ false,
                    /* Processed */ false,
                    /* TypeBenefit */ 0,
                    /* Benefit */ 0,
                    /* panelClass */ ShopPanelLayoutClassId,
                    /* panelType */ ChainOfferLayoutRow,
                    /* styleClass */ 0,
                    /* styleType */ 0,
                    /* контекст витрины */ 0,
                    /* обложка */ 0,
                    /* товар */ 0,
                    /* номер звена */ i + 1,
                    /* требование цепочки */ 0);

                shown++;
            }

            Server.Logger.Print($"[chainOffer] цепочка акций: звеньев {shown}, "
                + $"макет {ShopPanelLayoutClassId}:{ChainOfferLayoutRow}, "
                + $"по {CollabChainAmount} валюты, порядок открытия ведёт клиент");
        }

        private void GenerateCollabCardPacks(DateTime start, DateTime end)
        {
            const int collabCurrencyCode = 8;
            const int eventShopContext = 7;

            for (int i = 0; i < CollabCardPacks.Length; i++)
            {
                CardPack pack = CollabCardPacks[i];

                int deckCard = GetDeckCardForCharacter(pack.Character);
                if (deckCard == 0) continue;

                GenerateOffer(
                    start, end,
                    /* Count */ pack.Cards,
                    /* BrawlerID */ 999,
                    /* Extra */ 0,
                    ShopItem.Item,
                    /* Cost */ pack.Cost,
                    /* OldCost */ 0,
                    /* Currency */ collabCurrencyCode,
                    /* Claim */ "collab_pack_" + i,
                    /* Title */ pack.Title,
                    /* BGR */ "offer_bgr_strangerthings",
                    0, 0, /* OneTimeOffer */ false,
                    false, false, 0,
                    0, 0, 0, ShopStyleSetClassId, CardPackStyleSetId,
                    eventShopContext,
                    pack.Cover,
                    /* колода на витрине */ deckCard);
            }

            // Набор «все карточки». На витрине показываем колоду первого бойца
            // списка — товар всё равно разыгрывается на сервере по метке покупки.
            int anyDeck = GetDeckCardForCharacter(CollabCardPacks[0].Character);
            if (anyDeck != 0)
            {
                GenerateOffer(
                    start, end,
                    /* Count */ CollabDeckCards.Length,
                    /* BrawlerID */ 999,
                    /* Extra */ 0,
                    ShopItem.Item,
                    /* Cost */ CollabAllCardsCost,
                    /* OldCost */ 0,
                    /* Currency */ collabCurrencyCode,
                    /* Claim */ CollabAllCardsClaim,
                    /* Title */ "Все карточки",
                    /* BGR */ "offer_bgr_strangerthings",
                    0, 0, /* OneTimeOffer */ false,
                    false, false, 0,
                    0, 0, 0, ShopStyleSetClassId, CardPackStyleSetId,
                    eventShopContext,
                    CollabCardPacks[0].Cover,
                    anyDeck);
            }
        }

        /// <summary>
        /// Цепочка «Джи Джи ранний доступ»: 1 ящик за 49, 3 за 129 (было 149), 10 за 299 (было 349).
        /// Звенья открываются по очереди (ChainOrder/ChainRequirement 0), покупка — PurchaseGigiBoxes.
        /// </summary>
        private void GenerateGigiEarlyAccessOffers()
        {
            var container = RandomReward.RandomRewardManager.GetContainer("DaredevilBrawlerBox");
            if (container == null) return;
            DateTime start = DateTime.UtcNow.AddDays(-1), end = new DateTime(2030, 1, 1);
            int[] counts = { 1, 3, 10 }, costs = { 49, 129, 299 }, olds = { 0, 149, 349 };
            // Три обычные акции сразу (каждая — один раз).
            // (Режим цепочки клиента требует макет CHAIN_OFFER — без него акции не видно.)
            for (int i = 0; i < counts.Length; i++)
            {
                string claim = "gigi_early_" + (i + 1);
                if (OffersClaimed != null && OffersClaimed.Contains(claim)) continue;
                GenerateOffer(start, end, counts[i], 999, container.GetGlobalId(), ShopItem.BrawlerBox,
                    costs[i], olds[i], 0, claim, "Джи Джи ранний доступ", "bgr_gigi",
                    0, 0, true, false, false, 0, 0, 0, 0, 0, 0);
                Server.Logger.Print($"[GigiShop] акция {claim}: {counts[i]} ящ. за {costs[i]}");
            }
        }

        private void GenerateBoxOffers()
        {
            DataTable table = DataTables.Get(DataType.RandomRewardContainer);
            if (table == null) return;

            DateTime start = new DateTime(2024, 5, 9, 12, 0, 0);
            DateTime end = new DateTime(2030, 1, 1, 0, 0, 0);

            foreach (RandomRewardContainerData container in table.GetDatas())
            {
                if (container == null || string.IsNullOrEmpty(container.Name)) continue;
                if (container.Name == "DaredevilBrawlerBox") continue;
                if (string.IsNullOrEmpty(container.TID) && string.IsNullOrEmpty(container.VisualType)) continue;
                if (container.VisualType == "PIGGYBANK") continue;

                ShopItem type = GetBoxOfferType(container);

                GenerateOffer(
                    start, end,
                    1, 999, container.GetGlobalId(), type,
                    0, 0, 0,
                    "debug", container.Name, GetBoxOfferBackground(container),
                    0, 0, false,
                    false, false, 0,
                    0, 0, 0, 0, 0
                );
            }
        }

        private static ShopItem GetBoxOfferType(RandomRewardContainerData container)
        {
            switch (container.GroupType)
            {
                case "SEASON_BOX": return ShopItem.TrophySeasonBox;
                case "BRAWLER_BOX": return ShopItem.BrawlerBox;
                case "GRAFFITI_BOX": return ShopItem.GraffitiBox;
                case "TRICK_BOX": return ShopItem.TrickBox;
                case "MECH_BOX": return ShopItem.MechBox;
            }

            if (container.Name == "AngelicStar") return ShopItem.AngelicStar;
            if (container.Name == "DemonicStar") return ShopItem.DemonicStar;
            if (container.IsOverchargeDraw) return ShopItem.OverchargeStarrDrop;

            switch (container.VisualType)
            {
                case "CHEST": return ShopItem.MegaBox2;
                case "SPLITTER": return ShopItem.RandomSushiDrop;
                case "SLASHING":
                    return container.Name.EndsWith("PresentDrop")
                        ? ShopItem.RandomPresentDrop
                        : ShopItem.RandomCollabDrop;
            }

            return ShopItem.StarrDropContainer;
        }

        private static string GetBoxOfferBackground(RandomRewardContainerData container)
        {
            switch (container.GroupType)
            {
                case "SEASON_BOX": return "";
                case "MECH_BOX": return "offer_bgr_mecha";
            }

            switch (container.Rarity)
            {
                case 1: return "offer_rarity_rare";
                case 2: return "offer_rarity_super_rare";
                case 3: return "offer_rarity_epic";
                case 4: return "offer_rarity_mythic";
                case 5: return "offer_rarity_legendary";
            }

            return "";
        }

        private void RotateShopContent(DateTime time, bool isNewAcc)        {
            if (true || isNewAcc)
            {
            }
        }

           public void Encode(ByteStream stream) 
        {                           
            stream.WriteVInt(1762536979);
            stream.WriteVInt(382336);

            stream.WriteVInt(0);
            stream.WriteVInt(0);

            stream.WriteVInt(HomeMode.Avatar.Trophies); // Trophies
            stream.WriteVInt(HomeMode.Avatar.HighestTrophies); // Highest Trophies
            stream.WriteVInt(HomeMode.Avatar.HighestTrophies); // Highest Trophies
            stream.WriteVInt(HomeMode.Home.TrophyRoadProgress + 50); // Trophy Road Tier
            stream.WriteVInt(0); // Experience Level  --DELETE V48

            ByteStreamHelper.WriteDataReference(stream, SafeThumbnailId);
            ByteStreamHelper.WriteDataReference(stream, SafeNameColorId);
    
            stream.WriteVInt(0);

            // Выбранные скины: у имеющихся бойцов и у тех, кого нет (скин без бойца).
            var selectedSkins = new System.Collections.Generic.List<int>();
            var ownedCharacters = new System.Collections.Generic.HashSet<int>();
            foreach (Hero hero in HomeMode.Avatar.Heroes)
            {
                ownedCharacters.Add(hero.CharacterId);
                if (hero.SelectedSkinId != 0) selectedSkins.Add(hero.SelectedSkinId);
            }
            if (HomeMode.Avatar.SelectedSkinsWithoutHero != null)
            {
                foreach (var pair in HomeMode.Avatar.SelectedSkinsWithoutHero)
                {
                    if (!ownedCharacters.Contains(pair.Key) && pair.Value != 0) selectedSkins.Add(pair.Value);
                }
            }
            stream.WriteVInt(selectedSkins.Count); // Selected Skins
            foreach (int skin in selectedSkins)
                ByteStreamHelper.WriteDataReference(stream, GlobalId.CreateGlobalId(29, skin));
            stream.WriteVInt(0);
            stream.WriteVInt(0);

            stream.WriteVInt(UnlockedSkins.Count); // Played game modes
            foreach (int s in UnlockedSkins)
            {
                ByteStreamHelper.WriteDataReference(stream, s);
            }
       
            stream.WriteVInt(0);
            stream.WriteVInt(0);

            stream.WriteVInt(0);
            stream.WriteVInt(HomeMode.Avatar.HighestTrophies); // Highest Trophies
            stream.WriteVInt(1337); // Tokens Used In Battles
            stream.WriteVInt(2); // Control Mode
            stream.WriteBoolean(true); // Battle Hints
            stream.WriteVInt(TokenDoubler); // Tokens Doubler
            stream.WriteVInt(5000); // BraWl Pass Season Timer
            
            DateTime TropCurrentTime = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, TimeZoneInfo.FindSystemTimeZoneById("Russian Standard Time"));
            // Было 20.04.2026: дата прошла, клиент получал отрицательный таймер сезона
            // и вылетал в лобби. Держим конец сезона всегда через 30 дней.
            DateTime TropTargetDateTime = TropCurrentTime.AddDays(30);
            TimeSpan TropTimeDifference = TropTargetDateTime - TropCurrentTime;
            int TropTimeSeconds = (int)TropTimeDifference.TotalSeconds; 
            stream.WriteVInt(TropTimeSeconds);
            
            stream.WriteVInt(5000); // time hui
            
            DateTime BPCurrentTime = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, TimeZoneInfo.FindSystemTimeZoneById("Russian Standard Time"));
            // Было 20.04.2026: дата прошла, клиент получал отрицательный таймер сезона
            // и вылетал в лобби. Держим конец сезона всегда через 30 дней.
            DateTime BPTargetDateTime = BPCurrentTime.AddDays(30);
            TimeSpan BPTimeDifference = BPTargetDateTime - BPCurrentTime;
            int BPTimeSeconds = (int)BPTimeDifference.TotalSeconds; 
            stream.WriteVInt(BPTimeSeconds);

            stream.WriteVInt(200);
            stream.WriteVInt(200);

            stream.WriteVInt(5); // Forced Drops
            {
                stream.WriteVInt(93);
                stream.WriteVInt(206);
                stream.WriteVInt(456);
                stream.WriteVInt(1001);
                stream.WriteVInt(2264);
            }

            stream.WriteBoolean(true);

            // Метки «новое» у трёх полок магазина (+236, +240, +244 у LogicDailyData).
            // Раньше тут стояли жёсткие двойки, то есть «всё уже просмотрено», и
            // команда 515 их погасить не могла. Теперь состояние хранится.
            stream.WriteVInt(TokenDoublerTickerState); // Token Doubler NeW Tag State
            stream.WriteVInt(EventTicketsTickerState); // Event Tickets NeW Tag State
            stream.WriteVInt(CoinPacksTickerState);    // Coin Packs NeW Tag State
            stream.WriteVInt(HomeMode.Avatar.GetNameChangeCost());
            stream.WriteVInt(HomeMode.Avatar.GetNameChangeTimer());
            stream.WriteVInt(0);

            stream.WriteVInt(OfferBundles.Count); // Shop offers at 0x78e0c4
            for (int i = 0; i < OfferBundles.Count; i++)
            {
                OfferBundle offerBundle = OfferBundles[i];

                // Клиент адресует предложение по его идентификатору (+72), а не по
                // номеру: с нулём у всех бандлов команда 515 гасила метку у первого
                // попавшегося. Нумеруем с единицы, ноль оставляем «без адреса».
                offerBundle.OfferId = i + 1;

                offerBundle.Encode(stream);
            }

            stream.WriteVInt(0); // Quests Battle XP
            stream.WriteVInt(0); // Time Left Until XP Reset
            
            stream.WriteVInt(-1);
            stream.WriteVInt(1); 
            {
                stream.WriteVInt(30);
            }

            stream.WriteByte(3);
            {
                ByteStreamHelper.WriteDataReference(stream, CharacterIds[0]);
                ByteStreamHelper.WriteDataReference(stream, CharacterIds[1]);
                ByteStreamHelper.WriteDataReference(stream, CharacterIds[2]);
            }
         
            stream.WriteString("RU");
            stream.WriteString("FidBon");

            stream.WriteVInt(7);
            {
                stream.WriteDataReference(10002, 61);
                stream.WriteDataReference(198666, 62);
                stream.WriteDataReference(2147483647, 28);  // delete ibanaua animation wins
                stream.WriteDataReference(1, 52);
                stream.WriteDataReference(1, 22);
                stream.WriteDataReference(100, 41);
                stream.WriteDataReference(10000000, 10);
            }

            stream.WriteVInt(0);
       
            stream.WriteVInt(1); // count brawl pass seasons
            for (int i = 0; i < 1; i++)
            {
                stream.WriteVInt(43);
                stream.WriteVInt(BrawlPassTokens);
                stream.WriteBoolean(HasPremiumPass);

                stream.WriteVInt(131);
                stream.WriteBoolean(false);

                if (stream.WriteBoolean(true)) // Track 9
                {
                    stream.WriteLongLong128(PremiumPassProgress);
                }
                if (stream.WriteBoolean(true)) // Track 10
                {
                    stream.WriteLongLong128(BrawlPassProgress);
                }
                stream.WriteBoolean(HasPremiumPassPlus); // BrawlPassPlus
                if (stream.WriteBoolean(true)) // Track ?
                {
                    stream.WriteLongLong128(BrawlPassPlusProgress);
                }
            }      

            if (stream.WriteBoolean(true))
            {                 
                stream.WriteVInt(questsList.Count);
                {
                     foreach (Quest quests in questsList)
                    {
                        quests.encode(stream);
                    } 
                }
                stream.WriteVInt(0);
                stream.WriteVInt(0);
                stream.WriteVInt(-1);//mega quest ?
                stream.WriteVInt(0);
            }
            
            stream.WriteBoolean(true); // item
            stream.WriteVInt(UnlockedEmotes.Count + UnlockedTituls.Count + UnlockedThumbnails.Count+ UnlockedFrames.Count); // count of cosmetic
            foreach (int Emote in UnlockedEmotes)
            {
                ByteStreamHelper.WriteDataReference(stream, Emote);
                stream.WriteVInt(1);
                stream.WriteVInt(Emote);
                stream.WriteVInt(4);
            }
            foreach (int Thumbnail in UnlockedThumbnails)
            {
                ByteStreamHelper.WriteDataReference(stream, Thumbnail);
                stream.WriteVInt(0);
            }
            foreach (int Titul in UnlockedTituls)
            {
                ByteStreamHelper.WriteDataReference(stream, Titul);
                stream.WriteVInt(0);
            }
            foreach (int Frame in  UnlockedFrames)
            {
                ByteStreamHelper.WriteDataReference(stream, Frame);
                stream.WriteVInt(0);
            }
        
            stream.WriteBoolean(true);
            {
                stream.WriteVInt(RankedSeason);    // 1 - новый сезон плашка типа да 
                stream.WriteVInt(HashCore.Laser.Logic.Home.Structures.Profile.RankedPointsOf(HomeMode?.Avatar));  // очки ранкеда — те же, что в профиле
                stream.WriteVInt(22);  //rank -- v34-v64(ахуеть 30 версий)
                stream.WriteVInt(1);  //по русски нах
                stream.WriteVInt(0);
                stream.WriteVInt(0);
                
                stream.WriteVInt(1);
                stream.WriteVInt(1);
                stream.WriteVInt(1);
                stream.WriteVInt(1);
                stream.WriteVInt(1);
                stream.WriteVInt(511);
                stream.WriteVInt(1);

                stream.WriteBoolean(true);
                {
                    stream.WriteBoolean(false);
                    stream.WriteVInt(0);
                    stream.WriteBoolean(false);
                }
            }
      
            stream.WriteInt(0);
            stream.WriteVInt(0);
            // Клиент читает здесь НЕ dataRef: второй VInt утекает в следующее поле, и любое
            // значение кроме 0 (то есть любой боец кроме Шелли) рвёт остаток OHD -> вылет на 93%.
            // Пока позиция любимого бойца в OHD не найдена, пишем фиксированную пару 16/0.
            // Сам FavouriteCharacter хранится и уходит в профиль через Profile.Hero.
            ByteStreamHelper.WriteDataReference(stream, GlobalId.CreateGlobalId(16, 0));

            stream.WriteBoolean(false); // LogicRewards::encode
            stream.WriteVInt(-1);
            stream.WriteVInt(1337);
            stream.WriteVInt(832099);
            stream.WriteVInt(1616899);
            stream.WriteVInt(10659101);
            
            DateTime RankedCurrentTime = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, TimeZoneInfo.FindSystemTimeZoneById("Russian Standard Time"));
            DateTime RankedTargetDateTime = new DateTime(2036, 4, 20, 0, 0, 0);
            TimeSpan RankedTimeDifference = RankedTargetDateTime - RankedCurrentTime;
            int RankedSeasonTime = (int)RankedTimeDifference.TotalSeconds; 
            stream.WriteVInt(RankedSeasonTime);

            // Список сезонов рангового пропуска. Раскладка записи снята с клиента
            // (CompetitivePassSeasonData::decode 0x1004ba358 и decodeCustom 0x1004ba4c0):
            //   bool +40
            //   vint +36  — сколько раз забран хвост сезона
            //   vint +0   — НОМЕР СЕЗОНА, по нему клиент ищет запись
            //   vint +8
            //   bool +32  — куплен ли премиум (без него трек 1 не отдаётся)
            //   vint +4   — очки пропуска
            //   bool + LogicBitList(128) — забранные ступени трека 1 (+16)
            //   bool + LogicBitList(128) — забранные ступени трека 2 (+24)
            // Раньше оба списка уходили пустыми, поэтому клиент после каждого входа
            // считал все ступени незабранными, а счётчик хвоста стоял в 100000 и
            // хвост нельзя было забрать вообще: клиент пускает, только пока
            // заработано больше, чем забрано.
            stream.WriteVInt(1);
            {
                stream.WriteBoolean(true);
                stream.WriteVInt(GetRankedPassTailClaimed(CompetitivePassSeason));
                stream.WriteVInt(CompetitivePassSeason);
                stream.WriteVInt(0);
                stream.WriteBoolean(true); // премиум куплен
                stream.WriteVInt(100000000);  // очки пропуска
                WriteRankedPassClaimedBits(stream, 1);
                WriteRankedPassClaimedBits(stream, 2);
            }
       
            stream.WriteVInt(0);
            stream.WriteDataReference(2, 462);
            stream.WriteDataReference(2, 460);
            stream.WriteDataReference(2, 464);
            stream.WriteDataReference(2, 466);

            stream.WriteBoolean(true);
            {
            stream.WriteVInt(22);
            stream.WriteVInt(22);
            stream.WriteVInt(22);
            }

            stream.WriteDataReference(16,100);

            stream.WriteVInt(TrophyWorldProgress);

        stream.WriteBoolean(false);
            stream.WriteBoolean(false);

            int confStart = stream.GetOffset();
            stream.WriteVInt(2019049);
            // Это перечень слотов, по которым клиент вообще спрашивает событие:
            // SelectLocationPopup::createEventItems идёт по этому списку и на каждый
            // номер зовёт getActiveEventForSlot. Чего нет в списке — того для лобби
            // не существует. Раньше список обрывался на 43, поэтому слоты раша,
            // боссов и рогалика (44, 45, 53, 54) клиент даже не запрашивал.
            ByteStreamHelper.WriteIntList(stream, Enumerable.Range(1, 54).ToList());

                stream.WriteVInt(Events.Length );
            foreach (EventData e in Events)
            {
                // Личный прогресс испытания — на копию события этого игрока.
                if (e.Challenge != null) Challenges.ChallengeManager.ApplyToEvent(this, e);
                
                switch (e.Slot)
                {
                    case 36:
                    case 38:
                        e.EncodeCollabSlot(stream);
                        break;
                    default:
                        // Было e.Encode(stream) — та версия писалась под старую ревизию
                        // протокола и расходится с EventData::decode начиная с +216
                        // (LogicAlliancePiggyBankEvent), плюс не дописывает 6 хвостовых
                        // булей. Откатить = вернуть e.Encode(stream).
                        e.EncodeCanonical(stream);
                        break;
                }
            }
            stream.WriteVInt(0); 

            stream.WriteVInt(0);

            ByteStreamHelper.WriteIntList(stream, new List<int> { 20, 35, 75, 140,290,480,800,1250,1875,2800});
            ByteStreamHelper.WriteIntList(stream, new List<int> { 30,80,170,360 });
            ByteStreamHelper.WriteIntList(stream, new List<int> { 300,880,2040,4680 });
            
            ReleaseEntryData.encode(stream);

            // Список IntValueEntry. Разгадка прошлых поломок фона: IntValueEntry
            // читает СНАЧАЛА значение (+4), и только потом ключ (+0)
            // (IntValueEntry::IntValueEntry, 0x1004bd700). Поэтому пара 41000152/1 —
            // это ключ 1 со значением 41000152, то есть тема меню Strangerthings.
            // Её нельзя убирать: без неё фон сбрасывается. Остальные ключи просто
            // дописываются следом тем же порядком «значение, ключ».
            List<KeyValuePair<int, int>> confFlags = new List<KeyValuePair<int, int>>();
            if (ConfFlags != null)
            {
                foreach (KeyValuePair<int, int> flag in ConfFlags)
                {
                    if (ConfIntValues.ContainsKey(flag.Key)) continue;
                    confFlags.Add(flag);
                }
            }
            // Ключи испытания (28 — жизней, 10039 — жизней за докупку), если их
            // не задали вручную.
            foreach (KeyValuePair<int, int> conf in Challenges.ChallengeManager.GetConfValues())
            {
                if (ConfIntValues.ContainsKey(conf.Key)) continue;
                if (confFlags.Exists(f => f.Key == conf.Key)) continue;
                confFlags.Add(conf);
            }

            stream.WriteVInt(1 + ConfIntValues.Count + confFlags.Count);
            {
                // Тема лобби. Значение — строка themes.csv, ключ 1. Здесь была
                // зашита 152 (Strangerthings), поэтому в лобби висел фон «Очень
                // странных дел», что бы ни стояло в настройке темы. Берём её же.
                stream.WriteVInt(41000000 + MenuTheme.ActiveThemeId);
                stream.WriteVInt(1);

                foreach (KeyValuePair<int, int> conf in ConfIntValues)
                {
                    stream.WriteVInt(conf.Value);
                    stream.WriteVInt(conf.Key);
                }

                foreach (KeyValuePair<int, int> flag in confFlags)
                {
                    stream.WriteVInt(flag.Value);
                    stream.WriteVInt(flag.Key);
                }
            }
                
            stream.WriteVInt(0);  //таймед валуй чета там 
            stream.WriteVInt(0);
            stream.WriteVInt(0);
            stream.WriteVInt(0);
            stream.WriteVInt(0);
            stream.WriteVInt(0);
            stream.WriteVInt(1); //помоему календарики 

            stream.WriteVInt(1);
            stream.WriteVInt(0);
       
            stream.WriteVInt(0);
            stream.WriteVInt(0);
        
            stream.WriteBoolean(true);
            {
               stream.WriteVInt(1);
               stream.WriteVInt(3);
                {
                    stream.WriteString(MegaQuestHash);
                    stream.WriteString(MegaQuestFile);
                }

                // Ссылка на строку chronos_asset_ids.csv. MegaQuestSlot1SC лежит
                // девятой, класс таблицы 98 — по ней QuestUtil и ищет файл цепочки.
                stream.WriteDataReference(MEGA_QUEST_ASSET_CLASS, MEGA_QUEST_FIRST_ROW);

                // ChronosAssetListEvent::decode: +24 номер, +4 конец, +0 начало (секунды).
                // findActiveChronosAssetEntry берёт событие только при начало <= сейчас < конец;
                // с концом 0 файл квестов был «неактивен», и клиент ставил встроенный фон.
                stream.WriteVInt(0);
                stream.WriteVInt(2000000000);
                stream.WriteVInt(0);
            }
             
            stream.WriteVInt(0);

            ByteStreamHelper.WriteIntList(stream, new List<int> { 0, 29, 79, 169,349,699 });
            ByteStreamHelper.WriteIntList(stream, new List<int> { 0, 160, 450, 500,1500,4500 });
            ByteStreamHelper.WriteIntList(stream, new List<int> { 0, 100, 400, 1000,3000 });

            stream.WriteVInt(1);
            {
                stream.WriteVInt(1);
                stream.WriteString("https://t.me/scteamproject2");
                if (stream.WriteBoolean(true)) {
                    stream.WriteString("https://t.me/scteamproject2");
                    stream.WriteVInt(1);
                }
            }
            stream.WriteVInt(0);
            stream.WriteVInt(0);

            // Последнее поле LogicConf — список дорожек ежедневных побед
            // (LogicConfData::decode, хвост на 0x1004bf850). Раньше его тут не было,
            // и клиент забирал счётчик из первого байта следующего поля: лишний байт
            // компенсировался тем, что дальше шло на байт больше, чем нужно.
            // Отсюда и «декодер читает на байт больше» в пробнике, и поломка дома,
            // когда счётчик дописывали, ничего не убрав.
            WriteDailyWinTracks(stream);

        //LogicConf end
            RunConfProbe(stream, confStart);

            // LogicClientHome +16, восемь байт: клиент читает его слотом 37 таблицы
            // ByteStream (readLong). Раньше эти восемь байт набирались из
            // WriteInt(0) без первого байта и четырёх случайных VInt (15, -53, 2986) —
            // сумма сходилась, значения были мусором.
            stream.WriteLong(0);
        
            // Входящие: VInt счётчик и письма (тип + тело), см. NotificationFactory.
            // Раньше здесь вручную писалось одно фиктивное письмо 68 при первом
            // входе, а настоящих писем сервер не хранил вовсе. Письмо первого входа
            // сохранено, но теперь оно лежит во входящих как обычное.
            if (NotificationFactory == null) NotificationFactory = new NotificationFactory();
            if (!IsWelcomeNotificationSeen)
            {
                NotificationFactory.Add(new RankedSeasonEndNotification
                {
                    Text = "Кормим",
                    Value52 = 2,
                    Value56 = 7,
                    Value60 = 22,
                    Value64 = 22,
                    Value68 = 22,
                    Value72 = 22
                });
                IsWelcomeNotificationSeen = true;
            }
            NotificationFactory.Encode(stream);

            stream.WriteVInt(-1);
            stream.WriteBoolean(false);
            stream.WriteVInt(1);
            {
                GatchaDrop gatchaDrop = new GatchaDrop(7);
                gatchaDrop.Count = 1; 
                gatchaDrop.Encode(stream);
            }   

            stream.WriteVInt(0);   
      
            stream.WriteVInt(0);   
        
            stream.WriteBoolean(false);  
    
            stream.WriteVInt(HomeMode.Avatar.Heroes.Count);//Gears
            foreach (Hero hero in HomeMode.Avatar.Heroes)
            {
                ByteStreamHelper.WriteDataReference(stream, hero.CharacterId);
                List<GearData> gearDatas = new List<GearData>();
                foreach (GearData gearData in DataTables.Get(DataType.Gear).GetDatas())
                {
                    if (gearData.Rarity == "RareGear" || gearData.ExtraHerosAvailableTo.Contains(DataTables.Get(DataType.Character).GetDataByGlobalId<CharacterData>(hero.CharacterId).Name)) gearDatas.Add(gearData);
                }
                stream.WriteVInt(0);
              
                stream.WriteVInt(2);
                stream.WriteDataReference(0);
                stream.WriteDataReference(0);
            }
            stream.WriteBoolean(true); // LogicBrawlerRecruitRoad
            Recruit.BrawlerRecruitRoad.Build(this).Encode(stream);

        stream.WriteVInt(0);  //delete maste
            
        DefaultBattleCard.Encode(stream);
           
        stream.WriteVInt(0);

        // Менеджер собираем ДО записи: если сборка сорвётся, мы отправим пустой,
        // а не оборвём поток на середине дома. Раньше любое исключение внутри
        // Build (а там были обращения к таблицам по индексу без проверки границ)
        // убивало отправку дома целиком, и клиент не получал вообще ничего.
        RandomReward.RandomRewardManager rewardManager;
        try
        {
            rewardManager = RandomReward.RandomRewardManager.Build(this);
        }
        catch (Exception exception)
        {
            Server.Logger.Warning($"[randomReward] менеджер собрать не вышло: "
                + $"{exception.GetType().Name}: {exception.Message}");
            rewardManager = new RandomReward.RandomRewardManager();
        }

        rewardManager.Encode(stream);

        stream.WriteBoolean(false); // LogicPlayerAlliancePiggyBankData

        if (stream.WriteBoolean(PlayerCollab != null)) // LogicPlayerCollabEventData (+232)
            PlayerCollab.Encode(stream);
        
        stream.WriteBoolean(false); // LogicPlayerSpecialEventData

        // LogicDataSeenStates::decode (0x1004c4918) — БЕЗУСЛОВНЫЙ, без boolean перед
        // ним: счётчик, затем на каждую запись ссылка и состояние
        // (LogicDataSeenStateEntry::decode 0x1004c453c).
        if (DataSeenStates == null || DataSeenStates.Count == 0)
        {
            stream.WriteVInt(0);
        }
        else
        {
            stream.WriteVInt(DataSeenStates.Count);
            foreach (KeyValuePair<int, int> seen in DataSeenStates)
            {
                ByteStreamHelper.WriteDataReference(stream, seen.Key);
                stream.WriteVInt(seen.Value);
            }
        }

        stream.WriteBoolean(false); // LogicPlayerContestEventData      (+272)
        stream.WriteBoolean(false); // LogicPlayerRecordsData           (+280)
        if (stream.WriteBoolean(true)) EncodeRushState(stream); // LogicPlayerSpecialRushEventData  (+288)

        if (stream.WriteBoolean(PlayerBrawlerEarlyAccess != null)) // LogicPlayerBrawlerEarlyAccessEventData (+296)
            PlayerBrawlerEarlyAccess.Encode(stream);
     
        // LogicPlayerSpecialEventData[] (+248): count, затем count × (bool + объект)
        stream.WriteVInt(0);

        // LogicPlayerRogueliteEventData[] (+304): count, затем count × (bool + объект).
        // Вот он, тот самый слот. Пустой список => vint 0, поведение как было.
        if (PlayerRoguelite == null || PlayerRoguelite.Count == 0)
        {
            stream.WriteVInt(0);
        }
        else
        {
            stream.WriteVInt(PlayerRoguelite.Count);
            foreach (PlayerRogueliteEventData run in PlayerRoguelite)
                if (stream.WriteBoolean(run != null))
                    run.Encode(stream);
        }
        }
        
        private static readonly Random _random = new Random();

        public void GiveRandomBrawlerTrophies(ClientAvatar avatar)
{
    if (avatar == null || avatar.Heroes == null || avatar.Heroes.Count == 0)
    {
        Console.WriteLine("[DEBUG] Отмена: Аватар пустой или нет героев.");
        return;
    }

    Random rnd = new Random();
    int randomIndex = rnd.Next(avatar.Heroes.Count);
    var hero = avatar.Heroes[randomIndex];

    Console.WriteLine($"[DEBUG] Добавляем кубки бойцу {hero.CharacterId}. Было: {hero.Trophies}");

    hero.Trophies += 500;
    hero.HighestTrophies += 500;
    
    avatar.RefreshHighestTrophies();

    Console.WriteLine($"[DEBUG] Успех! Стало: {hero.Trophies}");
}

private ShopItem MapRewardToShopItem(string type)
{
    return type switch
    {
        "PowerPoints" => ShopItem.PowerPoints,
        "Coins" => ShopItem.Coin,
        "Hero" => ShopItem.Brawler,
        "Credits" => ShopItem.Bling,
        "RandomStarrDrop" => ShopItem.RandomSushiDrop,
        _ => ShopItem.Item
    };
}

    }
}
