        public void AddRogueliteDeckCopy(int deckId)
        {
            UnlockedRogueliteDecks ??= new List<int>();
            if (!UnlockedRogueliteDecks.Contains(deckId)) UnlockedRogueliteDecks.Add(deckId);
        }
