        // Special Rush (слот 44): состояние игрока, ClientHome +288 (RushState, iOS decode 0x100500298).
        [JsonProperty] public int RushAttempts = 3;
        [JsonProperty] public long RushActiveStart;   // unix, сек
        [JsonProperty] public long RushActiveEnd;     // unix, сек
        [JsonProperty] public long RushAttemptsDay;   // день (unix/86400), когда попытки последний раз восстанавливались
        public const int RushDurationSecs = 3600;
        public const int RushAttemptsPerDay = 3;

        /// <summary>Восстановить попытки раша в новый день (UTC).</summary>
        public void RefreshRushAttempts()
        {
            long day = System.DateTimeOffset.UtcNow.ToUnixTimeSeconds() / 86400;
            if (RushAttemptsDay != day) { RushAttemptsDay = day; RushAttempts = RushAttemptsPerDay; }
        }

        /// <summary>Команда 601: потратить попытку и включить раш на RushDurationSecs.</summary>
        public bool ActivateRush()
        {
            RefreshRushAttempts();
            long now = System.DateTimeOffset.UtcNow.ToUnixTimeSeconds();
            if (RushActiveEnd > now || RushAttempts < 1) return false;
            RushAttempts--;
            RushActiveStart = now;
            RushActiveEnd = now + RushDurationSecs;
            System.Console.WriteLine($"[Rush] включён до {RushActiveEnd}, попыток осталось {RushAttempts}");
            return true;
        }

        private void EncodeRushState(ByteStream stream)
        {
            RefreshRushAttempts();
            long now = System.DateTimeOffset.UtcNow.ToUnixTimeSeconds();
            long nextDay = (now / 86400 + 1) * 86400;
            int remain = RushActiveEnd > now ? (int)(RushActiveEnd - now) : 0;
            // Порядок RushState::decode: +8, +12, +28, +24, +0, +4, rewards, fallbackRewards, +16, +20.
            stream.WriteVInt((int)(nextDay - now));          // +8  m_nextDailyRefrehTimeRemainInSec
            stream.WriteVInt((int)nextDay);                  // +12 m_nextDailyRefreshTimeInSecs
            stream.WriteVInt(remain);                        // +28 m_rushActiveRemainTimeInSecs
            stream.WriteVInt(remain > 0 ? (int)RushActiveEnd : 0);   // +24 m_rushActiveEndTimeInSecs
            stream.WriteVInt(44);                            // +0  m_currentEventId (слот 44)
            stream.WriteVInt((int)(now + 30L * 86400));      // +4  m_eventEndTime
            stream.WriteVInt(0);                             // m_rewards
            stream.WriteVInt(0);                             // m_fallbackRewards
            stream.WriteVInt(RushAttempts);                  // +16 m_rushAttempts
            stream.WriteVInt(remain > 0 ? (int)RushActiveStart : 0); // +20 m_rushActiveStartTimeInSecs
        }
