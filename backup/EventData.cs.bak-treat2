namespace HashCore.Laser.Logic.Home.Items
{
    using System;
    using System.IO;
    using System.Text;
    using HashCore.Laser.Logic.Data;
    using HashCore.Laser.Titan;

    public partial class EventData
    {
        // Слоты, которые CollabUtil опрашивает: 36 -> LogicCollabEvent, 38 -> LogicSpecialEvent.
        public const int COLLAB_EVENT_SLOT = 36;
        public const int SPECIAL_EVENT_SLOT = 38;

        /// <summary>
        /// Слот Special Rush. Номер зашит в клиенте:
        /// SpecialRushUtil::getActiveEventDataFallbackToFuture зовёт getActiveEventForSlot(44)
        /// и отбрасывает событие, если у него пустое поле +256 (структура SpecialRush).
        /// </summary>
        public const int SPECIAL_RUSH_EVENT_SLOT = 44;

        /// <summary>
        /// Слоты Boss Rush. Номера зашиты в клиенте:
        /// LogicGameModeUtil::isBossRushEvent требует (slot - 45) &lt;= 7, то есть 45..52,
        /// плюс непустую ссылку на данные в LogicSpecialEvent (+232) по смещению +72.
        /// BossRushUtil::getOneActiveBossRushEvent перебирает ровно этот диапазон.
        /// </summary>
        public const int BOSS_RUSH_FIRST_SLOT = 45;
        public const int BOSS_RUSH_LAST_SLOT = 52;

        /// <summary>
        /// Слоты рогалика. getFirstActiveRogueliteEvent опрашивает 53 и 54, а
        /// RogueliteStagesPopup::showForEventSlot отвергает всё остальное с
        /// "Invalid slot %d". Событию нужна непустая структура в EventData +264.
        /// </summary>
        public const int ROGUELITE_FIRST_SLOT = 53;
        public const int ROGUELITE_LAST_SLOT = 54;

        public int Slot;
        public int LocationId;
        public DateTime EndTime;
        public bool IsBonusCollected;

        public int CollabId;
        public ChronosFileEntry? ChronosFileEntry { get; set; }
        public BrawlerEarlyAccessEventData? BrawlerEarlyAccess;
        public SpecialRushEvent? SpecialRush; // +256, not ClientHome +288 player data.

        /// <summary>
        /// Глобальный id босса. Уходит в LogicSpecialEvent (+232) во второе поле (+72),
        /// именно его проверяет isBossRushEvent — без него слот боссов не появляется.
        /// </summary>
        public int BossCharacterId;

        // Испытание (слоты 20..29), см. ChallengeDefinition. Сама описанка общая,
        // а личный прогресс ставится на копию события перед отправкой дома
        // (ChallengeManager.ApplyToEvent), поэтому он хранится полями-значениями:
        // Clone() копирует их отдельно для каждого игрока.
        public Challenges.ChallengeDefinition Challenge;
        public int ChallengeStageWins;      // +64
        public int ChallengeLivesUsed;      // +60, только слот 20
        public int ChallengeTotalWins;      // +88, только слот 20
        public int ChallengeLivesPurchased; // +68, только слот 20

        /// <summary>Отдел магазина внутри события: что выдаётся и почём.</summary>
        public List<LogicGemOffer> TreatUpgradeRewards = new List<LogicGemOffer>();
        public List<int> TreatUpgradeCosts = new List<int>();

        public LocationData Location => DataTables.Get(DataType.Location).GetDataByGlobalId<LocationData>(LocationId);

        public EventData Clone()
        {
            return (EventData)this.MemberwiseClone();
        }

        public void Encode(ByteStream encoder)
        {
            encoder.WriteVInt(Slot);
            encoder.WriteVInt(Slot);
            encoder.WriteVInt(10); 
            encoder.WriteVInt(0); // v53
            encoder.WriteVInt((int)(EndTime - DateTime.Now).TotalSeconds);
            encoder.WriteVInt(0);
            
            if (Slot == 12 || Slot == 13) ByteStreamHelper.WriteDataReference(encoder, null);
            else ByteStreamHelper.WriteDataReference(encoder, Location);

            encoder.WriteVInt(0); // GameModeVaridation
            encoder.WriteVInt(2);

            encoder.WriteString(null); // 0xacecac
            encoder.WriteVInt(0); // 0xacecc0
            encoder.WriteVInt(0); // 0xacecd4
            encoder.WriteVInt(0); // 0xacece8

            encoder.WriteVInt(0); // modifier

            encoder.WriteVInt(0); // 0xacee58
            encoder.WriteVInt(0); // 0xacee6c

            encoder.WriteBoolean(IsBonusCollected); 

            encoder.WriteVInt(0);
            encoder.WriteBoolean(false); // LogicRankedSeason
            encoder.WriteVInt(0);
            encoder.WriteVInt(0);
            encoder.WriteBoolean(false);
            encoder.WriteBoolean(false);
            encoder.WriteBoolean(false);
            encoder.WriteVInt(-1);
            encoder.WriteBoolean(false);
            encoder.WriteBoolean(false);
            encoder.WriteVInt(1);
            {
                encoder.WriteDataReference(15, 7);
            }

            encoder.WriteVInt(1);
            {
                encoder.WriteDataReference(16, 1);
            } // v51
            
            encoder.WriteVInt(0); // v51
            encoder.WriteVInt(0); // v51

            encoder.WriteBoolean(true);
            encoder.WriteDataReference(0, 0);
            encoder.WriteVInt(0); // v51
            encoder.WriteVInt(0); // v51
            encoder.WriteVInt(0); // v51
        }
