        public void EncodeCollabSlot(ByteStream encoder)
        {
            bool collab = Slot != SPECIAL_EVENT_SLOT;

            encoder.WriteVInt(Slot);
            encoder.WriteVInt(Slot);
            encoder.WriteVInt(0);
            encoder.WriteVInt(0);
            encoder.WriteVInt((int)(EndTime - DateTime.Now).TotalSeconds);
            encoder.WriteVInt(0);

            if (LocationId == 0) ByteStreamHelper.WriteDataReference(encoder, null);
            else ByteStreamHelper.WriteDataReference(encoder, Location);

            encoder.WriteVInt(0); // dataRef +32
            encoder.WriteVInt(0);
            encoder.WriteString(null);
            encoder.WriteVInt(0);
            encoder.WriteVInt(0);
            encoder.WriteVInt(0);
            encoder.WriteVInt(0); // int[] +72
            encoder.WriteVInt(0);
            encoder.WriteVInt(0);
            encoder.WriteBoolean(IsBonusCollected);
            encoder.WriteBoolean(false); // LogicBattlePlayerMap
            encoder.WriteVInt(0);
            encoder.WriteBoolean(false); // LogicRankedSeason
            encoder.WriteVInt(0);
            encoder.WriteVInt(0);
            encoder.WriteBoolean(false); // ChronosTextEntry
            encoder.WriteBoolean(false); // ChronosTextEntry
            encoder.WriteBoolean(false); // ChronosTextEntry
            encoder.WriteBoolean(false); // LogicGemOffer
            encoder.WriteVInt(0); // int[] +80
            if (encoder.WriteBoolean(ChronosFileEntry != null)) ChronosFileEntry!.Encode(encoder);
            encoder.WriteBoolean(false); // LogicClubTrophyConfig
            encoder.WriteVInt(0); // dataRef[] +184
            encoder.WriteVInt(0); // dataRef[] +192
            encoder.WriteVInt(0); // int[] +200
            encoder.WriteVInt(0);

            encoder.WriteBoolean(false); // LogicAlliancePiggyBankEvent

            encoder.WriteBoolean(collab);
            if (collab) WriteCollabEvent(encoder);

            encoder.WriteBoolean(!collab);
            if (!collab) WriteSpecialEvent(encoder);

            encoder.WriteBoolean(false); // LogicContestEvent
            if (encoder.WriteBoolean(BrawlerEarlyAccess != null)) BrawlerEarlyAccess!.Encode(encoder);
            if (encoder.WriteBoolean(SpecialRush != null)) SpecialRush!.Encode(encoder);

            // +264 LogicRogueliteEvent — null => просто false, как было раньше
            if (encoder.WriteBoolean(Roguelite != null)) Roguelite.Encode(encoder);
        }

        // LogicCollabEvent::decode, id читается из +8.
        /// <summary>Уровней «сладость или гадость» по умолчанию. Вкладка индексирует все treat-списки
        /// номером уровня без проверки — пустой список = вылет (getter по +0xA8, m_treatUpgradeCosts).</summary>
        public const int DefaultTreatLevels = 5;

        private void EnsureTreatDefaults()
        {
            if (TreatUpgradeCosts.Count == 0)
                for (int i = 0; i < DefaultTreatLevels; i++) TreatUpgradeCosts.Add(100 * (i + 1));
            if (TreatUpgradeRewards.Count == 0)
                for (int i = 0; i < DefaultTreatLevels; i++) TreatUpgradeRewards.Add(new LogicGemOffer(ShopItem.Coin, 100 * (i + 1)));
        }

        private void WriteTreatPeriods(ByteStream encoder, int value)
        {
            encoder.WriteVInt(DefaultTreatLevels);
            for (int i = 0; i < DefaultTreatLevels; i++) encoder.WriteVInt(value);
        }

        private void WriteCollabEvent(ByteStream encoder)
        {
            EnsureTreatDefaults();
            encoder.WriteBoolean(false);
            encoder.WriteBoolean(false); // LogicGemOffer
            WriteTreatPeriods(encoder, 86400); // treatUpgradePeriodRemainingSeconds
            encoder.WriteVInt(0); // scoreRewardMilestones
            encoder.WriteVInt(0);
            // Отдел магазина внутри события. Позиции выверены по LogicCollabEvent::decode
            // с привязкой каждого чтения к полю-приёмнику: 4-й VInt — что выдаётся,
            // 7-й — цены. Между ними два скаляра (+136 и +56), их трогать нельзя.
            encoder.WriteVInt(TreatUpgradeRewards.Count);          // 4  treatUpgradeBoxRewards
            foreach (LogicGemOffer reward in TreatUpgradeRewards)
                if (encoder.WriteBoolean(reward != null)) reward.Encode(encoder);

            encoder.WriteVInt(0);                                   // 5  скаляр +136
            encoder.WriteVInt(0);                                   // 6  скаляр +56

            encoder.WriteVInt(TreatUpgradeCosts.Count);             // 7  treatUpgradeCosts
            foreach (int cost in TreatUpgradeCosts) encoder.WriteVInt(cost);
            encoder.WriteVInt(0); // winProgressRewards
            encoder.WriteVInt(0); // scoreRewardsRepeatingScoreRewards
            encoder.WriteVInt(0);
            WriteTreatPeriods(encoder, 0); // treatUpgradePeriodStartTimes
            encoder.WriteVInt(0); // tokenRewardMilestones
            encoder.WriteVInt(0); // winMilestoneRewards
            WriteTreatPeriods(encoder, 86400 * 30); // treatUpgradePeriodEndTimes
            encoder.WriteVInt(0); // clubRewardMilestones
            encoder.WriteVInt(CollabId);
            encoder.WriteVInt(0);
        }

        // LogicSpecialEvent::decode, id читается из +0.
        internal void WriteSpecialEvent(ByteStream encoder)
        {
            encoder.WriteVInt(0); // bossFightLevelRewards
            // +72 — ссылка на босса. isBossRushEvent отбрасывает событие, пока она пустая.
            if (BossCharacterId != 0) ByteStreamHelper.WriteDataReference(encoder, BossCharacterId);
            else encoder.WriteVInt(0);
            encoder.WriteVInt(0); // bonusRewardWithFallbacks
            encoder.WriteVInt(0);
            encoder.WriteVInt(0); // dataRef +88
            encoder.WriteVInt(0); // dataRef +80
            encoder.WriteVInt(0);
            encoder.WriteBoolean(false);
            encoder.WriteVInt(0); // bossFightLevelFallBackRewards
            encoder.WriteVInt(0);
            encoder.WriteVInt(CollabId);
        }
    }
}
