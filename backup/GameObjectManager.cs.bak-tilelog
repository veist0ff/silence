namespace HashCore.Laser.Logic.Battle.Objects
{
    using System.Reflection.Metadata.Ecma335;
    using System.Runtime.CompilerServices;
    using HashCore.Laser.Logic.Battle.Level;
    using HashCore.Laser.Logic.Battle.Structures;
    using HashCore.Laser.Logic.Data.Helper;
     
    using HashCore.Laser.Logic.Util;
    using HashCore.Laser.Server;
     
    public class GameObjectManager//+32 type 64 encode 48IsAlive
    {
        public static int s_ballTraces;

        public Queue<GameObject> AddObjects;
        private Queue<GameObject> RemoveObjects;

        private BattleMode Battle;
        public List<GameObject> GameObjects;
        public List<Petrol> Petrols;

        private int ObjectCounter;

        public GameObjectManager(BattleMode battle)
        {
            Battle = battle;
            GameObjects = new List<GameObject>();
            Petrols = new List<Petrol>();

            AddObjects = new Queue<GameObject>();
            RemoveObjects = new Queue<GameObject>();
        }

        public GameObject[] GetGameObjects()
        {
            return GameObjects.ToArray();
        }
        public Projectile[] GetProjectiles()
        {
            List<Projectile> objects = new List<Projectile>();

            foreach (GameObject obj in GameObjects)
            {
                if (obj.GetObjectType() == 1)
                {
                    objects.Add((Projectile)obj);
                }
            }
            return objects.ToArray();
        }

        public Character[] GetCharacters()
        {
            List<Character> objects = new List<Character>();

            foreach (GameObject obj in GameObjects)
            {
                if (obj.GetObjectType() == 0)
                {
                    objects.Add((Character)obj);
                }
            }
            foreach (GameObject obj in AddObjects)
            {
                if (obj.GetObjectType() == 0)
                {
                    objects.Add((Character)obj);
                }
            }
            return objects.ToArray();
        }

        public Projectile[] GetSpecificProjectiles(GameObject gameObject)
        {
            List<Projectile> objects = new List<Projectile>();

            foreach (GameObject obj in GameObjects)
            {
                if (obj.GetObjectType() == 1 && obj.GetIndex() / 16 != gameObject.GetIndex() / 16 && obj.GetPosition().GetDistance(gameObject.GetPosition()) <= 600)
                {
                    objects.Add((Projectile)obj);
                }
            }
            return objects.ToArray();
        }

        public BattleMode GetBattle()
        {
            return Battle;
        }

        public void PreTick()
        {
            for (int i = 0; i < GameObjects.Count; i++)
            {

                GameObject gameObject = GameObjects[i];
                if (gameObject == null)
                {
                    GameObjects.Remove(gameObject);
                    i--;
                    continue;
                }
                if (gameObject.ShouldDestruct())
                {
                    gameObject.OnDestruct();
                    RemoveGameObject(gameObject);
                }
                else
                {
                    gameObject.ResetEventsOnTick();
                }
            }

            while (AddObjects.Count > 0)
            {
                GameObjects.Add(AddObjects.Dequeue());
            }
            for (int i = 0; i < GameObjects.Count; i++)
            {
                GameObject gameObject = GameObjects[i];
                if (gameObject == null)
                {
                    GameObjects.Remove(gameObject);
                    i--;
                    continue;
                }
            }
            while (RemoveObjects.Count > 0)
            {
                GameObjects.Remove(RemoveObjects.Dequeue());
            }
        }

        public void Tick()
        {
            //try
            {
                for (int i = 0; i < GameObjects.Count; i++)
                {
                    GameObject gameObject = GameObjects[i];
                    if (gameObject == null)
                    {
                        GameObjects.Remove(gameObject);
                        i--;
                        continue;
                    }
                    gameObject.Tick();
                }
            }

        }

        public void AddGameObject(GameObject gameObject)
        {
            // Номер в кадре — сквозной (ByteStreamHelper::writeObjectRunningId), общий для
            // всех типов: при счётчике по типам номера совпадали, и клиент путал объекты.
            gameObject.AttachGameObjectManager(this, GlobalId.CreateGlobalId(gameObject.GetObjectType(), ObjectCounter++));
            AddObjects.Enqueue(gameObject);
        }

        public void RemoveGameObject(GameObject gameObject)
        {
            RemoveObjects.Enqueue(gameObject);
        }

        public GameObject GetGameObjectByID(int globalId)
        {
            GameObject gameObject = GameObjects.Find(obj => obj.GetGlobalID() == globalId);
            if (gameObject == null) gameObject = AddObjects.ToList().Find(obj => obj.GetGlobalID() == globalId);
            return gameObject;
        }

        public List<GameObject> GetGameObjectByCloneOfObjectGlobalId(int globalId)
        {
            return GameObjects.FindAll(obj => obj.GetCloneOfObjectGlobalId() == globalId);
        }

        public List<GameObject> GetVisibleGameObjects(int teamIndex, int ownObjectGlobalId)
        {
            List<GameObject> objects = new List<GameObject>();
            try
            {
                bool IsInRealm = false;
                GameObject character = GetGameObjectByID(ownObjectGlobalId);
                if (character != null)
                {
                    IsInRealm = character.IsInRealm;
                }
                foreach (GameObject obj in GameObjects)
                {
                    if (obj.IsInRealm ^ IsInRealm) continue;
                    if (obj.GetFadeCounter() > 0 || obj.GetIndex() / 16 == teamIndex && GetBattle().StoryMode == null)
                    {
                        objects.Add(obj);
                    }
                }
                foreach (GameObject obj in AddObjects)
                {
                    if (obj.IsInRealm ^ IsInRealm) continue;
                    if (obj.GetFadeCounter() > 0 || obj.GetIndex() / 16 == teamIndex)
                    {
                        objects.Add(obj);
                    }
                }
            }
            catch (Exception exception)
            {
                Logger.Error($"[GameObjectManager::visible] battle {Battle.Id} aborted: {exception}");
                Battle.GameOver();
                Battle.IsGameOver = true;
                Battle.m_updateTimer.Dispose();
            }

            return objects;
        }

        public void Encode(BitStream bitStream, TileMap tileMap, int ownObjectGlobalId, int playerIndex, int teamIndex)
        {
            BattlePlayer[] players = Battle.GetPlayers();
            List<GameObject> visibleGameObjects = GetVisibleGameObjects(teamIndex, ownObjectGlobalId);
            if (Environment.GetEnvironmentVariable("NO_PROJ_TEST") == "1") visibleGameObjects.RemoveAll(o => o is Projectile); // ТЕСТ: без снарядов в кадре
            int GameModeVariation = Battle.GetGameModeVariation();

            // Сколько объектов РЕАЛЬНО уходит игроку. Общее число объектов боя об
            // этом ничего не говорит: в кадр попадает только видимое, а «не видно
            // игроков» — это ровно про этот список.
            if (Battle.GetTicksGone() % 100 == 0)
            {
                int chars = 0;
                int hidden = 0;
                foreach (GameObject o in GameObjects)
                {
                    if (o is Character) chars++;
                    if (o.GetFadeCounter() <= 0 && o.GetIndex() / 16 != teamIndex) hidden++;
                }

                HashCore.Laser.Server.Logger.Print($"[Vision::visible] бой {Battle.Id} тик {Battle.GetTicksGone()}"
                    + $" игрок {playerIndex} команда {teamIndex}: всего объектов {GameObjects.Count},"
                    + $" персонажей {chars}, в кадр попало {visibleGameObjects.Count}, скрыто {hidden}");
            }
            bitStream.WritePositiveIntMax2097151(ownObjectGlobalId);
            bitStream.WritePositiveIntMax2097151(ownObjectGlobalId);
            bitStream.WriteBoolean(false);
            bitStream.WriteBoolean(false);

            if (GameModeVariation == 0)
            {
                bitStream.WritePositiveVIntMax65535(Battle.GetGemGrabCountdown());
            }
            else if (Battle.IsKnockout) Battle.EncodeKnockout(bitStream); // блок раундов нокаута

            bitStream.WriteBoolean(false);//没用
            bitStream.WriteInt(-1, 4);//对局状态

            bitStream.WriteBoolean(false);
            bitStream.WriteBoolean(false);
            bitStream.WriteBoolean(false);
            bitStream.WriteBoolean(false);//全都没用

            if (tileMap.Width < 22)
            {
                bitStream.WritePositiveInt(0, 5); // 0xa820a8
                bitStream.WritePositiveInt(0, 6); // 0xa820b4
                bitStream.WritePositiveInt(tileMap.Width - 1, 5); // 0xa820c0
            }
            else
            {
                bitStream.WritePositiveInt(0, 6); // 0xa820a8
                bitStream.WritePositiveInt(0, 6); // 0xa820b4
                bitStream.WritePositiveInt(tileMap.Width - 1, 6); // 0xa820c0
            }
            bitStream.WritePositiveInt(tileMap.Height - 1, 6); // 0xa820d0

            for (int i = 0; i < tileMap.Width; i++)
            {
                for (int j = 0; j < tileMap.Height; j++)
                {
                    var tile = tileMap.GetTile(i, j, true, true);
                    var tileData = tile.Data;
                    bool destructibleWithPiercing = tileData.IsDestructible;
                    bool destructibleAny = tileData.IsDestructibleNormalWeapon;
                    bool blocksMovement = tileData.BlocksMovement;
                    bool blocksProjectiles = tileData.BlocksProjectiles;
                    bool encodesDestructionState =
                        destructibleWithPiercing
                        || (destructibleAny && (blocksMovement || blocksProjectiles))
                        || (blocksMovement && blocksProjectiles && !destructibleWithPiercing)
                        || tileData.RestoreAfterDynamicOverlap;
                    if (encodesDestructionState)
                    {
                        bitStream.WriteBoolean(tile.IsDestructed() && tileMap.GetTile(i, j, true).IsDestructed());
                    }
                    if (blocksProjectiles)
                    {
                        bitStream.WriteBoolean(false);
                    }
                }
            }

            bitStream.WritePositiveVIntMax65535OftenZero(tileMap.NewTiles.Count);
            {
                for (int i = 0; i < tileMap.NewTiles.Count; i++)
                {
                    int dynamicCode = tileMap.NewTiles[i].Data.DynamicCode;

                    bitStream.WritePositiveIntMax4095(tileMap.NewTiles[i].TileX + tileMap.Width * tileMap.NewTiles[i].TileY);
                    bitStream.WritePositiveIntMax31(dynamicCode);
                    bitStream.WriteBoolean(false);
                    if ((dynamicCode & ~3) == 0xC) bitStream.WritePositiveIntMax3(0);
                }
            }
            bitStream.WritePositiveVIntMax65535OftenZero(0);

            bitStream.WritePositiveVIntMax65535OftenZero(Petrols.Count);
            if (Petrols.Count >= 1)
            {
                for (int i = 0; i < Petrols.Count; i++)
                {
                    bitStream.WritePositiveIntMax63(Petrols[i].X);
                    bitStream.WritePositiveIntMax63(Petrols[i].Y);
                    bitStream.WriteIntMax15(Petrols[i].TeamIndex);
                    bitStream.WriteIntMax15(Petrols[i].PlayerIndex);
                    bitStream.WritePositiveIntMax1(0);//v64
                }
            }
            for (int i = 0; i < players.Length; i++)
            {
                // Клиент помечает "свой" блок совпадением игрока (receiver+8 == iterated+8),
                // а не позицией в массиве. Индексы у нас внутрикомандные, поэтому позиционное
                // сравнение i == playerIndex попадало не в того игрока у команды 1.
                if (players[i].TeamIndex == teamIndex && players[i].PlayerIndex == playerIndex)
                {
                    //bitStream.WritePositiveInt((((Character)GetGameObjectByID(players[i].OwnObjectId))?.DisplayUltiTmp ?? false) ? 4000 : players[i].GetUltiCharge(), 12);
                    bitStream.WritePositiveIntMax4095(players[i].GetUltiCharge());
                    // LogicPlayer+440: сколько ульт доступно. CombatHUD::updatePlayerControls
                    // показывает кнопку ульты только при значении > 0 — с нулём она была
                    // невидимой, хотя нажатие работало.
                    bitStream.WritePositiveIntMax3(players[i].HasUlti() ? 1 : 0);
                    bitStream.WritePositiveIntMax4095(players[i].GetOverCharge());//OverCharge
                    bitStream.WritePositiveInt(0, 1);
                    bitStream.WritePositiveInt(0, 1);
                    bitStream.WritePositiveVIntMax255OftenZero(0);
                    if (Battle.EventModifiers.Contains(43))
                        bitStream.WriteBoolean(false);
                    // Haptic event (type + tick follow only when true).
                    bitStream.WriteBoolean(false);
                }
                bitStream.WritePositiveIntMax15(players[i].HeroIndex);//v53
                // Optional player hook data reference. When this is false the
                // client does not call uponDecodeOwnerPlayer and consumes no hook bits.
                bitStream.WriteBoolean(false);

                bitStream.WritePositiveIntMax131071(0);//v64
                bitStream.WriteBoolean(players[i].IsAlive);
                bitStream.WriteBoolean(players[i].HasUlti());
                bitStream.WriteBoolean(false); // bonus skill
                bitStream.WriteBoolean(false); // bad connection data
                bitStream.WriteBoolean(false); // controlled character GID
                bitStream.WriteBoolean(false); // player state flag at +544
                // LogicGameObjectManagerClient::decode читает это поле для
                // isDuoShowdown(gmv) == (6 || 67), а также для 39 и 34 — три ветки
                // сходятся на одном readPositiveIntMax15. Раньше сервер писал его
                // только для шестёрки, и на рогалике поток разъезжался.
                if (GameModeVariation == 6 || GameModeVariation == 67
                 || GameModeVariation == 39 || GameModeVariation == 34)
                    bitStream.WritePositiveIntMax15(1); // 0 клиент берёт как индекс -1 и падает на первом кадре шд
                if (GameModeVariation == 3) bitStream.WriteBoolean(false);
                bitStream.WritePositiveVIntMax255OftenZero(0);
                bitStream.WritePositiveIntMax1(0);//v64
                bitStream.WritePositiveIntMax1(0);//v64
                bitStream.WriteBoolean(players[i].IsUsingPin(GetBattle().GetTicksGone()));
                if (players[i].IsUsingPin(GetBattle().GetTicksGone()))
                {
                    bitStream.WriteIntMax15(players[i].PinIndex);
                    bitStream.WritePositiveIntMax16383(players[i].StartUsingPinTicks);
                }
                bitStream.WritePositiveIntMax1(0);//v64
                bitStream.WriteIntMax16383(0);//v64
                bitStream.WritePositiveIntMax1048575(0);
                // sub_845298 start
                bitStream.WritePositiveIntMax1(0);//v64
                bitStream.WritePositiveIntMax1(0);//v64
                // sub_845298 end
                // Карточки рогалика: флаг выбора (+572), при нём предложенные (+608), затем надетые (+624).
                bitStream.WriteBoolean(players[i].SelectingCard);
                if (players[i].SelectingCard)
                {
                    bitStream.WriteIntMax31(players[i].DrawnCards.Count);
                    foreach (int card in players[i].DrawnCards) ByteStreamHelper.WriteDataReference(bitStream, card);
                }
                bitStream.WriteIntMax31(players[i].EquippedCards.Count);
                foreach (int card in players[i].EquippedCards) ByteStreamHelper.WriteDataReference(bitStream, card);
                // CombatHUD::updatePowerUpSelection: +641 — идёт фаза выбора (без него окно не
                // открывается), +640 — карта выбрана (анимация закрытия окна).
                bitStream.WriteBoolean(players[i].CardPicked);     // +640
                bitStream.WriteBoolean(players[i].CardPhaseActive); // +641
                bitStream.WritePositiveIntMax1(0);//v64 +575
                bitStream.WriteIntMax31(0);
                bitStream.WritePositiveIntMax1(0);//v64
                bitStream.WritePositiveIntMax1(0);//v64
            }
            //bitStream.WritePositiveIntMax1(0);//v64
            bitStream.WritePositiveVIntMax65535OftenZero(0);
            bitStream.WritePositiveVIntMax255OftenZero(0);
            if (GameModeUtil.HasTimerAndCanEndBeforeTimerRunsOut(GameModeVariation))
                bitStream.WritePositiveVIntMax65535OftenZero(0);
            if (GameModeUtil.RoundResetsWhenObjectiveIsMissing(GameModeVariation))
            {
                // Оригинал: battle+244 (bool), battle+248 (IntMax1). Проверка: /root/v64/ball_round.txt
                // «1» — писать true (раунд идёт), иначе false.
                bool roundFlag = true;
                try { roundFlag = System.IO.File.ReadAllText("/root/v64/ball_round.txt").Trim() == "1"; } catch { }
                bitStream.WriteBoolean(roundFlag);
                bitStream.WriteIntMax1(0);
            }

            // Модификатор события 44. Клиент (LogicGameObjectManagerClient::decode,
            // 0x10046c51c) перед хвостом режима проходит по списку модификаторов
            // боя и, встретив 44, читает ДВА IntMax63 подряд. Сервер этот блок не
            // писал вовсе: в бою с этим модификатором дальше всё читалось со
            // сдвигом на 12 бит.
            if (Battle.EventModifiers.Contains(44))
            {
                bitStream.WriteIntMax63(0);
                bitStream.WriteIntMax63(0);
            }

            // Хвост режима. В клиенте (LogicGameObjectManagerServer::encode) это цепочка
            // ВЗАИМОИСКЛЮЧАЮЩИХ веток: каждая заканчивается goto на список счёта.
            // Раньше здесь был только блок баз, поэтому в выживании не хватало 4 бит и
            // весь остаток апдейта (счёт и объекты) клиент читал со сдвигом: карта
            // рисовалась, а персонажи — нет.
            bool hasTwoBases = GameModeUtil.HasTwoBases(GameModeVariation);
            if (GameModeVariation == 34 || GameModeVariation == 6 || GameModeVariation == 67)
            {
                // isDuoShowdown(gmv) == (gmv == 6 || gmv == 67) — счётчик живых игроков.
                int alivePlayers = 0;
                foreach (BattlePlayer p in players) if (p != null && p.IsAlive) alivePlayers++;
                bitStream.WritePositiveIntMax15(alivePlayers > 15 ? 15 : alivePlayers);
            }
            else if (GameModeVariation == 9 || GameModeVariation == 38
                  || GameModeVariation == 44 || GameModeVariation == 59)
            {
                // Маска 0x0800104000000200 в клиенте: число живых команд.
                var aliveTeams = new List<int>();
                foreach (BattlePlayer p in players)
                {
                    if (p != null && p.IsAlive && !aliveTeams.Contains(p.TeamIndex)) aliveTeams.Add(p.TeamIndex);
                }
                bitStream.WritePositiveIntMax7(aliveTeams.Count > 7 ? 7 : aliveTeams.Count);
            }
            else if (GameModeVariation == 16)
            {
                bitStream.WritePositiveIntMax8191(0);
                bitStream.WritePositiveIntMax8191(0);
            }
            else if (GameModeVariation == 13)
            {
                // Тренировочная пещера: клиент читает DPS игрока (LogicPlayer::getDPS)
                // readPositiveVIntMax2147483647OftenZero. Без него кадр разъезжался.
                bitStream.WritePositiveVIntMax2147483647OftenZero(0);
            }
            else if (GameModeVariation == 8 || hasTwoBases)
            {
                int hp1 = 0;
                int hp2 = 0;
                foreach (Character character in GetCharacters())
                {
                    if (!character.CharacterData.IsBase()) continue;
                    if (!character.IsAlive()) continue;
                    if (character.GetIndex() / 16 == 0) hp1 = character.GetHitpointPercentage();
                    else hp2 = character.GetHitpointPercentage();
                }
                // Первый Max127 пишется всегда, второй — только при двух базах.
                bitStream.WritePositiveIntMax127(hp1);
                if (hasTwoBases) bitStream.WritePositiveIntMax127(hp2);
            }
            for (int i = 0; i < players.Length; i++)
            {
                int score = players[i].GetScore();
                if (bitStream.WriteBoolean(score != 0))
                {
                    switch (GameModeVariation)
                    {
                        case 14:
                            bitStream.WritePositiveIntMax524287(System.Math.Clamp(score, 0, 0x7FFFF));
                            break;
                        case 15:
                            bitStream.WritePositiveIntMax134217727(System.Math.Clamp(score, 0, 0x7FFFFFF));
                            break;
                        case 28:
                        case 39:
                        case 64:
                            bitStream.WritePositiveIntMax15(System.Math.Clamp(score, 0, 15));
                            if (GameModeVariation == 28 || GameModeVariation == 39 || GameModeVariation == 64)
                                bitStream.WritePositiveIntMax8191(0);
                            break;
                        case 36:
                            bitStream.WritePositiveIntMax1023(System.Math.Clamp(score, 0, 1023));
                            break;
                        default:
                            bitStream.WritePositiveVIntMax255(score);
                            break;
                    }
                }
                if (bitStream.WriteBoolean(players[i].KillList.Count > 0))
                {
                    bitStream.WritePositiveIntMax15(players[i].KillList.Count);
                    for (int j = 0; j < players[i].KillList.Count; j++)
                    {
                        bitStream.WritePositiveIntMax15(players[i].KillList[j].PlayerIndex);
                        bitStream.WriteIntMax7(players[i].KillList[j].BountyStarsEarned);
                    }
                }
            }

            // Список объектов, LogicGameObjectManagerClient::decode (0x10046c51c):
            // счётчик (VIntMax65535), затем все ссылки на данные подряд, затем для
            // КАЖДОГО объекта его номер — sub_100504628 читает VIntMax65535 и
            // собирает из него GlobalID нужного класса. Только после этого идёт
            // булево «отладочные пути» и тела объектов.
            //
            // Этот список номеров однажды был убран из кадра по ошибке («клиент их
            // не читает») — без него клиент берёт номера из начала тел объектов, и
            // весь кадр разъезжается.
            bitStream.WritePositiveVIntMax65535(visibleGameObjects.Count);
            foreach (GameObject gameObject in visibleGameObjects)
                ByteStreamHelper.WriteDataReference(bitStream, gameObject.GetDataId());
            foreach (GameObject gameObject in visibleGameObjects)
                bitStream.WritePositiveVIntMax65535(GlobalId.GetInstanceId(gameObject.GetGlobalID()));

            bitStream.WriteBoolean(false);
            int ownObjectIndex = teamIndex * 16 + playerIndex;
            foreach (GameObject gameObject in visibleGameObjects)
            {
                bool traceBall = s_ballTraces < 2 && gameObject is Character tc && (tc.CharacterData.IsCarryable() || tc.CharacterData.Name == "LootBox");
                if (traceBall) bitStream.Trace = new System.Collections.Generic.List<string>();
                gameObject.Encode(
                    bitStream,
                    gameObject.GetGlobalID() == ownObjectGlobalId,
                    ownObjectIndex,
                    teamIndex);
                if (traceBall)
                {
                    s_ballTraces++;
                    System.IO.File.WriteAllText($"/root/v64/ball_trace_{s_ballTraces}.txt", string.Join("\n", bitStream.Trace));
                    bitStream.Trace = null;
                }
            }

            // LogicGameObjectManagerClient::decode reads this after every object
            // payload (client field +216). Native server returns the flag to the
            // battle-mode encoder; this implementation writes it inline.
            bitStream.WriteBoolean(false);

            if (GameModeVariation == 7)
            {
                if (bitStream.WriteBoolean(true))
                {
                    bitStream.WritePositiveIntMax32767(10000);
                    bitStream.WritePositiveIntMax65535(10000);
                }
            }

               //   Logger.Print("[GameObject:init]complete");
        }
    }
}
